(cartridge "cycles"
  (spec 7)
  (title "Cycles")
  (rate 60)
  (screen grid 40 40)
  (seed host)
  (bound "Arena")
  (game "Arena")
  (read "Arena" "Mind")
  (work "Layout")
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "Cycles: one person against the house. The arrows steer your cursor, which writes every cell it enters; a cursor that enters a written cell has closed a circle and loses the round. Enter or Space begins a round, P pauses. The house's every reason is a cell of the Mind sheet. A cell filled on the Layout sheet is a wall from the next round."))
(sheet "Arena" visible)
(sheet "Mind" visible)
(sheet "Layout" visible)
(sheet "State" hidden)
(sheet "Tally" hidden)
(sheet "Screen" hidden)
(sheet "Camera" hidden)
(sheet "Commands" hidden)
(sheet "Keys" hidden)
(format 1 (fill "FFFFFF"))
(format 2 (fill "A080E0"))
(format 3 (border (left medium "6B4FC8") (right medium "6B4FC8") (top medium "6B4FC8") (bottom medium "6B4FC8")))
(format 4 (border (left medium "FFFFFF") (right medium "FFFFFF") (top medium "FFFFFF") (bottom medium "FFFFFF")))
(format 5 "2E2645" ";;;" nowrap (border (left thin "3B3159") (right thin "3B3159") (top thin "3B3159") (bottom thin "3B3159")))
(format 6 "F3F3EE" ";;;" nowrap)
(format 14 (fill "808080"))
(format 7 "F3F3EE" general nowrap (font 12))
(format 8 "F3F3EE" general nowrap (font bold 14))
(format 9 "F3F3EE" general nowrap (font bold 12) (align center middle))
(format 10 (number "0;0;;") (font 7 "2E2645") (align center middle))
(format 11 "FFFFFF" general nowrap (font bold 11 "2E2645") (align center middle) (border (left medium "6B4FC8") (right medium "6B4FC8") (top medium "6B4FC8") (bottom medium "6B4FC8")))
(format 12 "A080E0" general nowrap (font bold 11 "FFFFFF") (align center middle) (border (left medium "FFFFFF") (right medium "FFFFFF") (top medium "FFFFFF") (bottom medium "FFFFFF")))
(look "Arena" "#" 6)
(look "Arena" "wall" 14)
(gridlines "Arena" off)
