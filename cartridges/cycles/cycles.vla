(cell "State" "B1" 5)
(cell "State" "B2" 90)
(cell "State" "B3" 22)
(cell "State" "B4" 12)
(cell "State" "B5" 21)
(cell "State" "B6" 31)
(formula "State" "B7" "=MAX(Input!B9,Input!B10)")
(formula "State" "B8" "=IF(AND(State!B7=1,State.last!B7=0),1,0)")
(formula "State" "B9" "=IF(Clock!$B$1=1,0,IF(AND(Input!B20=\"pause\",OR(State.last!B27=1,State.last!B27=2)),1-State.last!B9,State.last!B9))")
(formula "State" "B10" "=1-State!B9")
(formula "State" "B11" "=IF(AND(State!B10=1,OR(State.last!B27=1,State.last!B27=2)),1,0)")
(formula "State" "B12" "=IF(AND(Input!B1=1,Input.last!B1=0),1,0)")
(formula "State" "B13" "=IF(AND(Input!B4=1,Input.last!B4=0),1,0)")
(formula "State" "B14" "=IF(AND(Input!B2=1,Input.last!B2=0),1,0)")
(formula "State" "B15" "=IF(AND(Input!B3=1,Input.last!B3=0),1,0)")
(formula "State" "B16" "=IF(State!B12=1,0,IF(State!B13=1,1,IF(State!B14=1,2,IF(State!B15=1,3,-1))))")
(formula "State" "B17" "=IF(State.last!B24>=0,State.last!B24,State.last!B33)")
(formula "State" "B18" "=IF(AND(State!B11=1,State!B16>=0,State!B16<>State!B17,State!B16<>MOD(State!B17+2,4)),1,0)")
(formula "State" "B19" "=IF(AND(State!B18=1,State.last!B24<0),State!B16,State.last!B24)")
(formula "State" "B20" "=IF(AND(State!B18=1,State.last!B24>=0),State!B16,State.last!B25)")
(formula "State" "B21" "=IF(AND(Clock!B1>1,State!B8=1,OR(State.last!B27=0,State.last!B27=3)),1,0)")
(formula "State" "B22" "=IF(OR(Clock!B1=1,State!B21=1),1,0)")
(formula "State" "B23" "=IF(AND(State!B10=1,State.last!B27=2,State.last!B26+1>=State!B1),1,0)")
(formula "State" "B24" "=IF(Clock!$B$1=1,-1,IF(State!B22=1,-1,IF(State!B23=1,State!B20,State!B19)))")
(formula "State" "B25" "=IF(Clock!$B$1=1,-1,IF(State!B22=1,-1,IF(State!B23=1,-1,State!B20)))")
(formula "State" "B26" "=IF(Clock!$B$1=1,0,IF(OR(State!B22=1,State!B23=1),0,IF(AND(State!B10=1,State.last!B27=2),State.last!B26+1,State.last!B26)))")
(formula "State" "B27" "=IF(Clock!$B$1=1,0,IF(State!B21=1,1,IF(State!B42+State!B43>0,3,IF(AND(State!B10=1,State.last!B27=1,State.last!B28+1>=State!B2),2,State.last!B27))))")
(formula "State" "B28" "=IF(Clock!$B$1=1,0,IF(State!B27<>State.last!B27,0,IF(State!B10=1,State.last!B28+1,State.last!B28)))")
(formula "State" "B29" "=State.last!B29+State!B21")
(formula "State" "B30" "=IF(Clock!$B$1=1,1,IF(State!B22=1,1,IF(State!B23=1,State.last!B30+1,State.last!B30)))")
(formula "State" "B31" "=IF(Clock!$B$1=1,1,IF(OR(State!B21=1,State!B23=1),State.last!B31+1,State.last!B31))")
(formula "State" "B32" "=State!B31*64")
(formula "State" "B33" "=IF(Clock!$B$1=1,1,IF(State!B22=1,1,IF(AND(State!B23=1,State!B19>=0),State!B19,State.last!B33)))")
(formula "State" "B34" "=IF(Clock!$B$1=1,3,IF(State!B22=1,3,IF(State!B23=1,Mind.last!B10,State.last!B34)))")
(formula "State" "B35" "=MAX(1,MIN(42,State.last!B46+CHOOSE(State!B33+1,-1,0,1,0)))")
(formula "State" "B36" "=MAX(1,MIN(42,State.last!B47+CHOOSE(State!B33+1,0,1,0,-1)))")
(formula "State" "B37" "=MAX(1,MIN(42,State.last!B48+CHOOSE(State!B34+1,-1,0,1,0)))")
(formula "State" "B38" "=MAX(1,MIN(42,State.last!B49+CHOOSE(State!B34+1,0,1,0,-1)))")
(formula "State" "B39" "=IF(INDEX(Arena.last!$A$1:$AP$42,State!B35,State!B36)=0,0,1)")
(formula "State" "B40" "=IF(INDEX(Arena.last!$A$1:$AP$42,State!B37,State!B38)=0,0,1)")
(formula "State" "B41" "=IF(AND(State!B35=State!B37,State!B36=State!B38),1,0)")
(formula "State" "B42" "=IF(AND(State!B23=1,State!B39+State!B41>0),1,0)")
(formula "State" "B43" "=IF(AND(State!B23=1,State!B40+State!B41>0),1,0)")
(formula "State" "B44" "=IF(AND(State!B23=1,State!B42=0),1,0)")
(formula "State" "B45" "=IF(AND(State!B23=1,State!B43=0),1,0)")
(formula "State" "B46" "=IF(Clock!$B$1=1,State!B3,IF(State!B22=1,State!B3,IF(State!B44=1,State!B35,State.last!B46)))")
(formula "State" "B47" "=IF(Clock!$B$1=1,State!B4,IF(State!B22=1,State!B4,IF(State!B44=1,State!B36,State.last!B47)))")
(formula "State" "B48" "=IF(Clock!$B$1=1,State!B5,IF(State!B22=1,State!B5,IF(State!B45=1,State!B37,State.last!B48)))")
(formula "State" "B49" "=IF(Clock!$B$1=1,State!B6,IF(State!B22=1,State!B6,IF(State!B45=1,State!B38,State.last!B49)))")
(formula "State" "B50" "=IF(Clock!$B$1=1,0,IF(State!B22=1,0,IF(State!B42+State!B43>0,State!B42+2*State!B43,State.last!B50)))")
(formula "State" "B51" "=IF(Clock!$B$1=1,0,IF(State!B22=1,0,IF(State!B42=1,State!B35,IF(State!B43=1,State!B37,State.last!B51))))")
(formula "State" "B52" "=IF(Clock!$B$1=1,0,IF(State!B22=1,0,IF(State!B42=1,State!B36,IF(State!B43=1,State!B38,State.last!B52))))")
(formula "State" "B53" "=IF(Clock!B1=1,MOD(Clock!B3*16807,2147483647),IF(State!B23=1,MOD(State.last!B55*16807,2147483647),State.last!B53))")
(formula "State" "B54" "=IF(OR(Clock!B1=1,State!B23=1),MOD(State!B53*16807,2147483647),State.last!B54)")
(formula "State" "B55" "=IF(OR(Clock!B1=1,State!B23=1),MOD(State!B54*16807,2147483647),State.last!B55)")
(formula "State" "B56" "=IF(State!B27=0,\"Enter or Space begins a round.\",IF(State!B9=1,\"Paused: P resumes.\",IF(State!B27=1,\"Ready.\",IF(State!B50=1,\"You closed a circle at \"&ADDRESS(State!B51,State!B52,4)&\".\",IF(State!B50=2,\"The house closed a circle at \"&ADDRESS(State!B51,State!B52,4)&\".\",IF(State!B50=3,\"Both closed a circle at \"&ADDRESS(State!B51,State!B52,4)&\".\",\"\"))))))")
(formula "State" "B58" "=IF(State!B50=1,\"The round is the house's.\",IF(State!B50=2,\"The round is yours.\",IF(State!B50=3,\"The round is nobody's.\",\"\")))")
(formula "State" "B57" "=IF(State!B27=3,\"Enter or Space begins the next round.\",\"\")")
(cell "Arena" "A1:AP1" "#")
(cell "Arena" "A42:AP42" "#")
(cell "Arena" "A2:A41" "#")
(cell "Arena" "AP2:AP41" "#")
(formula "Arena" "B2:AO41" "=IF(State!$B$22=1,IF(AND(ROW()=State!$B$3,COLUMN()=State!$B$4),1,IF(AND(ROW()=State!$B$5,COLUMN()=State!$B$6),-1,IF(ISBLANK(Layout!B2),0,\"wall\"))),IF(Arena.last!B2=0,IF(AND(State!$B$44=1,AND(ROW()=State!$B$35,COLUMN()=State!$B$36)),State!$B$30,IF(AND(State!$B$45=1,AND(ROW()=State!$B$37,COLUMN()=State!$B$38)),0-State!$B$30,0)),Arena.last!B2))")
(style "Arena" "B2:AO41" 5)
(conditional "Arena" 1 "B2:AO41" "=AND(ISNUMBER(B2),B2>0)" 1)
(conditional "Arena" 2 "B2:AO41" "=AND(ISNUMBER(B2),B2<0)" 2)
(conditional "Arena" 3 "B2:AO41" "=AND(ROW()=State!$B$46,COLUMN()=State!$B$47)" 3)
(conditional "Arena" 4 "B2:AO41" "=AND(ROW()=State!$B$48,COLUMN()=State!$B$49)" 4)
(conditional "Arena" 5 "B2:AO41" "=AND(State!$B$27=3,ISNUMBER(B2),B2<>0)" 10)
