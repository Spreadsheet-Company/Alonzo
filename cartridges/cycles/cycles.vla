(cell "Tally" "A1" "rounds")
(cell "Tally" "A2" "yours")
(cell "Tally" "A3" "the house's")
(cell "Tally" "A4" "nobody's")
(cell "Tally" "A5" "steps")
(formula "Tally" "B1" "=Tally.last!B1+State!B21")
(formula "Tally" "B2" "=Tally.last!B2+IF(AND(State!B43=1,State!B42=0),1,0)")
(formula "Tally" "B3" "=Tally.last!B3+IF(AND(State!B42=1,State!B43=0),1,0)")
(formula "Tally" "B4" "=Tally.last!B4+IF(AND(State!B42=1,State!B43=1),1,0)")
(formula "Tally" "B5" "=Tally.last!B5+State!B23")
