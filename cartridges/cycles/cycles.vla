(column "Layout" "AK" 2.86 shown none)
(column "Layout" "AL" 2.86 shown none)
(column "Layout" "AM" 2.86 shown none)
(column "Layout" "AN" 2.86 shown none)
(column "Layout" "AO" 2.86 shown none)
(cell "Layout" "B43" "Fill any cell above, B2 to AO41, with anything: it is a wall from the next round.")
(cell "Mind" "A1" "door")
(cell "Mind" "B1" "heading")
(cell "Mind" "C1" "row")
(cell "Mind" "D1" "column")
(cell "Mind" "A2" "ahead")
(cell "Mind" "A3" "left")
(cell "Mind" "A4" "right")
(cell "Mind" "A6" "weighs")
(cell "Mind" "L1" "points")
(cell "Mind" "M1" "order")
(cell "Mind" "N1" "chosen")
(cell "Mind" "P1" "past 1")
(cell "Mind" "Q1" "past 2")
(cell "Mind" "R1" "past 3")
(cell "Mind" "S1" "past 4")
(cell "Mind" "T1" "past 5")
(cell "Mind" "U1" "past 6")
(cell "Mind" "V1" "past 7")
(cell "Mind" "W1" "to its left")
(cell "Mind" "X1" "to its right")
(cell "Mind" "Y1" "the left corner")
(cell "Mind" "Z1" "the right corner")
(cell "Mind" "AA1" "whim")
(cell "Mind" "B8" 42)
(cell "Mind" "E1" "A written cell is the end.")
(cell "Mind" "E6" "a rule")
(formula "Mind" "E2:E4" "=IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2)),MAX(1,MIN(42,$D2)))=0,1,0)")
(cell "Mind" "F1" "Keep a way ahead.")
(cell "Mind" "F6" 3)
(formula "Mind" "F2:F4" "=IF($E2=1,1+SUM($P2:$V2),0)")
(cell "Mind" "G1" "Keep a wall beside you.")
(cell "Mind" "G6" 2)
(formula "Mind" "G2:G4" "=IF($E2=1,3-($P2+$W2+$X2),0)")
(cell "Mind" "H1" "Do not cut your own room in two.")
(cell "Mind" "H6" -60)
(formula "Mind" "H2:H4" "=IF(AND($E2=1,$P2+$W2+$X2-$P2*$W2*$Y2-$P2*$X2*$Z2>=2),1,0)")
(cell "Mind" "I1" "Take the door with the most room.")
(cell "Mind" "I6" 10)
(formula "Mind" "I2" "=IF($E2=1,SUMPRODUCT((Ahead9!$B$2:$AO$41>=State!$B$32-Mind!$B$8)*(Ahead9!$B$2:$AO$41>Yours9!$B$2:$AO$41)),0)")
(formula "Mind" "I3" "=IF($E3=1,SUMPRODUCT((Left9!$B$2:$AO$41>=State!$B$32-Mind!$B$8)*(Left9!$B$2:$AO$41>Yours9!$B$2:$AO$41)),0)")
(formula "Mind" "I4" "=IF($E4=1,SUMPRODUCT((Right9!$B$2:$AO$41>=State!$B$32-Mind!$B$8)*(Right9!$B$2:$AO$41>Yours9!$B$2:$AO$41)),0)")
(cell "Mind" "J1" "Hold your course.")
(cell "Mind" "J6" 1)
(formula "Mind" "J2:J4" "=IF(ROW()=2,1,0)")
(cell "Mind" "K1" "Leave the other's cell alone.")
(cell "Mind" "K6" "a rule")
(formula "Mind" "K2:K4" "=IF(AND($E2=1,ABS($C2-State!$B$46)+ABS($D2-State!$B$47)=1),1,0)")
(formula "Mind" "B2" "=State!B34")
(formula "Mind" "B3" "=MOD(State!B34+3,4)")
(formula "Mind" "B4" "=MOD(State!B34+1,4)")
(formula "Mind" "C2:C4" "=State!$B$48+CHOOSE($B2+1,-1,0,1,0)")
(formula "Mind" "D2:D4" "=State!$B$49+CHOOSE($B2+1,0,1,0,-1)")
(formula "Mind" "L2:L4" "=SUMPRODUCT($F2:$J2,Mind!$F$6:$J$6)")
(formula "Mind" "M2:M4" "=IF($E2=1,($L2-1000000*$K2)*1000+$AA2,-1000000000000)")
(formula "Mind" "N2:N4" "=IF(ROW()=Mind!$B$9+1,1,0)")
(formula "Mind" "P2:P4" "=IF($E2=1,IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+1*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+1*CHOOSE($B2+1,0,1,0,-1))))=0,1,0),0)")
(formula "Mind" "Q2:V4" "=IF(P2=1,IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+(COLUMN()-15)*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+(COLUMN()-15)*CHOOSE($B2+1,0,1,0,-1))))=0,1,0),0)")
(formula "Mind" "W2:W4" "=IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+CHOOSE(MOD($B2+3,4)+1,-1,0,1,0)+0*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+CHOOSE(MOD($B2+3,4)+1,0,1,0,-1)+0*CHOOSE($B2+1,0,1,0,-1))))=0,1,0)")
(formula "Mind" "X2:X4" "=IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+CHOOSE(MOD($B2+1,4)+1,-1,0,1,0)+0*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+CHOOSE(MOD($B2+1,4)+1,0,1,0,-1)+0*CHOOSE($B2+1,0,1,0,-1))))=0,1,0)")
(formula "Mind" "Y2:Y4" "=IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+CHOOSE(MOD($B2+3,4)+1,-1,0,1,0)+1*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+CHOOSE(MOD($B2+3,4)+1,0,1,0,-1)+1*CHOOSE($B2+1,0,1,0,-1))))=0,1,0)")
(formula "Mind" "Z2:Z4" "=IF(INDEX(Arena!$A$1:$AP$42,MAX(1,MIN(42,$C2+CHOOSE(MOD($B2+1,4)+1,-1,0,1,0)+1*CHOOSE($B2+1,-1,0,1,0))),MAX(1,MIN(42,$D2+CHOOSE(MOD($B2+1,4)+1,0,1,0,-1)+1*CHOOSE($B2+1,0,1,0,-1))))=0,1,0)")
(formula "Mind" "AA2" "=MOD(State!B53,500)")
(formula "Mind" "AA3" "=MOD(State!B54,500)")
(formula "Mind" "AA4" "=MOD(State!B55,500)")
(formula "Mind" "B9" "=MATCH(MAX(Mind!$M$2:$M$4),Mind!$M$2:$M$4,0)")
(formula "Mind" "B10" "=INDEX(Mind!$B$2:$B$4,Mind!B9)")
(format 13 none general wrap (font bold) (align center bottom))
(style "Mind" "A1:AA1" 13)
(column "Mind" "A" 22 shown none)
(row "Mind" 1 62 shown)
(column "Mind" "E" 16 shown none)
(column "Mind" "F" 16 shown none)
(column "Mind" "G" 16 shown none)
(column "Mind" "H" 16 shown none)
