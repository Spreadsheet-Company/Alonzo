(sheet "Screen" visible)
(sheet "Panel" visible)
(sheet "Tally" visible)
(sheet "Keys" visible)
(sheet "Camera" visible)
(sheet "Write" visible)
(sheet "Palette" visible)
(sheet "Clock" visible)
(sheet "File" visible)
(sheet "Input" visible)
(sheet "Screen.last" hidden)
(sheet "Panel.last" hidden)
(sheet "Tally.last" hidden)
(sheet "Keys.last" hidden)
(sheet "Camera.last" hidden)
(sheet "Write.last" hidden)
(sheet "Palette.last" hidden)
(sheet "Clock.last" hidden)
(sheet "File.last" hidden)
(sheet "Input.last" hidden)
(window "Tally" "A1:E20")
(extent "Tally" "A1:E20")
(gridlines "Tally" on)
(format 0 none general nowrap)
(cell "Tally" "A1" "up")
(formula "Tally" "B1" "=Tally.last!B1+IF(AND(Input!B1=1,Input.last!B1=0),1,0)")
(value "Tally" "B1" 0)
(formula "Tally" "C1" "=Tally.last!C1+IF(AND(Input!C1=1,Input.last!C1=0),1,0)")
(value "Tally" "C1" 1)
(formula "Tally" "D1" "=Tally.last!D1+IF(AND(Input!D1=1,Input.last!D1=0),1,0)")
