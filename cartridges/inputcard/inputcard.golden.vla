(cell "Tally" "A11" "pointer column")
(formula "Tally" "B11" "=IF(Input!B11>0,Input!B11,Tally.last!B11)")
(value "Tally" "B11" 8)
(cell "Tally" "A12" "pointer row")
(formula "Tally" "B12" "=IF(Input!B12>0,Input!B12,Tally.last!B12)")
(value "Tally" "B12" 4)
(cell "Tally" "A13" "left clicks")
(formula "Tally" "B13" "=Tally.last!B13+IF(AND(Input!B13=1,Input.last!B13=0),1,0)")
(value "Tally" "B13" 1)
(cell "Tally" "A14" "right clicks")
