; Expanded by the pass from inputcard.source.vla: edit that file, then expand it again.
(cartridge "inputcard"
  (spec 3)
  (title "Input card")
  (rate 30)
  (screen plane 40 24)
  (seed host)
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "The input card: every cell the host writes before a step, drawn. Press the arrows, Z, X, A, S, Enter and Space for player 1, and I, K, J, L, U, O, Y, P, 9 and 0 for player 2; click, and turn the wheel to pan the card. A lamp is white while its button is held, and moves to another color with each press."))
(sheet "Screen" visible)
(sheet "Panel" visible)
(sheet "Tally" visible)
(sheet "Keys" visible)
(sheet "Camera" visible)
(sheet "Write" visible)
(sheet "Palette" visible)
(cell "Palette" "A1" 0)
(cell "Palette" "B1" "#000000")
(cell "Palette" "C1" "black")
(cell "Palette" "A2" 1)
(cell "Palette" "B2" "#0000AA")
(cell "Palette" "C2" "blue")
(cell "Palette" "A3" 2)
(cell "Palette" "B3" "#00AA00")
(cell "Palette" "C3" "green")
(cell "Palette" "A4" 3)
(cell "Palette" "B4" "#00AAAA")
(cell "Palette" "C4" "cyan")
(cell "Palette" "A5" 4)
(cell "Palette" "B5" "#AA0000")
(cell "Palette" "C5" "red")
(cell "Palette" "A6" 5)
(cell "Palette" "B6" "#AA00AA")
(cell "Palette" "C6" "magenta")
(cell "Palette" "A7" 6)
(cell "Palette" "B7" "#AA5500")
(cell "Palette" "C7" "brown")
(cell "Palette" "A8" 7)
(cell "Palette" "B8" "#AAAAAA")
(cell "Palette" "C8" "light gray")
(cell "Palette" "A9" 8)
(cell "Palette" "B9" "#555555")
(cell "Palette" "C9" "dark gray")
(cell "Palette" "A10" 9)
(cell "Palette" "B10" "#5555FF")
(cell "Palette" "C10" "light blue")
(cell "Palette" "A11" 10)
(cell "Palette" "B11" "#55FF55")
(cell "Palette" "C11" "light green")
(cell "Palette" "A12" 11)
(cell "Palette" "B12" "#55FFFF")
(cell "Palette" "C12" "light cyan")
(cell "Palette" "A13" 12)
(cell "Palette" "B13" "#FF5555")
(cell "Palette" "C13" "light red")
(cell "Palette" "A14" 13)
(cell "Palette" "B14" "#FF55FF")
(cell "Palette" "C14" "light magenta")
(cell "Palette" "A15" 14)
(cell "Palette" "B15" "#FFFF55")
(cell "Palette" "C15" "yellow")
(cell "Palette" "A16" 15)
(cell "Palette" "B16" "#FFFFFF")
(cell "Palette" "C16" "white")
(cell "Keys" "A1" "up")
(cell "Keys" "A2" "down")
(cell "Keys" "A3" "left")
(cell "Keys" "A4" "right")
(cell "Keys" "A5" "a")
(cell "Keys" "A6" "b")
(cell "Keys" "A7" "x")
(cell "Keys" "A8" "y")
(cell "Keys" "A9" "start")
(cell "Keys" "A10" "select")
(cell "Keys" "B1" "ArrowUp")
(cell "Keys" "B2" "ArrowDown")
(cell "Keys" "B3" "ArrowLeft")
(cell "Keys" "B4" "ArrowRight")
(cell "Keys" "B5" "KeyZ")
(cell "Keys" "B6" "KeyX")
(cell "Keys" "B7" "KeyA")
(cell "Keys" "B8" "KeyS")
(cell "Keys" "B9" "Enter")
(cell "Keys" "B10" "Space")
(cell "Keys" "C1" "KeyI")
(cell "Keys" "C2" "KeyK")
(cell "Keys" "C3" "KeyJ")
(cell "Keys" "C4" "KeyL")
(cell "Keys" "C5" "KeyU")
(cell "Keys" "C6" "KeyO")
(cell "Keys" "C7" "KeyY")
(cell "Keys" "C8" "KeyP")
(cell "Keys" "C9" "Digit9")
(cell "Keys" "C10" "Digit0")
(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(formula "Camera" "B2" "=1+MOD(Tally!B16,9)")
(value "Camera" "B2" 1)
(cell "Tally" "A1" "up")
(cell "Tally" "A2" "down")
(cell "Tally" "A3" "left")
(cell "Tally" "A4" "right")
(cell "Tally" "A5" "a")
(cell "Tally" "A6" "b")
(cell "Tally" "A7" "x")
(cell "Tally" "A8" "y")
(cell "Tally" "A9" "start")
(cell "Tally" "A10" "select")
(cell "Tally" "A11" "pointer column")
(cell "Tally" "A12" "pointer row")
(cell "Tally" "A13" "left clicks")
(cell "Tally" "A14" "right clicks")
(cell "Tally" "A15" "middle clicks")
(cell "Tally" "A16" "wheel")
(cell "Tally" "A17" "keys")
(cell "Tally" "A18" "last code")
(cell "Tally" "A19" "dice")
(cell "Tally" "A20" "clicked at")
(formula "Tally" "B1:E10" "=Tally.last!B1+IF(AND(Input!B1=1,Input.last!B1=0),1,0)")
(formula "Tally" "B11:B12" "=IF(Input!B11>0,Input!B11,Tally.last!B11)")
(formula "Tally" "B13:B15" "=Tally.last!B13+IF(AND(Input!B13=1,Input.last!B13=0),1,0)")
(formula "Tally" "B16" "=Tally.last!B16+Input!B16")
(formula "Tally" "B17" "=Tally.last!B17+IF(Input!B18<>\"\",1,0)")
(formula "Tally" "B18" "=IF(Input!B18<>\"\",Input!B18,Tally.last!B18)")
(formula "Tally" "B19" "=IF(Clock!B1=1,Clock!B3,MOD(Tally.last!B19*16807,2147483647))")
(cell "Tally" "B20" 0)
(cell "Write" "A1" "sheet")
(cell "Write" "B1" "address")
(cell "Write" "C1" "value")
(cell "Write" "A2" "Tally")
(formula "Write" "B2" "=IF(AND(Input!B13=1,Input.last!B13=0),\"B20\",\"\")")
(formula "Write" "C2" "=Clock!B1")
(formula "Panel" "A1:AV1" "=IF(MOD(COLUMN(),8)=1,7,8)")
(formula "Panel" "I3:L12" "=IF(Input!B1=1,15,1+MOD(Tally!B1,7))")
(formula "Panel" "N3:N5" "=IF(Input!B13=1,12,8)")
(formula "Panel" "O3:O5" "=1+MOD(Tally!B13,7)")
(formula "Panel" "N7" "=IF(Input!$B$18<>\"\",14,0)")
(formula "Panel" "O7" "=1+MOD(Tally!$B$17,7)")
(formula "Panel" "I14:Q14" "=IF(COLUMN()-8=Camera!$B$2,14,8)")
(formula "Panel" "I18:AF18" "=IF(COLUMN()-8<=Clock!$B$2/5,9,0)")
(formula "Panel" "I20:X20" "=IF(MOD(INT(Clock!$B$1/2^(COLUMN()-9)),2)=1,11,1)")
(formula "Panel" "I22:AM22" "=IF(MOD(INT(Clock!$B$3/2^(COLUMN()-9)),2)=1,13,5)")
(formula "Panel" "I23:AM23" "=IF(MOD(INT(Tally!$B$19/2^(COLUMN()-9)),2)=1,10,2)")
(formula "Screen" "A1:AV24" "=IF(AND(ROW()=Input!$B$12,COLUMN()=Input!$B$11),IF(Input!$B$13=1,12,IF(Input!$B$14=1,10,IF(Input!$B$15=1,9,15))),Panel!A1)")
