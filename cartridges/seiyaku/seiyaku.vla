(formula "Deal" "A50:CC50" "=CHOOSE($B$1,Book!A1,Book!A2,Book!A3,Book!A4,Book!A5,Book!A6,Book!A7,Book!A8,Book!A9,Book!A10,Book!A11,Book!A12,Book!A13,Book!A14,Book!A15,Book!A16,Book!A17,Book!A18,Book!A19,Book!A20,Book!A21,Book!A22,Book!A23,Book!A24,Book!A25,Book!A26,Book!A27,Book!A28,Book!A29,Book!A30,Book!A31,Book!A32,Book!A33,Book!A34,Book!A35,Book!A36,Book!A37,Book!A38,Book!A39,Book!A40,Book!A41,Book!A42,Book!A43,Book!A44,Book!A45,Book!A46,Book!A47,Book!A48,Book!A49,Book!A50,Book!A51,Book!A52,Book!A53,Book!A54,Book!A55,Book!A56,Book!A57,Book!A58,Book!A59,Book!A60,Book!A61,Book!A62,Book!A63,Book!A64,Book!A65,Book!A66,Book!A67,Book!A68,Book!A69,Book!A70,Book!A71,Book!A72,Book!A73,Book!A74,Book!A75,Book!A76,Book!A77,Book!A78,Book!A79,Book!A80,Book!A81,Book!A82,Book!A83,Book!A84,Book!A85,Book!A86,Book!A87,Book!A88,Book!A89,Book!A90,Book!A91,Book!A92,Book!A93,Book!A94,Book!A95,Book!A96,Book!A97,Book!A98,Book!A99,Book!A100,Book!A101,Book!A102,Book!A103,Book!A104,Book!A105,Book!A106,Book!A107,Book!A108,Book!A109,Book!A110,Book!A111,Book!A112,Book!A113,Book!A114,Book!A115,Book!A116,Book!A117,Book!A118,Book!A119,Book!A120,Book!A121,Book!A122,Book!A123,Book!A124,Book!A125,Book!A126,Book!A127,Book!A128)")
(formula "Givens" "A11:I19" "=CHOOSE(IF(Deal!$B$2=1,(CHOOSE(COLUMN(),Deal!$F$1,Deal!$F$2,Deal!$F$3,Deal!$F$4,Deal!$F$5,Deal!$F$6,Deal!$F$7,Deal!$F$8,Deal!$F$9)-1)*9+Deal!$G1,(Deal!$F1-1)*9+CHOOSE(COLUMN(),Deal!$G$1,Deal!$G$2,Deal!$G$3,Deal!$G$4,Deal!$G$5,Deal!$G$6,Deal!$G$7,Deal!$G$8,Deal!$G$9)),Deal!$A$50,Deal!$B$50,Deal!$C$50,Deal!$D$50,Deal!$E$50,Deal!$F$50,Deal!$G$50,Deal!$H$50,Deal!$I$50,Deal!$J$50,Deal!$K$50,Deal!$L$50,Deal!$M$50,Deal!$N$50,Deal!$O$50,Deal!$P$50,Deal!$Q$50,Deal!$R$50,Deal!$S$50,Deal!$T$50,Deal!$U$50,Deal!$V$50,Deal!$W$50,Deal!$X$50,Deal!$Y$50,Deal!$Z$50,Deal!$AA$50,Deal!$AB$50,Deal!$AC$50,Deal!$AD$50,Deal!$AE$50,Deal!$AF$50,Deal!$AG$50,Deal!$AH$50,Deal!$AI$50,Deal!$AJ$50,Deal!$AK$50,Deal!$AL$50,Deal!$AM$50,Deal!$AN$50,Deal!$AO$50,Deal!$AP$50,Deal!$AQ$50,Deal!$AR$50,Deal!$AS$50,Deal!$AT$50,Deal!$AU$50,Deal!$AV$50,Deal!$AW$50,Deal!$AX$50,Deal!$AY$50,Deal!$AZ$50,Deal!$BA$50,Deal!$BB$50,Deal!$BC$50,Deal!$BD$50,Deal!$BE$50,Deal!$BF$50,Deal!$BG$50,Deal!$BH$50,Deal!$BI$50,Deal!$BJ$50,Deal!$BK$50,Deal!$BL$50,Deal!$BM$50,Deal!$BN$50,Deal!$BO$50,Deal!$BP$50,Deal!$BQ$50,Deal!$BR$50,Deal!$BS$50,Deal!$BT$50,Deal!$BU$50,Deal!$BV$50,Deal!$BW$50,Deal!$BX$50,Deal!$BY$50,Deal!$BZ$50,Deal!$CA$50,Deal!$CB$50,Deal!$CC$50)")
