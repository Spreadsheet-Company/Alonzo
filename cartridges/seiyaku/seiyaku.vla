(formula "Entries" "A1:I9" "=IF(OR(Lab!$B$2<>Lab.last!$B$2,Lab!$B$3<>Lab.last!$B$3),0,IF(Givens!A1>0,0,IF(Lab!$B$10=(ROW()-1)*9+COLUMN(),IF(Lab!$B$6>0,Lab!$B$6,IF(Lab!$B$8=1,0,Entries.last!A1)),Entries.last!A1)))")
(formula "Marks" "A1:I9" "=IF(OR(Lab!$B$2<>Lab.last!$B$2,Lab!$B$3<>Lab.last!$B$3),0,IF(Givens!A1>0,0,IF(Lab!$B$9=1,IF(Entries!A1>0,Marks.last!A1,Candidates!A83),IF(Lab!$B$10=(ROW()-1)*9+COLUMN(),IF(AND(Lab!$B$7>0,Entries!A1=0),IF(MOD(INT(Marks.last!A1/2^(Lab!$B$7-1)),2)=1,Marks.last!A1-2^(Lab!$B$7-1),Marks.last!A1+2^(Lab!$B$7-1)),IF(AND(Lab!$B$8=1,Entries.last!A1=0),0,Marks.last!A1)),Marks.last!A1))))")
