(formula "Lab" "B1" "=IF(OR(Lab!B2<>Lab.last!B2,Lab!B3<>Lab.last!B3),0,Lab.last!B1+IF(OR(Input!$B$13=1,Input!$B$14=1,Input!$B$15=1,Input!$B$20<>\"\"),1,0))")
(formula "Lab" "B2" "=Lab.last!B2+IF(Input!$B$20=\"instance\",1,0)")
(formula "Lab" "B3" "=Lab.last!B3+IF(Input!$B$20=\"retract-all\",1,0)")
(formula "Lab" "B4" "=IF(Clock!$B$1=1,2,IF(Input!$B$20=\"grade\",MOD(Lab.last!B4,4)+1,Lab.last!B4))")
(formula "Lab" "B5" "=IF(OR(Clock!$B$1=1,Lab!B2<>Lab.last!B2),Lab!B4,Lab.last!B5)")
(formula "Lab" "B6" "=(Input!$B$20=\"assign-1\")*1+(Input!$B$20=\"assign-2\")*2+(Input!$B$20=\"assign-3\")*3+(Input!$B$20=\"assign-4\")*4+(Input!$B$20=\"assign-5\")*5+(Input!$B$20=\"assign-6\")*6+(Input!$B$20=\"assign-7\")*7+(Input!$B$20=\"assign-8\")*8+(Input!$B$20=\"assign-9\")*9")
(formula "Lab" "B7" "=(Input!$B$20=\"domain-1\")*1+(Input!$B$20=\"domain-2\")*2+(Input!$B$20=\"domain-3\")*3+(Input!$B$20=\"domain-4\")*4+(Input!$B$20=\"domain-5\")*5+(Input!$B$20=\"domain-6\")*6+(Input!$B$20=\"domain-7\")*7+(Input!$B$20=\"domain-8\")*8+(Input!$B$20=\"domain-9\")*9")
(formula "Lab" "B8" "=IF(Input!$B$20=\"retract\",1,0)")
(formula "Lab" "B9" "=IF(Input!$B$20=\"domains\",1,0)")
(formula "Lab" "B10" "=IF(AND(Input!$B$19=\"Board\",Input!$B$11>=2,Input!$B$11<=10,Input!$B$12>=2,Input!$B$12<=10),(Input!$B$12-2)*9+(Input!$B$11-1),0)")
(formula "Lab" "B11" "=IF(AND(SUM(Planes!A1:I81)=81,SUM(Violations!A1:I9)=0),1,0)")
(formula "Lab" "B12" "=IF(Lab!B11=1,IF(Lab.last!B11=1,Lab.last!B12,Lab!B1),0)")
(cell "Deal" "A1" "puzzle")
(cell "Deal" "A2" "transposed")
(cell "Deal" "B9" "hash")
(cell "Deal" "C9" "key")
(cell "Deal" "D9" "rank")
(formula "Deal" "B1" "=32*(Lab!$B$5-1)+1+MOD(B10,32)")
(formula "Deal" "B2" "=MOD(B44,2)")
(formula "Deal" "F1:F9" "=3*(CHOOSE(INT((ROW()-1)/3)+1,$D$20,$D$21,$D$22)-1)+D23")
(formula "Deal" "G1:G9" "=3*(CHOOSE(INT((ROW()-1)/3)+1,$D$32,$D$33,$D$34)-1)+D35")
(formula "Deal" "B10:B44" "=MOD(MOD(Clock!$B$3*1103515+Lab!$B$2*7919+ROW()*1597334+3440100,67108859)*MOD(Clock!$B$3*2012345+Lab!$B$2*104729+ROW()*1209487+3213021,67108859),67108859)")
(formula "Deal" "C10:C44" "=B10*64+ROW()")
(formula "Deal" "D11:D19" "=1+(C$11<C11)+(C$12<C11)+(C$13<C11)+(C$14<C11)+(C$15<C11)+(C$16<C11)+(C$17<C11)+(C$18<C11)+(C$19<C11)")
