(cartridge "seiyaku"
  (spec 6)
  (title "Seiyaku 制約")
  (rate 0)
  (screen grid 9 9)
  (seed host)
  (settle 16)
  (bound "Board")
  (game "Board" "Constraints")
  (read "Board" "Constraints")
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "Seiyaku 制約: eighty-one variables, twenty-seven constraints, one solution, proven before you began. 1 to 9, the row's or the keypad's, assign a value to the variable the selection stands on and Backspace retracts it; Q W E, A S D and Z X C mark a value in its domain, each key where its mark stands in the cell; F fills every unassigned domain with the values its constraints allow; R retracts every assignment, N deals a new instance and G sets the next instance's grade."))
(sheet "Board" visible)
(sheet "Constraints" visible)
(sheet "Book" hidden)
(sheet "Deal" hidden)
(sheet "Givens" hidden)
(sheet "Entries" hidden)
(sheet "Marks" hidden)
