; Expanded by the pass from gridcard.source.vla: edit that file, then expand it again.
(cartridge "gridcard"
  (spec 3)
  (title "Grid card")
  (rate 30)
  (screen grid 80 50)
  (seed 1)
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "The grid card: every kind of value, format and look a grid cell can hold, drawn by the viewport, on a Screen 96 columns wide under a Camera that an edit moves. The sixteen colors are numbers drawn through their looks, a formula's value changes its fill every frame, and a stripe moves below."))
(sheet "Screen" visible)
(sheet "Camera" visible)
(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(cell "Camera" "B2" 1)
(format 1 "000000" general nowrap)
(look "Screen" 0 1)
(format 2 "0000AA" general nowrap)
(look "Screen" 1 2)
(format 3 "00AA00" general nowrap)
(look "Screen" 2 3)
(format 4 "00AAAA" general nowrap)
(look "Screen" 3 4)
(format 5 "AA0000" general nowrap)
(look "Screen" 4 5)
(format 6 "AA00AA" general nowrap)
(look "Screen" 5 6)
(format 7 "AA5500" general nowrap)
(look "Screen" 6 7)
(format 8 "AAAAAA" general nowrap)
(look "Screen" 7 8)
(format 9 "555555" general nowrap)
(look "Screen" 8 9)
(format 10 "5555FF" general nowrap)
(look "Screen" 9 10)
(format 11 "55FF55" general nowrap)
(look "Screen" 10 11)
(format 12 "55FFFF" general nowrap)
(look "Screen" 11 12)
(format 13 "FF5555" general nowrap)
(look "Screen" 12 13)
(format 14 "FF55FF" general nowrap)
(look "Screen" 13 14)
(format 15 "FFFF55" general nowrap)
(look "Screen" 14 15)
(format 16 "FFFFFF" general nowrap)
(look "Screen" 15 16)
(format 17 none text nowrap)
(format 18 "F7F4FC" general wrap)
(format 19 "555555" general nowrap)
(format 20 "F3F3EE" general nowrap)
(format 21 "E2D8F6" general nowrap)
(format 22 "D5F5D5" general nowrap)
(format 23 "EEEEEE" general nowrap)
(format 24 "FFD5D5" general nowrap)
(format 25 "FFF2CC" general nowrap)
(format 26 "E8F0FE" general nowrap)
(look "Screen" "#" 19)
(look "Screen" "." 20)
(look "Screen" "x" 21)
(look "Screen" true 22)
(look "Screen" false 23)
(look "Screen" (error "#N/A") 24)
(look "Screen" (error "#DIV/0!") 24)
(gridlines "Screen" on)
(column "Screen" "A" 40 shown none)
(column "Screen" "R" 3 shown none)
(column "Screen" "S" none hidden none)
(column "Screen" "T" 24 shown 26)
(row "Screen" 9 45 shown)
(row "Screen" 12 none hidden)
(cell "Screen" "A1" "The grid card: every kind of value, format and look a grid cell can hold, drawn by the viewport through a Camera that an edit moves")
(cell "Screen" "A3" "the sixteen colors, each through its look")
(cell "Screen" "B3" 0)
(cell "Screen" "C3" 1)
(cell "Screen" "D3" 2)
(cell "Screen" "E3" 3)
(cell "Screen" "F3" 4)
(cell "Screen" "G3" 5)
(cell "Screen" "H3" 6)
(cell "Screen" "I3" 7)
(cell "Screen" "J3" 8)
(cell "Screen" "K3" 9)
(cell "Screen" "L3" 10)
(cell "Screen" "M3" 11)
(cell "Screen" "N3" 12)
(cell "Screen" "O3" 13)
(cell "Screen" "P3" 14)
(cell "Screen" "Q3" 15)
(cell "Screen" "A4" "a value of each kind")
(cell "Screen" "B4" "x")
(cell "Screen" "C4" "7")
(cell "Screen" "D4" "")
(cell "Screen" "E4" true)
(cell "Screen" "F4" false)
(cell "Screen" "G4" (error "#NULL!"))
(cell "Screen" "H4" (error "#DIV/0!"))
(cell "Screen" "I4" (error "#VALUE!"))
(cell "Screen" "J4" (error "#REF!"))
(cell "Screen" "K4" (error "#NAME?"))
(cell "Screen" "L4" (error "#NUM!"))
(cell "Screen" "M4" (error "#N/A"))
(cell "Screen" "A5" "numbers as the record spells them")
(cell "Screen" "B5" 3.0000000000000004)
(cell "Screen" "C5" 1e-300)
(cell "Screen" "D5" -0)
(cell "Screen" "E5" 7.0)
(cell "Screen" "F5" 1e300)
(cell "Screen" "G5" -12.5)
(cell "Screen" "H5" 1234567.89)
(cell "Screen" "I5" 0.5)
(cell "Screen" "A6" "a formula of each kind, every frame")
(formula "Screen" "B6" "=MOD(Clock!$B$1,16)")
(formula "Screen" "C6" "=Clock!$B$1*16")
(formula "Screen" "D6" "=Clock!$B$1/2")
(formula "Screen" "E6" "=0.1*3*10")
(formula "Screen" "F6" "=1/0")
(formula "Screen" "G6" "=\"x\"")
(formula "Screen" "H6" "=1=1")
(formula "Screen" "I6" "=SIN(Clock!$B$1)")
(formula "Screen" "J6" "=-Clock!$B$1")
(formula "Screen" "K6" "=INT(Clock!$B$1/2)")
(formula "Screen" "L6" "=CHOOSE(1+MOD(Clock!$B$1,3),2,\"x\",TRUE)")
(formula "Screen" "M6" "=$A$2")
(formula "Screen" "N6" "=Screen.last!N6+1")
(formula "Screen" "O6" "=IF(MOD(Clock!$B$1,2)=0,9,0.5)")
(cell "Screen" "A7" "a text cut by its neighbor")
(cell "Screen" "B7" "this text stops where the next cell holds a value")
(cell "Screen" "C7" "stop")
(cell "Screen" "A8" "a number under a text format, then under general")
(cell "Screen" "B8" 42)
(cell "Screen" "C8" 42)
(cell "Screen" "A9" "a wrapped text in a tall row")
(cell "Screen" "B9" "wrapped in a tall row")
(cell "Screen" "A10" "a cell's own style, and a look over a style")
(cell "Screen" "B10" "styled")
(cell "Screen" "C10" 5)
(cell "Screen" "A11" "a sentence row, read by no rule")
(cell "Screen" "B11" "the program's row 11 wrote this cell")
(cell "Screen" "A12" "a hidden row")
(cell "Screen" "B12" 99)
(cell "Screen" "A13" "a narrow, a hidden and a styled column")
(cell "Screen" "R13" 12345)
(cell "Screen" "S13" "hidden")
(cell "Screen" "T13" "a cell of a styled column")
(cell "Screen" "A14" "looks on a text, a truth value and an error")
(cell "Screen" "B14" "#")
(cell "Screen" "C14" ".")
(cell "Screen" "D14" true)
(cell "Screen" "E14" false)
(cell "Screen" "F14" (error "#N/A"))
(cell "Screen" "G14" "x")
(cell "Screen" "A15" "the stripe below moves a cell a frame through two looks")
(style "Screen" "B8" 17)
(style "Screen" "B9" 18)
(style "Screen" "B10" 25)
(style "Screen" "C10" 25)
(sentence "Screen" "B11" 11)
(format 27 none "0.00" nowrap)
(format 28 none "#,##0.00" nowrap)
(format 29 none "0.00;(0.00)" nowrap)
(format 30 none "0%" nowrap)
(format 31 "E2D8F6" "0;-0;0;\"text: \"@" nowrap)
(format 32 "F7F4FC" "◆" nowrap)
(cell "Screen" "A16" "numbers under codes of Excel's, each drawn as the record's text")
(cell "Screen" "B16" 1.5)
(cell "Screen" "C16" 2.675)
(cell "Screen" "D16" 1234.5)
(cell "Screen" "E16" -3)
(cell "Screen" "F16" 0.25)
(cell "Screen" "H16" 1234567.891)
(cell "Screen" "I16" "quanta")
(cell "Screen" "J16" 3)
(cell "Screen" "K16" 0.125)
(formula "Screen" "G16" "=Clock!$B$1/4")
(style "Screen" "B16" 27)
(style "Screen" "C16" 27)
(style "Screen" "D16" 28)
(style "Screen" "E16" 29)
(style "Screen" "F16" 30)
(style "Screen" "G16" 27)
(style "Screen" "H16" 28)
(style "Screen" "I16" 31)
(style "Screen" "J16" 27)
(look "Screen" 0.125 32)
(format 33 none general nowrap (font bold))
(format 34 none general nowrap (font italic))
(format 35 none general nowrap (font 22))
(format 36 none general nowrap (font "6B4FC8"))
(format 37 none general nowrap (align left))
(format 38 none general nowrap (align center))
(format 39 none general nowrap (align right))
(format 40 none general nowrap (align general))
(format 41 none general nowrap (align top))
(format 42 none general nowrap (align middle))
(format 43 none general nowrap (align bottom))
(format 44 none general wrap (align center middle))
(format 45 "6B4FC8" general nowrap (font bold "FFFFFF") (align center middle))
(format 46 none general wrap (align center middle))
(format 47 none general nowrap (font bold 22 "6B4FC8"))
(format 48 none general nowrap (border (left medium) (right medium) (top medium) (bottom medium)))
(format 49 none general nowrap (border (left thin) (right thin) (top thin) (bottom thin)))
(format 50 none general nowrap (border (left thick) (right thick) (top thick) (bottom thick)))
(format 51 none general nowrap (border (right thin "FF0000") (bottom double)))
(format 52 none general nowrap (border (left thin "0000FF") (top dashed "00B050") (bottom dashed "00B050")))
(format 53 none general nowrap (align center middle) (border (left medium "6B4FC8") (right medium "6B4FC8") (top medium "6B4FC8") (bottom medium "6B4FC8")))
(format 54 "E8E0F7" general nowrap (border (left thin) (right thin) (top thin) (bottom thin)))
(format 55 none general nowrap (border (right dotted) (bottom slant-dash-dot)))
(format 56 none general nowrap (border (left thin "FF0000") (right thin "FF0000") (top thin "FF0000") (bottom thin "FF0000")))
(format 57 none general nowrap (border (left thin "0000FF")))
(format 58 none general nowrap (border (top thin "0000FF")))
(look "Screen" 77 47)
(cell "Screen" "A17" "fonts and alignment: the row fitted to its 22-point cell")
(cell "Screen" "B17" "bold")
(cell "Screen" "C17" "italic")
(cell "Screen" "D17" "big")
(cell "Screen" "E17" "ink")
(cell "Screen" "F17" 42)
(cell "Screen" "G17" "mid")
(cell "Screen" "H17" "end")
(cell "Screen" "I17" "top")
(cell "Screen" "J17" "middle")
(cell "Screen" "K17" "bottom")
(cell "Screen" "L17" "in the middle")
(cell "Screen" "M17" "[ Buy ]")
(cell "Screen" "N17" 77)
(cell "Screen" "O17" 1234567)
(cell "Screen" "A18" "a centered and a right-aligned spill")
(cell "Screen" "D18" "a centered text wider than its cell")
(cell "Screen" "L18" "right-aligned, spilling left")
(cell "Screen" "N18" 55)
(cell "Screen" "I2" "box")
(cell "Screen" "J2" "thin")
(cell "Screen" "K2" "thick")
(cell "Screen" "L2" "tie")
(cell "Screen" "M2" "dash")
(cell "Screen" "N2" 77)
(cell "Screen" "O2" "fill")
(cell "Screen" "P2" "slant")
(cell "Screen" "S2" "hid")
(cell "Screen" "T2" "beside a hidden column")
(cell "Screen" "I12" "hid")
(cell "Screen" "I13" "beside a hidden row")
(style "Screen" "B17" 33)
(style "Screen" "C17" 34)
(style "Screen" "D17" 35)
(style "Screen" "E17" 36)
(style "Screen" "F17" 37)
(style "Screen" "G17" 38)
(style "Screen" "H17" 39)
(style "Screen" "I17" 41)
(style "Screen" "J17" 42)
