; SPDX-License-Identifier: 0BSD
; Expanded by the pass from soundcard.source.vla: edit that file, then expand it again.
(cartridge "soundcard"
  (spec 3)
  (title "Sound card")
  (rate 30)
  (screen plane 48 24)
  (seed 1)
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "The sound card: press Sound on, then hear the four waves, a scale, two chords and a slide under a swell, an eight-second loop. Press the arrows, Z, X, A, S, Enter or Space, or click the plane, for a tick; write another wave into Knobs!B1 to change it."))
(sheet "Screen" visible)
(sheet "Audio" visible)
(sheet "Score" visible)
(sheet "Knobs" visible)
(sheet "Log" visible)
(sheet "Keys" visible)
(sheet "Palette" visible)
(cell "Palette" "A1" 0)
(cell "Palette" "B1" "#000000")
(cell "Palette" "C1" "black")
(cell "Palette" "A2" 1)
(cell "Palette" "B2" "#0000AA")
(cell "Palette" "C2" "blue")
(cell "Palette" "A3" 2)
(cell "Palette" "B3" "#00AA00")
(cell "Palette" "C3" "green")
(cell "Palette" "A4" 3)
(cell "Palette" "B4" "#00AAAA")
(cell "Palette" "C4" "cyan")
(cell "Palette" "A5" 4)
(cell "Palette" "B5" "#AA0000")
(cell "Palette" "C5" "red")
(cell "Palette" "A6" 5)
(cell "Palette" "B6" "#AA00AA")
(cell "Palette" "C6" "magenta")
(cell "Palette" "A7" 6)
(cell "Palette" "B7" "#AA5500")
(cell "Palette" "C7" "brown")
(cell "Palette" "A8" 7)
(cell "Palette" "B8" "#AAAAAA")
(cell "Palette" "C8" "light gray")
(cell "Palette" "A9" 8)
(cell "Palette" "B9" "#555555")
(cell "Palette" "C9" "dark gray")
(cell "Palette" "A10" 9)
(cell "Palette" "B10" "#5555FF")
(cell "Palette" "C10" "light blue")
(cell "Palette" "A11" 10)
(cell "Palette" "B11" "#55FF55")
(cell "Palette" "C11" "light green")
(cell "Palette" "A12" 11)
(cell "Palette" "B12" "#55FFFF")
(cell "Palette" "C12" "light cyan")
(cell "Palette" "A13" 12)
(cell "Palette" "B13" "#FF5555")
(cell "Palette" "C13" "light red")
(cell "Palette" "A14" 13)
(cell "Palette" "B14" "#FF55FF")
(cell "Palette" "C14" "light magenta")
(cell "Palette" "A15" 14)
(cell "Palette" "B15" "#FFFF55")
(cell "Palette" "C15" "yellow")
(cell "Palette" "A16" 15)
(cell "Palette" "B16" "#FFFFFF")
(cell "Palette" "C16" "white")
(cell "Keys" "A1" "up")
(cell "Keys" "A2" "down")
(cell "Keys" "A3" "left")
(cell "Keys" "A4" "right")
(cell "Keys" "A5" "a")
(cell "Keys" "A6" "b")
(cell "Keys" "A7" "x")
(cell "Keys" "A8" "y")
(cell "Keys" "A9" "start")
(cell "Keys" "A10" "select")
(cell "Keys" "B1" "ArrowUp")
(cell "Keys" "B2" "ArrowDown")
(cell "Keys" "B3" "ArrowLeft")
(cell "Keys" "B4" "ArrowRight")
(cell "Keys" "B5" "KeyZ")
(cell "Keys" "B6" "KeyX")
(cell "Keys" "B7" "KeyA")
(cell "Keys" "B8" "KeyS")
(cell "Keys" "B9" "Enter")
(cell "Keys" "B10" "Space")
(cell "Knobs" "A1" "tick wave")
(cell "Knobs" "B1" "sawtooth")
(cell "Knobs" "A2" "tick note")
(cell "Knobs" "B2" 84)
(cell "Knobs" "A3" "volume")
(cell "Knobs" "B3" 1)
(cell "Score" "A1" "section")
(cell "Score" "A2" "step")
(cell "Score" "A3" "presses")
(formula "Score" "B1" "=MOD(INT((Clock!B1-1)/60),4)")
(formula "Score" "B2" "=MOD(Clock!B1-1,60)")
(formula "Score" "C1:C10" "=IF(AND(Input!B1=1,Input.last!B1=0),1,0)")
(formula "Score" "C11" "=IF(AND(Input!B13=1,Input.last!B13=0),1,0)")
(formula "Score" "B3" "=SUM(C1:C11)")
(cell "Audio" "A1" "voice")
(cell "Audio" "B1" "wave")
(cell "Audio" "C1" "note")
(cell "Audio" "D1" "volume")
(cell "Audio" "A2" 1)
(cell "Audio" "A3" 2)
(cell "Audio" "A4" 3)
(cell "Audio" "A5" 4)
(cell "Audio" "B3" "triangle")
(cell "Audio" "B4" "sine")
(formula "Audio" "B2" "=IF(Score!$B$1=0,CHOOSE(1+INT(Score!$B$2/15),\"square\",\"triangle\",\"sawtooth\",\"sine\"),\"square\")")
(formula "Audio" "C2" "=IF(Score!$B$1=0,69,IF(Score!$B$1=1,CHOOSE(1+INT(Score!$B$2/7),60,62,64,65,67,69,71,72,72),IF(Score!$B$2<30,60,57)))")
(formula "Audio" "D2" "=IF(OR(Score!$B$1=0,AND(Score!$B$1=1,MOD(Score!$B$2,7)<6,Score!$B$2<56)),0.6,IF(Score!$B$1=2,0.4,0))*Knobs!$B$3")
(formula "Audio" "C3" "=IF(Score!$B$1=2,IF(Score!$B$2<30,64,60),48+0.4*Score!$B$2)")
(formula "Audio" "D3" "=IF(Score!$B$1=2,0.4,IF(Score!$B$1=3,0.8*(1-ABS(Score!$B$2-29.5)/29.5),0))*Knobs!$B$3")
(formula "Audio" "C4" "=IF(Score!$B$2<30,67,64)")
(formula "Audio" "D4" "=IF(Score!$B$1=2,0.4,0)*Knobs!$B$3")
(formula "Audio" "B5" "=Knobs!B1")
(formula "Audio" "C5" "=Knobs!B2")
(formula "Audio" "D5" "=IF(Score!$B$3>0,1,0)*Knobs!$B$3")
(formula "Log" "A1" "=Clock!B1")
(formula "Log" "B1:D1" "=Audio!B2")
(formula "Log" "E1:G1" "=Audio!B3")
(formula "Log" "H1:J1" "=Audio!B4")
(formula "Log" "K1:M1" "=Audio!B5")
(formula "Log" "A2:M32" "=Log.last!A1")
(formula "Screen" "A1:AV1" "=IF(AND(Audio!$D$2>0,INT(Audio!$C$2+0.5)=COLUMN()+47),10,IF(AND(Audio!$D$3>0,INT(Audio!$C$3+0.5)=COLUMN()+47),11,IF(AND(Audio!$D$4>0,INT(Audio!$C$4+0.5)=COLUMN()+47),14,IF(AND(Audio!$D$5>0,INT(Audio!$C$5+0.5)=COLUMN()+47),12,0))))")
(formula "Screen" "A2:AV24" "=Screen.last!A1")
