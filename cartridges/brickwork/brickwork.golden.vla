(window "Tally" "A1:B21")
(extent "Tally" "A1:B21")
(gridlines "Tally" on)
(format 0 none general nowrap)
(cell "Tally" "A1" "kind")
(cell "Tally" "B1" "laid")
(cell "Tally" "A2" 1)
(formula "Tally" "B2" "=Tally.last!B2+IF(AND(State!$B$54=1,State!$B$31=$A2),1,0)")
(value "Tally" "B2" 58)
(cell "Tally" "A3" 2)
(formula "Tally" "B3" "=Tally.last!B3+IF(AND(State!$B$54=1,State!$B$31=$A3),1,0)")
(value "Tally" "B3" 58)
