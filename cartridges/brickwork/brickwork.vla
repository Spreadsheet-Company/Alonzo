(formula "Wall" "B2:O25" "=IF(BITAND(Courses!$C2,Bits!B$1)>0,\"falling\",IF(BITAND(Courses!$D2,Bits!B$1)>0,\"landing\",IF(Laid!B2=0,\"\",IF(AND(State!$B$60=2,Courses!$K2=State!$B$1),\"full\",\"brick\"))))")
