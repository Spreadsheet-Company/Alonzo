(formula "Turns" "A2:A37" "=INT((ROW()-2)/4)+1")
(formula "Turns" "B2:B37" "=MOD(ROW()-2,4)")
(formula "Turns" "C2:C37" "=IF(INDEX(Bricks!$A$1:$R$37,4*$A2+0-2,4+4*$B2+0)=\"#\",1,0)+2*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+0-2,4+4*$B2+1)=\"#\",1,0)+4*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+0-2,4+4*$B2+2)=\"#\",1,0)")
(formula "Turns" "D2:D37" "=IF(INDEX(Bricks!$A$1:$R$37,4*$A2+1-2,4+4*$B2+0)=\"#\",1,0)+2*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+1-2,4+4*$B2+1)=\"#\",1,0)+4*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+1-2,4+4*$B2+2)=\"#\",1,0)")
(formula "Turns" "E2:E37" "=IF(INDEX(Bricks!$A$1:$R$37,4*$A2+2-2,4+4*$B2+0)=\"#\",1,0)+2*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+2-2,4+4*$B2+1)=\"#\",1,0)+4*IF(INDEX(Bricks!$A$1:$R$37,4*$A2+2-2,4+4*$B2+2)=\"#\",1,0)")
(formula "Turns" "J2:J37" "=BITOR(BITOR($C2,$D2),$E2)")
(formula "Turns" "F2:F37" "=IF(BITAND($J2,1)>0,0,IF(BITAND($J2,2)>0,1,2))")
(formula "Turns" "G2:G37" "=IF(BITAND($J2,4)>0,2,IF(BITAND($J2,2)>0,1,0))")
(formula "Turns" "H2:H37" "=IF($C2>0,0,IF($D2>0,1,2))")
(formula "Turns" "I2:I37" "=IF($E2>0,2,IF($D2>0,1,0))")
