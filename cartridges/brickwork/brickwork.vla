; SPDX-License-Identifier: 0BSD
; Expanded by the pass from brickwork.source.vla: edit that file, then expand it again.
(cartridge "brickwork"
  (spec 6)
  (title "Brickwork")
  (rate 60)
  (screen grid 14 24)
  (seed host)
  (bound "Wall")
  (game "Wall")
  (read "Wall" "Bricks")
  (work "Pace")
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "Brickwork: lay the falling bricks into whole courses. Left and Right move a brick, Down falls faster, Up or X turns it clockwise and Z counterclockwise, Space or Enter lays it where its shadow shows, P pauses. Each course cleared is a level, the score, and quickens the fall. The Pace sheet holds the pace and each brick's count in a bag, in the open."))
(sheet "Wall" visible)
(sheet "Bricks" visible)
(sheet "Pace" visible)
(sheet "State" hidden)
(sheet "Fit" hidden)
(sheet "Courses" hidden)
(sheet "Turns" hidden)
(sheet "Laid" hidden)
(sheet "Serials" hidden)
(sheet "Bits" hidden)
(sheet "Bag" hidden)
(sheet "Tally" hidden)
(sheet "Screen" hidden)
(sheet "Camera" hidden)
(sheet "Commands" hidden)
(sheet "Keys" hidden)
(sheet "Audio" hidden)
(format 1 "FFFFFF" ";;;" nowrap (border (left thin "E2D8F6") (right thin "E2D8F6") (top thin "E2D8F6") (bottom thin "E2D8F6")))
(format 3 "A080E0" ";;;" nowrap (border (left thin "C4B0F0") (right thin "C4B0F0") (top thin "C4B0F0") (bottom thin "C4B0F0")))
(format 5 "2E2645" general nowrap (border (left thin "3B3159") (right thin "3B3159") (top thin "3B3159") (bottom thin "3B3159")))
(format 6 "F3F3EE" general nowrap (font 14))
(format 7 "F3F3EE" general nowrap (font bold 16))
(format 8 "F3F3EE" general nowrap (font bold 14) (align center middle))
(format 9 "F3F3EE" general nowrap (font "2E2645" 12) (align center middle))
(format 10 "F3F3EE" general nowrap (font bold 14) (align left middle))
(format 11 (border (top medium "2E2645")))
(format 12 (border (right medium "2E2645")))
(format 13 (border (bottom medium "2E2645")))
(format 14 (border (left medium "2E2645")))
(format 20 "A080E0" ";;;" nowrap (border (right thin "D9D9D2") (bottom thin "D9D9D2")))
(format 21 none "0%" nowrap)
(look "Wall" "brick" 1)
(look "Wall" "falling" 1)
(look "Wall" "landing" 3)
(look "Wall" "full" 3)
(look "Wall" "queued" 3)
(gridlines "Wall" off)
(look "Bricks" "#" 20)
(gridlines "Bricks" on)
