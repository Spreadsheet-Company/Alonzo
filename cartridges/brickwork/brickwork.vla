(formula "Laid" "B2:O25" "=IF(State!$B$69=0,Laid.last!B2,CHOOSE(State!$B$69,IF(BITAND(Courses!$E2,Bits!B$1)>0,State!$B$27,Laid.last!B2),IF(Courses!$J2=0,0,INDEX(Laid.last!$B$2:$O$25,Courses!$J2,COLUMN()-1)),0))")
(formula "Serials" "B2:O25" "=IF(BITAND(Courses!$C2,Bits!B$1)>0,State!$B$27,Laid!B2)")
