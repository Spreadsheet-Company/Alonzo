(formula "State" "B3" "=2^State!B1-1")
(formula "State" "B4" "=INT((State!B1-3)/2)+1")
(formula "State" "B77" "=SUM(Bag!$I$1:$I$9)")
(cell "Pace" "B1" 60)
(formula "State" "B83" "=IF(ISNUMBER(Pace!B1),MAX(1,MIN(3600,Pace!B1)),60)")
(cell "Pace" "B2" 0.03)
(formula "State" "B84" "=IF(ISNUMBER(Pace!B2),MAX(0,MIN(1,Pace!B2)),0.03)")
(cell "Pace" "B3" 1)
(formula "State" "B85" "=IF(ISNUMBER(Pace!B3),MAX(1,MIN(3600,INT(Pace!B3))),1)")
(cell "Pace" "B4" 30)
(formula "State" "B86" "=IF(ISNUMBER(Pace!B4),MAX(0,MIN(3600,INT(Pace!B4))),30)")
(cell "Pace" "B5" 10)
(formula "State" "B87" "=IF(ISNUMBER(Pace!B5),MAX(0,MIN(3600,INT(Pace!B5))),10)")
(cell "Pace" "B6" 2)
(formula "State" "B88" "=IF(ISNUMBER(Pace!B6),MAX(1,MIN(3600,INT(Pace!B6))),2)")
(cell "Pace" "B7" 2)
(formula "State" "B89" "=IF(ISNUMBER(Pace!B7),MAX(1,MIN(3600,INT(Pace!B7))),2)")
(cell "Pace" "B8" 12)
(formula "State" "B90" "=IF(ISNUMBER(Pace!B8),MAX(2,MIN(3600,INT(Pace!B8))),12)")
(cell "Pace" "B9" 60)
(formula "State" "B91" "=IF(ISNUMBER(Pace!B9),MAX(0,MIN(3600,INT(Pace!B9))),60)")
(style "Pace" "B2" 21)
(column "Pace" "A" 52 shown none)
(column "Pace" "B" 8 shown none)
(formula "State" "B5" "=IF(Clock!$B$1=1,0,IF(AND(Input!B20=\"pause\",OR(State.last!B60=1,State.last!B60=2)),1-State.last!B5,State.last!B5))")
(formula "State" "B6" "=1-State!B5")
(formula "State" "B7" "=MAX(Input!B1,Input!B6)")
(formula "State" "B8" "=IF(AND(State!B7=1,State.last!B7=0),1,0)")
(formula "State" "B9" "=IF(AND(Input!B5=1,Input.last!B5=0),1,0)")
(formula "State" "B10" "=MAX(Input!B9,Input!B10)")
(formula "State" "B11" "=IF(AND(State!B10=1,State.last!B10=0),1,0)")
(formula "State" "B12" "=IF(Input!B3=1,State.last!B12+1,0)")
(formula "State" "B13" "=IF(Input!B4=1,State.last!B13+1,0)")
(formula "State" "B14" "=IF(AND(State!B6=1,Input!B3=1,IF(OR(State!B12=1,AND(State!B12>State!B87,MOD(State!B12-State!B87-1,State!B88)=0)),1,0)=1),1,0)")
(formula "State" "B15" "=IF(AND(State!B6=1,Input!B4=1,IF(OR(State!B13=1,AND(State!B13>State!B87,MOD(State!B13-State!B87-1,State!B88)=0)),1,0)=1),1,0)")
(formula "State" "B16" "=State!B15-State!B14")
(formula "State" "B17" "=IF(State!B6=1,State!B8-State!B9,0)")
