(formula "Courses" "B2:B25" "=SUMPRODUCT((Laid.last!$B2:$O2<>0)*1,Bits!$B$1:$O$1)")
(formula "Courses" "C2:C25" "=IF(State!$B$60=1,IF(AND($A2-State!$B$56>=0,$A2-State!$B$56<=2),INDEX(Turns!$C$2:$E$37,State!$B$59,$A2-State!$B$56+1)*2^(State!$B$57-1),0),0)")
