; SPDX-License-Identifier: 0BSD
; common.vla - a library of template macros that a cartridge's source includes
; (SPEC.md section 7.8), 0BSD with the cartridges, so it is copied freely. The pass
; knows none of these by name: each is a text an author wrote, and a source may define
; its own beside them, or include a library of its own instead. They are examples, to
; be read, copied, changed and outgrown.
;
; The rules each macro here keeps, which are the language's:
;   - Template macros only. A parameter is replaced by the form the caller passes; no
;     gensym and no eval, every binding named by the caller.
;   - A parameter never takes the name of a row it writes: a parameter called name
;     would replace the head of a (name ...) row too, and the load would refuse the row.
;   - A macro that walks a list recurses in tail position, its own call the last form
;     of its begin, so the expander's trampoline keeps the rows flat. A chain stops at
;     5,000 applications, and each step copies the rest of the list, so a walk is for
;     dozens of items, never thousands.
;   - An address is fused: (symbol "\"A" (+expand index 1)) is the text "A1", since
;     symbol makes a string of a fused text that opens on a quote mark, and +expand adds
;     two numbers as the macro expands. A row is reached by arithmetic; a column and a
;     sheet only by the names a caller writes, until the language holds the arithmetic
;     of an address (SPEC.md section 12).

; ---- one sheet, named once ----------------------------------------------------------
; A run of rows on one sheet, the sheet named at the top of the run and not on every
; row: cells and formulas take entries, each an address or a range and what it holds,
; and on takes rows, or calls of a macro such as live, each written without its sheet.
; The cartridge the pass writes still names the sheet on every row, which stands alone
; there, as the record prints it (SPEC.md section 7.3).

(defmacro (cells sheet & entries)
  "value cells of one sheet, named once: each entry an address or a range, then its value"
  (quote-if (null? entries)
    (begin)
    (begin
      (cell sheet (car (car entries)) (car (cdr (car entries))))
      (quasiquote (cells (unquote sheet) (unquote-splicing (cdr entries)))))))

(defmacro (formulas sheet & entries)
  "formula cells of one sheet, named once: each entry an address or a range, then its formula"
  (quote-if (null? entries)
    (begin)
    (begin
      (formula sheet (car (car entries)) (car (cdr (car entries))))
      (quasiquote (formulas (unquote sheet) (unquote-splicing (cdr entries)))))))

(defmacro (on sheet & forms)
  "rows of one sheet, named once: each a row, or a call whose first argument is the sheet, written without it"
  (quote-if (null? forms)
    (begin)
    (begin
      (cons (car (car forms)) (cons sheet (cdr (car forms))))
      (quasiquote (on (unquote sheet) (unquote-splicing (cdr forms)))))))

; ---- the Palette (SPEC.md section 3.2) ----------------------------------------------

(defmacro (palette & entries)
  "the Palette's sixteen rows: each entry a colour and a name, its index its place from 0"
  (quasiquote (palette-from 0 (unquote entries))))

(defmacro (palette-from index entries)
  "the Palette's rows from an index on, an entry at a time"
  (quote-if (null? entries)
    (begin)
    (begin
      (palette-entry index (car entries))
      (palette-from (+expand index 1) (cdr entries)))))

(defmacro (palette-entry index entry)
  "one Palette row: the index in column A, the colour in B, the name in C"
  (cell "Palette" (symbol "\"A" (+expand index 1)) index)
  (cell "Palette" (symbol "\"B" (+expand index 1)) (car entry))
  (cell "Palette" (symbol "\"C" (+expand index 1)) (car (cdr entry))))

(defmacro (cga-palette)
  "the CGA's sixteen in their own order, SPEC.md section 3.2's table, a palette with a name"
  (palette                          ; the sixteen colours, index 0 first
    ("#000000" "black")             ; 0
    ("#0000AA" "blue")              ; 1
    ("#00AA00" "green")             ; 2
    ("#00AAAA" "cyan")              ; 3
    ("#AA0000" "red")               ; 4
    ("#AA00AA" "magenta")           ; 5
    ("#AA5500" "brown")             ; 6
    ("#AAAAAA" "light grey")        ; 7
    ("#555555" "dark grey")         ; 8
    ("#5555FF" "light blue")        ; 9
    ("#55FF55" "light green")       ; 10
    ("#55FFFF" "light cyan")        ; 11
    ("#FF5555" "light red")         ; 12
    ("#FF55FF" "light magenta")     ; 13
    ("#FFFF55" "yellow")            ; 14
    ("#FFFFFF" "white")))           ; 15

; ---- the buttons and the keys (SPEC.md sections 3.3 and 3.4) --------------------------

(defmacro (button-labels sheet)
  "the Input sheet's ten button labels in a sheet's column A, up to select, rows 1 to 10"
  (cell sheet "A1" "up")
  (cell sheet "A2" "down")
  (cell sheet "A3" "left")
  (cell sheet "A4" "right")
  (cell sheet "A5" "a")
  (cell sheet "A6" "b")
  (cell sheet "A7" "x")
  (cell sheet "A8" "y")
  (cell sheet "A9" "start")
  (cell sheet "A10" "select"))

(defmacro (keys letter & codes)
  "a player's column of the Keys sheet: the KeyboardEvent.code that holds each button, up to select, from row 1"
  (quasiquote (keys-from (unquote letter) 0 (unquote codes))))

(defmacro (keys-from letter index codes)
  "a player's codes from an index on, a code at a time; the column's letter fused before the row"
  (quote-if (null? codes)
    (begin)
    (begin
      (cell "Keys" (symbol "\"" letter (+expand index 1)) (car codes))
      (keys-from letter (+expand index 1) (cdr codes)))))

; ---- the Audio sheet (SPEC.md section 3.6) ------------------------------------------
; A table, a voice a row: the header in row 1 and the voices' numbers in column A, rows 2
; to 5; a cartridge writes each voice's wave, note and volume in columns B to D itself.

(defmacro (audio)
  "the Audio sheet's header row, voice, wave, note and volume, and its four voices' numbers"
  (cell "Audio" "A1" "voice")
  (cell "Audio" "B1" "wave")
  (cell "Audio" "C1" "note")
  (cell "Audio" "D1" "volume")
  (cell "Audio" "A2" 1)
  (cell "Audio" "A3" 2)
  (cell "Audio" "A4" 3)
  (cell "Audio" "A5" 4))

; ---- patterns -----------------------------------------------------------------------

(defmacro (live sheet & cells)
  "the value 1 in each cell named: a pattern's live cells, one row of it a call"
  (quote-if (null? cells)
    (begin)
    (begin
      (cell sheet (car cells) 1)
      (quasiquote (live (unquote sheet) (unquote-splicing (cdr cells)))))))
