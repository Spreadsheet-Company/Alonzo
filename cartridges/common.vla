; SPDX-License-Identifier: 0BSD
; common.vla - a library of template macros that a cartridge's source includes
; (SPEC.md section 7.8), 0BSD with the cartridges, so it is copied freely. The pass
; knows none of these by name: each is a text an author wrote, and a source may define
; its own beside them, or include a library of its own instead. They are examples, to
; be read, copied, changed and outgrown. Since KIT.1 they hold the kit's first verbs,
; the patterns two cartridges wrote alike by hand, or one wrote as the page spells it.
;
; The rules each macro here keeps, which are the language's:
;   - Template macros only. A parameter is replaced by the form the caller passes; no
;     gensym and no eval, every binding named by the caller.
;   - A parameter never takes the name of a row it writes: a parameter called name
;     would replace the head of a (name ...) row too, and the load would refuse the row.
;   - A macro that walks a list recurses in tail position, its own call the last form
;     of its begin, so the expander's trampoline keeps the rows flat. A chain stops at
;     5,000 applications, and each step copies the rest of the list, so a walk is for
;     dozens of items, never thousands.
;   - An address is joined: (&expand "A" (+expand index 1)) is the text "A1", since
;     &expand joins its atoms into one text and +expand adds two numbers as the macro
;     expands. A column is reached by arithmetic too, (address-expand row column) or
;     (column-letters-expand column), and a text is split by characters-expand: the
;     expand-time primitives vla-lang 0.9.0 added (SPEC.md section 7.8).
;   - A macro's call is no argument of &expand, nor of any expand-time primitive, which
;     takes its arguments as data: (&expand "=" (twin ...)) is refused, with the id
;     vla-expand-arg-is-list. So a macro that finds a text hands it on to the macro
;     named after it, (first-cell range then args...) becoming (then first args...), and
;     the verbs compose by reference, one writing a cell that another reads.
;   - A verb builds its row inside a quasiquote, its pieces spliced in by unquote and
;     joined when the row itself is expanded, so a piece may be a string or an &expand
;     of strings. Named inside the verb's own &expand, a parameter bound to an &expand
;     would be handed over as the list it is, and refused.

; ---- one sheet, named once ----------------------------------------------------------
; A run of rows on one sheet, the sheet named at the top of the run and not on every
; row: cells and formulas take entries, each an address or a range and what it holds,
; and on takes rows, or calls of a macro such as live, each written without its sheet.
; The cartridge the pass writes still names the sheet on every row, which stands alone
; there, as the record prints it (SPEC.md section 7.3).

(defmacro (cells sheet & entries)
  "value cells of one sheet, named once: each entry an address or a range, then its value"
  (quote-if (null? entries)
    (begin)
    (begin
      (cell sheet (car (car entries)) (car (cdr (car entries))))
      (quasiquote (cells (unquote sheet) (unquote-splicing (cdr entries)))))))

(defmacro (formulas sheet & entries)
  "formula cells of one sheet, named once: each entry an address or a range, then its formula"
  (quote-if (null? entries)
    (begin)
    (begin
      (formula sheet (car (car entries)) (car (cdr (car entries))))
      (quasiquote (formulas (unquote sheet) (unquote-splicing (cdr entries)))))))

(defmacro (on sheet & forms)
  "rows of one sheet, named once: each a row, or a call whose first argument is the sheet, written without it"
  (quote-if (null? forms)
    (begin)
    (begin
      (cons (car (car forms)) (cons sheet (cdr (car forms))))
      (quasiquote (on (unquote sheet) (unquote-splicing (cdr forms)))))))

; ---- the sheets, and their words ----------------------------------------------------
; A cartridge's sheets in tab order, each visible; a sheet hidden is written as its own
; row, (sheet "X" hidden). Then a sheet's own words: a block of settings holds a label
; in column A beside each value in column B, and a table holds its headers in row 1
; over its columns (SPEC.md section 3). Each takes the cell its first text goes in, and
; the texts in order, a text or a number each.

(defmacro (sheets & tabs)
  "the sheets in tab order, each visible: a (sheet name visible) row a name"
  (quote-if (null? tabs)
    (begin)
    (begin
      (sheet (car tabs) visible)
      (quasiquote (sheets (unquote-splicing (cdr tabs)))))))

(defmacro (labels sheet first & texts)
  "texts down a column from a cell, one a row: a block's labels"
  (quasiquote (labels-from (unquote sheet) (unquote (row-expand first)) (unquote (column-expand first)) (unquote-splicing texts))))

(defmacro (labels-from sheet row column & texts)
  "labels' walk: a text a row, down from the row and the column given"
  (quote-if (null? texts)
    (begin)
    (begin
      (cell sheet (address-expand row column) (car texts))
      (quasiquote (labels-from (unquote sheet) (unquote (+expand row 1)) (unquote column) (unquote-splicing (cdr texts)))))))

(defmacro (headers sheet first & texts)
  "texts along a row from a cell, one a column: a table's headers"
  (quasiquote (headers-from (unquote sheet) (unquote (row-expand first)) (unquote (column-expand first)) (unquote-splicing texts))))

(defmacro (headers-from sheet row column & texts)
  "headers' walk: a text a column, along from the row and the column given"
  (quote-if (null? texts)
    (begin)
    (begin
      (cell sheet (address-expand row column) (car texts))
      (quasiquote (headers-from (unquote sheet) (unquote row) (unquote (+expand column 1)) (unquote-splicing (cdr texts)))))))

; ---- the Palette (SPEC.md section 3.2) ----------------------------------------------

(defmacro (palette & entries)
  "the Palette's sixteen rows: each entry a colour and a name, its index its place from 0"
  (quasiquote (palette-from 0 (unquote entries))))

(defmacro (palette-from index entries)
  "the Palette's rows from an index on, an entry at a time"
  (quote-if (null? entries)
    (begin)
    (begin
      (palette-entry index (car entries))
      (palette-from (+expand index 1) (cdr entries)))))

(defmacro (palette-entry index entry)
  "one Palette row: the index in column A, the colour in B, the name in C"
  (cell "Palette" (symbol "\"A" (+expand index 1)) index)
  (cell "Palette" (symbol "\"B" (+expand index 1)) (car entry))
  (cell "Palette" (symbol "\"C" (+expand index 1)) (car (cdr entry))))

(defmacro (cga-palette)
  "the CGA's sixteen in their own order, SPEC.md section 3.2's table, a palette with a name"
  (palette                          ; the sixteen colours, index 0 first
    ("#000000" "black")             ; 0
    ("#0000AA" "blue")              ; 1
    ("#00AA00" "green")             ; 2
    ("#00AAAA" "cyan")              ; 3
    ("#AA0000" "red")               ; 4
    ("#AA00AA" "magenta")           ; 5
    ("#AA5500" "brown")             ; 6
    ("#AAAAAA" "light grey")        ; 7
    ("#555555" "dark grey")         ; 8
    ("#5555FF" "light blue")        ; 9
    ("#55FF55" "light green")       ; 10
    ("#55FFFF" "light cyan")        ; 11
    ("#FF5555" "light red")         ; 12
    ("#FF55FF" "light magenta")     ; 13
    ("#FFFF55" "yellow")            ; 14
    ("#FFFFFF" "white")))           ; 15

; ---- the buttons and the keys (SPEC.md sections 3.3 and 3.4) --------------------------

(defmacro (button-labels sheet)
  "the Input sheet's ten button labels in a sheet's column A, up to select, rows 1 to 10"
  (labels sheet "A1" "up" "down" "left" "right" "a" "b" "x" "y" "start" "select"))

(defmacro (keys letter & codes)
  "a player's column of the Keys sheet: the KeyboardEvent.code that holds each button, up to select, from row 1"
  (quasiquote (keys-from (unquote letter) 0 (unquote codes))))

(defmacro (keys-from letter index codes)
  "a player's codes from an index on, a code at a time; the column's letter joined to the row"
  (quote-if (null? codes)
    (begin)
    (begin
      (cell "Keys" (&expand letter (+expand index 1)) (car codes))
      (keys-from letter (+expand index 1) (cdr codes)))))

(defmacro (default-keys)
  "the Keys sheet as SPEC.md section 3.4 tabulates it: the ten labels in column A, and player 1's keys, TIC-80's, in column B; a later player is a keys call"
  (button-labels "Keys")
  (keys "B"                         ; player 1: SPEC.md section 3.4's defaults, TIC-80's
    "ArrowUp"                       ; up
    "ArrowDown"                     ; down
    "ArrowLeft"                     ; left
    "ArrowRight"                    ; right
    "KeyZ"                          ; a
    "KeyX"                          ; b
    "KeyA"                          ; x
    "KeyS"                          ; y
    "Enter"                         ; start
    "Space"))                       ; select

; ---- the Audio sheet (SPEC.md section 3.6) ------------------------------------------
; A table, a voice a row: the header in row 1 and the voices' numbers in column A, rows 2
; to 5; a cartridge writes each voice's wave, note and volume in columns B to D itself.

(defmacro (audio)
  "the Audio sheet's header row, voice, wave, note and volume, and its four voices' numbers"
  (headers "Audio" "A1" "voice" "wave" "note" "volume")
  (labels "Audio" "A2" 1 2 3 4))

; ---- the verbs: the first frame, a press, a count, a hold and the dice ---------------
; Each verb writes one formula row, one shape filled over a range, which the language
; computes as a run (SPEC.md section 2's rules). The sheet comes first, so that on names
; it once, then the range, then what the verb means, in the order its formula reads it.
; Its other arguments are pieces of a formula without the = sign, a reference, a test
; or an expression, written as the range's first cell reads it; the fill moves them as
; it moves every relative reference. A piece is a string or an &expand of strings, and
; never another macro's call: one verb writes a cell that another reads, and so every
; pattern's value is a cell a person sees. A verb writes a twin as its sheet's name and
; .last, so it wants a sheet whose name a formula writes bare, without quotes, as every
; sheet the cartridges name is.

(defmacro (first-frame sheet range start rule)
  "the first frame's value, then the rule every later frame: =IF(Clock!$B$1=1,start,rule)"
  (quasiquote (formula (unquote sheet) (unquote range) (&expand "=IF(Clock!$B$1=1," (unquote start) "," (unquote rule) ")"))))

(defmacro (pressed sheet range button)
  "1 in the frame a button goes down and 0 otherwise, its cell 1 this frame and 0 the last, the rising edge (SPEC.md section 3.3): =IF(AND(button=1,its twin=0),1,0)"
  (twin button pressed-from sheet range button))

(defmacro (pressed-from last sheet range button)
  "pressed, its button's twin found"
  (quasiquote (formula (unquote sheet) (unquote range) (&expand "=IF(AND(" (unquote button) "=1," (unquote last) "=0),1,0)"))))

(defmacro (count sheet range event)
  "each cell its own last value plus an event, a count of the frames it is 1 or a sum of its numbers: =sheet.last!first+event"
  (first-cell range count-from sheet range event))

(defmacro (count-from first sheet range event)
  "count, its range's first cell found"
  (quasiquote (formula (unquote sheet) (unquote range) (&expand "=" (unquote sheet) ".last!" (unquote first) "+" (unquote event)))))

(defmacro (hold sheet range when new)
  "each cell its own last value until an event replaces it, SPEC.md section 3.9's keep-last: =IF(when,new,sheet.last!first)"
  (first-cell range hold-from sheet range when new))

(defmacro (hold-from first sheet range when new)
  "hold, its range's first cell found"
  (quasiquote (formula (unquote sheet) (unquote range) (&expand "=IF(" (unquote when) "," (unquote new) "," (unquote sheet) ".last!" (unquote first) ")"))))

(defmacro (dice sheet at)
  "Park and Miller's minimal standard in one cell (SPEC.md section 3.5): the seed in the first frame, then the last value times 16807, modulo 2147483647; one cell, since its Clock references are relative and a fill would move them"
  (quasiquote (formula (unquote sheet) (unquote at) (&expand "=IF(Clock!B1=1,Clock!B3,MOD(" (unquote sheet) ".last!" (unquote at) "*16807,2147483647))"))))

; A verb that reads its own last value writes the twin of its range's first cell,
; Tally.last!B1 for a fill over Tally!B1:E10, and pressed writes its button's twin,
; Input.last!B1 for Input!B1. No primitive gives either text, and a macro's call is no
; argument of &expand, so each is found by a walk that hands it on: (first-cell range
; then args...) becomes (then first args...), the macro named then called with the
; first cell before its own arguments, and twin hands on a reference's twin the same
; way. An application a character, up to the range's colon or the reference's end.

(defmacro (first-cell range then & args)
  "a range's first cell, its text before the colon, handed on: (then first args...)"
  (quasiquote (first-cell-from (unquote (characters-expand range)) "" (unquote then) (unquote-splicing args))))

(defmacro (first-cell-from characters made then & args)
  "first-cell's walk: the range's characters one at a time, up to its colon or its end"
  (quote-if (null? characters)
    (quasiquote ((unquote then) (unquote made) (unquote-splicing args)))
    (quote-if (eq? (car characters) ":")
      (quasiquote ((unquote then) (unquote made) (unquote-splicing args)))
      (quasiquote (first-cell-from (unquote (cdr characters)) (unquote (&expand made (car characters))) (unquote then) (unquote-splicing args))))))

(defmacro (twin reference then & args)
  "a reference's twin, Input!B1 read as Input.last!B1, handed on: (then twin args...)"
  (quasiquote (twin-from (unquote (characters-expand reference)) "" (unquote then) (unquote-splicing args))))

(defmacro (twin-from characters made then & args)
  "twin's walk: the reference's characters one at a time, its ! written .last!"
  (quote-if (null? characters)
    (quasiquote ((unquote then) (unquote made) (unquote-splicing args)))
    (quasiquote (twin-from (unquote (cdr characters)) (unquote (quote-if (eq? (car characters) "!") (&expand made ".last!") (&expand made (car characters)))) (unquote then) (unquote-splicing args)))))

; ---- patterns -----------------------------------------------------------------------

(defmacro (live sheet & cells)
  "the value 1 in each cell named: a pattern's live cells, one row of it a call"
  (quote-if (null? cells)
    (begin)
    (begin
      (cell sheet (car cells) 1)
      (quasiquote (live (unquote sheet) (unquote-splicing (cdr cells)))))))
