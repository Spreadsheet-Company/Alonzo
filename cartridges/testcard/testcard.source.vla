; SPDX-License-Identifier: 0BSD
; testcard.source.vla - the plane's test card, as its author writes it: every kind of
; value a Screen cell can hold, drawn through the Palette, on a Screen wider than its
; window, which the Camera pans one column a frame. The pass expands this file into
; testcard.vla beside it, the rows the engine loads (docs/SPEC.md section 7.8): edit this one,
; then expand it again. The fixture of ENGINE.2's equality: the plane of a window is the
; record of the same window, byte for value (docs/SPEC.md sections 3.1, 4.5 and 13), which the
; engine's tests and the page's loop oracle hold every frame. A whole number from 0 to 15
; is its color; from 16 to 254 it is a byte past the palette, which the host paints
; magenta; anything else is 255, magenta too; an empty cell, and a formula before its
; first value, is 0.

(cartridge "testcard"
  (spec 2)                          ; the version of docs/SPEC.md this cartridge is written to
  (title "Test card")               ; what the host shows
  (rate 30)                         ; frames a second
  (screen plane 40 24)              ; the window: 40 cells wide and 24 high, placed by the Camera
  (seed 1)                          ; the dice, which nothing here reads
  (author "Spreadsheet Company")    ; who wrote it
  (license "0BSD")                  ; the header's twin
  (notes "The plane's test card: the sixteen colors as bars, then every kind of value a Screen cell can hold, then formulas that compute each kind, on a Screen 56 columns wide that the Camera pans one column a frame. Anything that is not a whole number from 0 to 15 is magenta, so a wrong value is seen."))

; The library whose macros this source calls: sheets; cga-palette, a palette with a name;
; on and cells, each naming a sheet once over a run of its rows; rule, a formula row from
; an expression; and the verb count.
(include "../common.vla")

; The sheets, in tab order: the Screen, the Palette it draws with, the Camera that places it.
(sheets "Screen" "Palette" "Camera")

; The Palette (docs/SPEC.md section 3.2): the CGA's sixteen in their own order, the library's
; palette with a name, which writes the index, the color as #RRGGBB and a name into
; columns A, B and C.
(cga-palette)

; The Camera (docs/SPEC.md section 3.8): the window's top row stays 1, and its left column pans
; from 1 to 21 and back, one column a frame, so the window's right edge passes the Screen's
; last column, BD, and the columns past it read blank. The value row after the formula is
; the column at frame 0, a save's spelling (section 7.3), so the first frame is drawn at
; column 1 with no word about an empty Camera.
(on "Camera"                                ; the sheet every row below writes
  (cell "A1" "row")                         ; a label
  (cell "B1" 1)                             ; the window's top row
  (cell "A2" "column")                      ; a label
  (rule "B2" (+ 1 (mod Clock!$B$1 21)))     ; the window's left column, a column a frame
  (value "B2" 1))                           ; that column at frame 0

; Rows 1 to 8: the sixteen colors as bars three columns wide, A to AV.
(cells "Screen"                     ; the sheet every entry below writes
  ("A1:C8" 0)                       ; black
  ("D1:F8" 1)                       ; blue
  ("G1:I8" 2)                       ; green
  ("J1:L8" 3)                       ; cyan
  ("M1:O8" 4)                       ; red
  ("P1:R8" 5)                       ; magenta
  ("S1:U8" 6)                       ; brown
  ("V1:X8" 7)                       ; light gray
  ("Y1:AA8" 8)                      ; dark gray
  ("AB1:AD8" 9)                     ; light blue
  ("AE1:AG8" 10)                    ; light green
  ("AH1:AJ8" 11)                    ; light cyan
  ("AK1:AM8" 12)                    ; light red
  ("AN1:AP8" 13)                    ; light magenta
  ("AQ1:AS8" 14)                    ; yellow
  ("AT1:AV8" 15))                   ; white
; Then, AW to BD, numbers that are no color: three bytes past the palette, which the
; plane carries as themselves and the host paints magenta, and five that are no byte at
; all, which the plane carries as 255.
(cells "Screen"                     ; the sheet every entry below writes
  ("AW1:AW8" 16)                    ; the first byte past the palette
  ("AX1:AX8" 100)                   ; a byte past it
  ("AY1:AY8" 254)                   ; the last byte past it
  ("AZ1:AZ8" 255)                   ; no byte: the plane's own mark for one
  ("BA1:BA8" 256)                   ; no byte: past the last
  ("BB1:BB8" -1)                    ; no byte: below the first
  ("BC1:BC8" 0.5)                   ; no byte: not a whole number
  ("BD1:BD8" 1e300))                ; no byte: far past the last

; Rows 10 and 11: one value of each other kind a cell can hold, each two cells wide. A
; text, a text that spells a number, the empty text, the two truth values and the seven
; error values are 255; a number one unit in the last place from a color is 255, and so
; is 1e-300; -0 and a whole number written as 7.0 are colors.
(cells "Screen"                     ; the sheet every entry below writes
  ("A10:B11" "x")                   ; a text
  ("C10:D11" "7")                   ; a text that spells a number
  ("E10:F11" "")                    ; the empty text
  ("G10:H11" true)                  ; a truth value
  ("I10:J11" false)                 ; the other
  ("K10:L11" (error "#NULL!"))      ; the seven error values, in ERROR.TYPE's order
  ("M10:N11" (error "#DIV/0!"))
  ("O10:P11" (error "#VALUE!"))
  ("Q10:R11" (error "#REF!"))
  ("S10:T11" (error "#NAME?"))
  ("U10:V11" (error "#NUM!"))
  ("W10:X11" (error "#N/A"))
  ("Y10:Z11" 3.0000000000000004)    ; one unit in the last place from 3
  ("AA10:AB11" 1e-300)              ; nearly 0, and no color
  ("AC10:AD11" -0)                  ; negative zero, color 0
  ("AE10:AF11" 7.0)                 ; a whole number written with a point, color 7
  ("AG10:AH11" 14))                 ; a whole number, color 14

; Rows 13 to 16: formulas, each computing one kind, two cells wide.
(on "Screen"                                                      ; the sheet every row below writes
  (rule "A13:B16" (mod Clock!$B$1 16))                            ; a color that cycles with the frame
  (rule "C13:D16" (* Clock!$B$1 16))                              ; a byte that passes 255 at frame 16
  (rule "E13:F16" (/ Clock!$B$1 2))                               ; a fraction every other frame
  (rule "G13:H16" (* 0.1 3 10))                                   ; a sum one unit in the last place from 3
  (rule "I13:J16" (/ 1 0))                                        ; an error
  (rule "K13:L16" "x")                                            ; a text
  (rule "M13:N16" (= 1 1))                                        ; a truth value
  (rule "O13:P16" (sin Clock!$B$1))                               ; a sine
  (rule "Q13:R16" (- Clock!$B$1))                                 ; a negative
  (rule "S13:T16" (int (/ Clock!$B$1 2)))                         ; a whole number
  (rule "U13:V16" (choose (+ 1 (mod Clock!$B$1 3)) 2 "x" true))   ; a value whose kind cycles
  (rule "W13:X16" $A$24)                                          ; a reference to an empty cell, which is 0
  (count                                                          ; a counter read through its own twin:
    "Y13:Z16"                                                     ;   the cells it fills
    1)                                                            ;   the event, one more a frame
  (rule "AA13:AB16" (if (= (mod Clock!$B$1 2) 0) 9 0.5)))        ; a cell that is 9 and 0.5 by turns

; Rows 18 to 22: a stripe that moves, one formula filled over the Screen's whole width, so
; a person sees the frames go by under the pan.
(rule "Screen" "A18:BD22"
  (if (= (mod (+ (column) (row) Clock!$B$1) 8) 0) 15             ; a stripe down the diagonal,
      (if (= (mod (+ (- (column) (row)) Clock!$B$1) 8) 0) 12 0))) ; and a fainter one across it
