(cell "Palette" "A4" 3)
(cell "Palette" "B4" "#3060E0")
(cell "Palette" "C4" "water")
(cell "Palette" "A5" 4)
(cell "Palette" "B5" "#0000AA")
(cell "Palette" "C5" "blue")
(cell "Palette" "A6" 5)
(cell "Palette" "B6" "#00AA00")
(cell "Palette" "C6" "green")
(cell "Palette" "A7" 6)
(cell "Palette" "B7" "#00AAAA")
