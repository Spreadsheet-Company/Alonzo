(cartridge "sand"
  (spec 3)
  (title "Sand")
  (rate 60)
  (screen plane 320 200)
  (seed 1)
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "A falling-sand toy. Paint with the left button, erase with the right, and turn the wheel to size the brush; press 1 for sand, 3 for water, 2 for wall and 0 for empty. The floor shows what the left button paints. It opens raining sand and water from its top third, Life's first frame as grains."))
(sheet "Screen" visible)
(sheet "Stay" visible)
(sheet "Side" visible)
(sheet "Parity" visible)
(sheet "Brush" visible)
(sheet "Gate" visible)
(sheet "State" visible)
(sheet "Tally" visible)
(sheet "Palette" visible)
(cell "Palette" "A1" 0)
(cell "Palette" "B1" "#000000")
(cell "Palette" "C1" "empty")
(cell "Palette" "A2" 1)
(cell "Palette" "B2" "#808080")
(cell "Palette" "C2" "wall")
(cell "Palette" "A3" 2)
(cell "Palette" "B3" "#E8C872")
