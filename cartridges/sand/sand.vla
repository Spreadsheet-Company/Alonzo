(cell "Palette" "A8" 7)
(cell "Palette" "B8" "#AA0000")
(cell "Palette" "C8" "red")
(cell "Palette" "A9" 8)
(cell "Palette" "B9" "#AA00AA")
(cell "Palette" "C9" "magenta")
(cell "Palette" "A10" 9)
(cell "Palette" "B10" "#AA5500")
(cell "Palette" "C10" "brown")
(cell "Palette" "A11" 10)
(cell "Palette" "B11" "#AAAAAA")
(cell "Palette" "C11" "light gray")
(cell "Palette" "A12" 11)
(cell "Palette" "B12" "#5555FF")
(cell "Palette" "C12" "light blue")
(cell "Palette" "A13" 12)
(cell "Palette" "B13" "#55FF55")
(cell "Palette" "C13" "light green")
(cell "Palette" "A14" 13)
(cell "Palette" "B14" "#FF5555")
(cell "Palette" "C14" "light red")
(cell "Palette" "A15" 14)
(cell "Palette" "B15" "#FFFF55")
(cell "Palette" "C15" "yellow")
(cell "Palette" "A16" 15)
(cell "Palette" "B16" "#FFFFFF")
(cell "Palette" "C16" "white")
(cell "Screen" "A1:B200" 1)
(cell "Screen" "LG1:LH200" 1)
(cell "Stay" "A1:B200" 1)
(cell "Stay" "LG1:LH200" 1)
(cell "Stay" "C200:LF200" 1)
(cell "Side" "A1:B200" 1)
(cell "Side" "LG1:LH200" 1)
(cell "Side" "C200:LF200" 1)
(formula "Parity" "A1:A200" "=MOD(ROW(),2)")
(cell "Brush" "A1" "column")
(cell "Brush" "A2" "row")
(cell "Brush" "A3" "radius")
(cell "Brush" "A4" "material")
(formula "Brush" "B1" "=IF(AND(Input!B13+Input!B14>0,Input!B11>0,Input!B12>0),Input!B11,-999)")
(formula "Brush" "B2" "=IF(AND(Input!B13+Input!B14>0,Input!B11>0,Input!B12>0),Input!B12,-999)")
(formula "Brush" "B3" "=IF(Clock!B1<=1,3,MAX(1,MIN(8,Brush.last!B3-Input!B16)))")
(formula "Brush" "B4" "=IF(Input!B14=1,0,State!B1)")
(formula "Gate" "A2:A199" "=IF((ROW()-Brush!$B$2)^2<=Brush!$B$3^2,Brush!$B$1,-999)")
(formula "Gate" "B2:B199" "=IF((ROW()-Brush!$B$2)^2<=Brush!$B$3^2,Brush!$B$3^2-(ROW()-Brush!$B$2)^2,-1)")
(formula "Gate" "C2:C199" "=IF((ROW()-Brush!$B$2)^2<=Brush!$B$3^2,Brush!$B$4,-1)")
(cell "State" "A1" "material")
(formula "State" "B1" "=IF(Clock!$B$1<=1,2,IF(Input!$B$17=\"1\",2,IF(Input!$B$17=\"2\",1,IF(Input!$B$17=\"3\",3,IF(Input!$B$17=\"0\",0,State.last!$B$1)))))")
(formula "Stay" "C2:LF199" "=IF(IF(Gate!$B2<0,FALSE,(COLUMN()-Gate!$A2)^2<=Gate!$B2),IF(Gate!$C2<>0,IF(Screen.last!C2=3,2,1),0),IF(Screen.last!C2=1,1,IF(AND(Screen.last!C2>=2,Side!C3=1),IF(Parity.last!$A2=0,IF(OR(AND(Side!D3=0,Screen.last!D2<2),AND(Side!B3=0,Screen.last!B2<2,OR(Screen.last!A2<2,Side!A3=0))),0,IF(Screen.last!C2=3,2,1)),IF(OR(AND(Side!B3=0,Screen.last!B2<2),AND(Side!D3=0,Screen.last!D2<2,OR(Screen.last!E2<2,Side!E3=0))),0,IF(Screen.last!C2=3,2,1))),0)))")
(formula "Side" "C2:LF199" "=IF(IF(Gate!$B2<0,FALSE,(COLUMN()-Gate!$A2)^2<=Gate!$B2),IF(Gate!$C2<>0,1,0),IF(Stay!C2=2,IF(IF(Parity.last!$A2=0,OR(Stay!D2=0,AND(Stay!B2=0,Stay!A2<>2)),OR(Stay!B2=0,AND(Stay!D2=0,Stay!E2<>2))),0,1),IF(Stay!C2=1,1,IF(IF(Parity.last!$A2=0,OR(Stay!B2=2,AND(Stay!D2=2,Stay!E2>0)),OR(Stay!D2=2,AND(Stay!B2=2,Stay!A2>0))),1,0))))")
(formula "Screen" "C2:LF199" "=IF(Clock!$B$1=1,IF(ROW()>67,0,IF(MOD(MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859)*MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859),67108859)<12582911,2,IF(MOD(MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859)*MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859),67108859)<25165822,3,0))),IF(IF(Gate!$B2<0,FALSE,(COLUMN()-Gate!$A2)^2<=Gate!$B2),Gate!$C2,IF(Side!C2=1,IF(Stay!C2>0,Screen.last!C2,3),IF(Screen.last!C1>=2,Screen.last!C1,IF(Parity.last!$A1=0,IF(AND(Screen.last!B1>=2,Side!B2=1),Screen.last!B1,IF(AND(Screen.last!D1>=2,Side!D2=1,OR(Side!E2=1,Screen.last!E1>=2)),Screen.last!D1,0)),IF(AND(Screen.last!D1>=2,Side!D2=1),Screen.last!D1,IF(AND(Screen.last!B1>=2,Side!B2=1,OR(Side!A2=1,Screen.last!A1>=2)),Screen.last!B1,0)))))))")
(formula "Screen" "C200:LF200" "=State!$B$1")
(cell "Tally" "A1" "codes")
(cell "Tally" "B1" "occupied")
(formula "Tally" "A2:A199" "=SUM(Screen.last!C2:LF2)")
(formula "Tally" "B2:B199" "=SUM(Side.last!C2:LF2)")
