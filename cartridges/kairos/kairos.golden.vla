(window "Tally" "A1:D23")
(extent "Tally" "A1:D23")
(gridlines "Tally" on)
(format 0 none general nowrap)
(cell "Tally" "A1" "level")
(cell "Tally" "B1" "reached")
(cell "Tally" "C1" "stacked")
(cell "Tally" "D1" "fell")
(cell "Tally" "A2" 1)
(formula "Tally" "B2" "=Tally.last!B2+IF(AND(OR(State!$B$11=1,State!$B$14=1),State!$B$3=$A2),1,0)")
(value "Tally" "B2" 2)
(formula "Tally" "C2" "=Tally.last!C2+IF(AND(State!$B$13=1,State!$B$17>0,State.last!$B$3=$A2),1,0)")
(value "Tally" "C2" 2)
(formula "Tally" "D2" "=Tally.last!D2+IF(AND(State!$B$12=1,State!$B$3=$A2),State!$B$4-State!$B$17,0)")
(value "Tally" "D2" 0)
