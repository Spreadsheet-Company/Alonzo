(formula "Tally" "B18" "=Tally.last!B18+State!B11")
(formula "Tally" "B19" "=Tally.last!B19+State!B9")
(formula "Tally" "B20" "=Tally.last!B20+State!B15")
(formula "Tally" "B21" "=Tally.last!B21+IF(AND(State!B25=2,State.last!B25<>2),1,0)")
(formula "Tally" "B22" "=Tally.last!B22+IF(AND(State!B25=3,State.last!B25<>3),1,0)")
(formula "Tally" "B23" "=Tally.last!B23+IF(AND(State!B25=1,State.last!B25<>1),1,0)")
