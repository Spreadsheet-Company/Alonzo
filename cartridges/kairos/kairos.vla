(formula "Screen" "A1:O7" "=IF(State!$B$28=1,Win!A1,IF(State!$B$28=2,0,IF(AND(ROW()>=Gate!A$4,ROW()<=Gate!A$5),Gate!A$6,IF(AND(ROW()>=Gate!A$1,ROW()<=Gate!A$2),Gate!A$3,IF(Tower!A1>0,Tower!A1,Gate!A$7)))))+IF(MOD(ROW()+COLUMN(),2)=1,8,0)")
(formula "Screen" "A8:O8" "=IF(COLUMN()=Levels!$K$1,\"minor\",IF(COLUMN()=Levels!$K$2,\"major\",\"\"))")
(formula "Screen" "A9" "=State!B31")
(cell "Write" "A2" "Tower")
(formula "Write" "B2" "=IF(AND(State!B12=1,State!B17>0),State!B30&State!B23&\":\"&State!B30&State!B24,\"\")")
(formula "Write" "C2" "=1")
(cell "Write" "A3" "Tower")
(formula "Write" "B3" "=IF(AND(State!B1=4,State!B2=Levels!$K$4),\"A1:O7\",\"\")")
(formula "Write" "C3" "=0")
