(cartridge "kairos"
  (spec 3)
  (title "Kairos")
  (rate 60)
  (screen plane 15 7)
  (seed 1)
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "Kairos: stop each row of lights over the row beneath with Z, Space or a click. Lights not over a light fall; a complete miss ends the game. At level 11, X takes the minor prize and Z goes on; level 15 wins the major. The Levels sheet holds every level's speed and window in the open."))
(sheet "Screen" visible)
(sheet "Levels" visible)
(sheet "State" visible)
(sheet "Tally" visible)
(sheet "Gate" visible)
(sheet "Tower" visible)
(sheet "Win" visible)
(sheet "Audio" visible)
(sheet "Keys" visible)
(sheet "Camera" visible)
(sheet "Write" visible)
(sheet "Palette" visible)
