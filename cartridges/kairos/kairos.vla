(formula "State" "B1" "=IF(OR(State!B11=1,State!B14=1),1,IF(State!B12=1,2,IF(AND(State!B13=1,State!B17>0,State.last!B3=Levels!$K$1),3,IF(OR(AND(State!B13=1,State!B17=0),AND(State!B13=1,State.last!B3=Levels!$K$2),AND(State.last!B1=3,State!B10=1)),4,State.last!B1))))")
(formula "State" "B2" "=IF(State!B1<>State.last!B1,0,State.last!B2+1)")
(formula "State" "B3" "=IF(OR(State!B11=1,State!B14=1),IF(State!B11=1,1,State.last!B3+1),State.last!B3)")
(formula "State" "B4" "=IF(OR(State!B11=1,State!B14=1),MIN(State!B17,State!B19),State.last!B4)")
(formula "State" "B5" "=IF(OR(State!B11=1,State!B14=1,State!B15=1),IF(State!B15=1,State.last!B5+State!B16,1),State.last!B5)")
(formula "State" "B6" "=IF(OR(State!B11=1,State!B14=1,State!B15=1),IF(State!B15=1,State!B16,1),State.last!B6)")
(formula "State" "B7" "=IF(MOD(State!B2,State!B18)=0,1,0)")
(formula "State" "B8" "=MAX(Input!B5,Input!B10,Input!B13)")
(formula "State" "B9" "=IF(AND(State!B8=1,State.last!B8=0),1,0)")
(formula "State" "B10" "=IF(AND(Input!B6=1,Input.last!B6=0),1,0)")
(formula "State" "B11" "=IF(Clock!$B$1=1,1,IF(AND(State.last!B1=4,State.last!B29=1,State!B9=1),1,0))")
(formula "State" "B12" "=IF(AND(State.last!B1=1,State!B9=1),1,0)")
(formula "State" "B13" "=IF(AND(State.last!B1=2,State.last!B2>=Levels!$K$3-1),1,0)")
(formula "State" "B14" "=IF(OR(AND(State!B13=1,State!B17>0,State.last!B3<>Levels!$K$1,State.last!B3<>Levels!$K$2),AND(State.last!B1=3,State!B9=1,State!B10=0)),1,0)")
(formula "State" "B15" "=IF(AND(State.last!B1=1,State!B1=1,State!B7=1,State!B2>0),1,0)")
(formula "State" "B16" "=IF(OR(AND(State.last!B6=1,State.last!B5+State.last!B4>7),AND(State.last!B6=-1,State.last!B5<2)),-State.last!B6,State.last!B6)")
(formula "State" "B17" "=MAX(0,State!B24-State!B23+1)")
(formula "State" "B18" "=SUM(Levels!F2:F16)")
(formula "State" "B19" "=SUM(Levels!G2:G16)")
(formula "State" "B20" "=SUM(Levels!H2:H16)")
(formula "State" "B21" "=IF(MOD(State.last!B2,State.last!B18)<State.last!B20,1,0)")
(formula "State" "B22" "=IF(State!B12=1,IF(State!B21=1,State.last!B5,State.last!B5+State!B16),State.last!B22)")
(formula "State" "B23" "=IF(OR(State!B11=1,State!B12=1),IF(State!B11=1,1,MAX(State!B22,State.last!B23)),State.last!B23)")
(formula "State" "B24" "=IF(OR(State!B11=1,State!B12=1),IF(State!B11=1,7,MIN(State!B22+State.last!B4-1,State.last!B24)),State.last!B24)")
(formula "State" "B25" "=IF(OR(State!B11=1,AND(State!B1=4,State.last!B1<>4)),IF(State!B11=1,0,IF(State.last!B1=3,2,IF(State!B17=0,1,3))),State.last!B25)")
(formula "State" "B26" "=State.last!B26+State!B11")
(formula "State" "B27" "=IF(MOD(State!B2,8)<4,1,0)")
(formula "State" "B28" "=IF(AND(State!B1=4,State!B25=3),IF(MOD(State!B2,30)<15,1,2),0)")
(formula "State" "B29" "=IF(AND(State!B1=4,State!B2>=Levels!$K$4),1,0)")
(formula "State" "B30" "=CHOOSE(State!B3,\"A\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\",\"H\",\"I\",\"J\",\"K\",\"L\",\"M\",\"N\",\"O\")")
(formula "State" "B31" "=IF(State!B1=3,\"Level \"&State!B3&\" stacked: the minor prize. Z goes on for the major; X takes the minor.\",IF(State!B1=4,IF(State!B25=3,\"Fifteen rows: the major prize!\",IF(State!B25=2,\"The minor prize, taken.\",\"The stack fell.\"))&IF(State!B29=1,\" Z, Space or a click plays again.\",\"\"),\"Level \"&State!B3&\": stop the row with Z, Space or a click.\"))")
(cell "Write" "A1" "sheet")
(cell "Write" "B1" "address")
(cell "Write" "C1" "value")
(formula "Gate" "A1:O1" "=IF(AND(COLUMN()=State!$B$3,OR(State!$B$1=1,State!$B$1=2,AND(State!$B$1=4,State!$B$25=1,State!$B$29=0))),IF(State!$B$1=1,State!$B$5,State!$B$22),99)")
(formula "Gate" "A2:O2" "=IF(A1=99,0,A1+State!$B$4-1)")
(formula "Gate" "A3:O3" "=IF(A1=99,0,IF(State!$B$1=1,2,IF(State!$B$27=1,3,0)))")
(formula "Gate" "A4:O4" "=IF(AND(COLUMN()=State!$B$3,State!$B$1=2,State!$B$17>0),State!$B$23,99)")
(formula "Gate" "A5:O5" "=IF(A4=99,0,State!$B$24)")
(formula "Gate" "A7:O7" "=IF(COLUMN()=Levels!$K$1,IF(AND(State!$B$1=3,State!$B$27=1),5,6),IF(COLUMN()=Levels!$K$2,7,0))")
(cell "Gate" "A6:O6" 1)
(cell "Tower" "A1:O7" 0)
