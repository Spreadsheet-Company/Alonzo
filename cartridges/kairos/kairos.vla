(formula "Audio" "C2" "=72+State!B3")
(formula "Audio" "D2" "=IF(State!B15=1,0.3,0)")
(formula "Audio" "C3" "=60+2*State!B3")
(formula "Audio" "D3" "=IF(AND(State!B1=2,State!B2<8,State!B17>0),0.6,0)")
(formula "Audio" "C4" "=IF(State!B1=4,55-State!B2/2,55)")
(formula "Audio" "D4" "=IF(OR(AND(State!B1=2,State!B17=0,State!B2<8),AND(State!B1=4,State!B25=1,State!B2<40)),0.5,0)")
(formula "Audio" "C5" "=CHOOSE(1+MOD(INT(State!B2/8),4),72,76,79,84)")
(formula "Audio" "D5" "=IF(OR(AND(State!B1=4,State!B25=3,State!B2<64),AND(State!B1=3,State!B2<16)),0.5,0)")
