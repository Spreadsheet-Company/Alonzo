(cell "Palette" "B1" "#1C1828")
(cell "Palette" "C1" "night: no light")
(format 1 "1C1828" general nowrap)
(look "Screen" 0 1)
(cell "Palette" "A2" 1)
(cell "Palette" "B2" "#A080E0")
(cell "Palette" "C2" "Lovelace Lavender: a light that stayed")
(format 2 "A080E0" general nowrap)
(look "Screen" 1 2)
(cell "Palette" "A3" 2)
(cell "Palette" "B3" "#E2D8F6")
(cell "Palette" "C3" "lavender: the row sliding")
(format 3 "E2D8F6" general nowrap)
(look "Screen" 2 3)
(cell "Palette" "A4" 3)
(cell "Palette" "B4" "#6B4FC8")
(cell "Palette" "C4" "deep lavender: a light falling")
(format 4 "6B4FC8" general nowrap)
(look "Screen" 3 4)
(cell "Palette" "A5" 4)
(cell "Palette" "B5" "#F7F4FC")
(cell "Palette" "C5" "lavender whisper: WIN")
(format 5 "F7F4FC" general nowrap)
(look "Screen" 4 5)
(cell "Palette" "A6" 5)
(cell "Palette" "B6" "#C4B0F0")
(cell "Palette" "C6" "the minor prize, offered")
(format 6 "C4B0F0" general nowrap)
(look "Screen" 5 6)
(cell "Palette" "A7" 6)
(cell "Palette" "B7" "#2E2645")
(cell "Palette" "C7" "the minor prize's level")
(format 7 "2E2645" general nowrap)
(look "Screen" 6 7)
(cell "Palette" "A8" 7)
(cell "Palette" "B8" "#3B3159")
(cell "Palette" "C8" "the major prize's level")
(format 8 "3B3159" general nowrap)
(look "Screen" 7 8)
(cell "Palette" "A9" 8)
(cell "Palette" "B9" "#231E31")
(cell "Palette" "C9" "night, its twin")
(format 9 "231E31" general nowrap)
(look "Screen" 8 9)
(cell "Palette" "A10" 9)
(cell "Palette" "B10" "#9073CA")
(cell "Palette" "C10" "Lovelace Lavender, its twin")
(format 10 "9073CA" general nowrap)
(look "Screen" 9 10)
(cell "Palette" "A11" 10)
(cell "Palette" "B11" "#D0C7E2")
(cell "Palette" "C11" "lavender, its twin")
(format 11 "D0C7E2" general nowrap)
(look "Screen" 10 11)
(cell "Palette" "A12" 11)
(cell "Palette" "B12" "#5E46B0")
(cell "Palette" "C12" "deep lavender, its twin")
(format 12 "5E46B0" general nowrap)
(look "Screen" 11 12)
(cell "Palette" "A13" 12)
(cell "Palette" "B13" "#E9E2F7")
(cell "Palette" "C13" "lavender whisper, its twin")
