(formula "Tally" "C2:C16" "=Tally.last!C2+IF(AND(State!$B$13=1,State!$B$17>0,State.last!$B$3=$A2),1,0)")
(formula "Tally" "D2:D16" "=Tally.last!D2+IF(AND(State!$B$12=1,State!$B$3=$A2),State!$B$4-State!$B$17,0)")
