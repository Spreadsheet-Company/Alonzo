(formula "Lab" "P25" "=\"|\"&TEXTJOIN(\"|\",TRUE,\"A\"&SEQUENCE(19,1,3),MID(\"CDEFGHIJ\",SEQUENCE(1,8),1)&SEQUENCE(19,1,3),\"0\",\"1\")&\"|\"")
(sheet "Camera" hidden)
(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(cell "Camera" "B2" 1)
(cell "Camera" "A3" "sheet")
(formula "Camera" "B3" "=Lab!B3")
(sheet "Write" hidden)
(cell "Write" "A1" "sheet")
(cell "Write" "B1" "address")
(cell "Write" "C1" "value")
(formula "Write" "A2" "=IF(Lab!$H$1=1,Input!$B$19,\"\")")
(formula "Write" "B2" "=IF(Lab!$H$1=1,MID(\"CDEFGHIJ\",Input!$B$11-2,1)&Input!$B$12,\"\")")
(formula "Write" "C2" "=IF(Input!$B$20=\"one\",1,0)")
(sheet "Commands" hidden)
(cell "Commands" "A1" "name")
(cell "Commands" "B1" "words")
(cell "Commands" "C1" "holds")
(cell "Commands" "D1" "key")
(cell "Commands" "A2" "test")
(cell "Commands" "B2" "test the level shown: every input, an input a frame, stopping at the first that fails")
(cell "Commands" "D2" "KeyT")
(cell "Commands" "A3" "next")
(cell "Commands" "B3" "show the next level")
(cell "Commands" "D3" "KeyN")
(cell "Commands" "A4" "previous")
(cell "Commands" "B4" "show the previous level")
(cell "Commands" "D4" "KeyP")
(cell "Commands" "A5" "reset")
(cell "Commands" "B5" "set the level's switches to 0, and forget its test")
(cell "Commands" "D5" "KeyR")
(cell "Commands" "A6" "toggle")
(cell "Commands" "B6" "toggle the switch the selection stands on")
(cell "Commands" "D6" "Space")
(cell "Commands" "A7" "one")
(cell "Commands" "B7" "set the switch the selection stands on to 1, or write 1 on a cell of the room with no gate")
(cell "Commands" "D7" "Digit1")
(cell "Commands" "A8" "zero")
(cell "Commands" "B8" "set the switch the selection stands on to 0, or write 0 on a cell of the room with no gate")
(cell "Commands" "D8" "Digit0")
(cell "Commands" "A9" "tick")
(cell "Commands" "B9" "tick the clock of the level shown once: each flip-flop takes its next state")
(cell "Commands" "D9" "KeyC")
(cell "Commands" "A10" "run")
(cell "Commands" "B10" "clear the level's flip-flops and run its clock until they stand still")
(cell "Commands" "D10" "KeyG")
(sheet "Bench" visible)
(format 1 "E2D8F6" general nowrap)
(look "Bench" 1 1)
(column "Bench" "A" 4 shown none)
(column "Bench" "B" 4 shown none)
