(cell "Bench" "A1" "a")
(cell "Bench" "B1" "b")
(cell "Bench" "C1" "AUT")
(cell "Bench" "D1" "ET")
(cell "Bench" "E1" "ET")
(cell "Bench" "F1" "VEL")
(cell "Bench" "G1" "AUT")
(cell "Bench" "J1" "a")
(cell "Bench" "S1" "AUT")
(cell "Bench" "AB1" "ET")
(cell "Bench" "AK1" "ET")
(cell "Bench" "AT1" "VEL")
(cell "Bench" "BC1" "AUT")
(cell "Bench" "I3" "b")
(cell "Bench" "J3" "ET")
(cell "Bench" "F2" 0)
(cell "Bench" "J2:Q2" 0)
(cell "Bench" "A3:B18" 0)
(cell "Bench" "I4:I11" 0)
(formula "Bench" "C3:C18" "=MOD(A3+B3,2)")
(formula "Bench" "D3:D18" "=A3*B3")
(formula "Bench" "E3:E18" "=C3*F2")
(formula "Bench" "F3:F18" "=MAX(D3,E3)")
(formula "Bench" "G3:G18" "=MOD(C3+F2,2)")
(formula "Bench" "J4:Q11" "=J$2*$I4")
(formula "Bench" "S5:Y5" "=MOD(J5+K4,2)")
(formula "Bench" "AB5:AH5" "=J5*K4")
(formula "Bench" "S6:X6" "=MOD(J6+T5,2)")
(formula "Bench" "Y6:Y11" "=MOD(P6+Q5,2)")
(formula "Bench" "AB6:AG6" "=J6*T5")
(formula "Bench" "AH6:AH11" "=P6*Q5")
(formula "Bench" "AK6:AQ6" "=S6*AB5")
(formula "Bench" "AT6:AZ11" "=MAX(AB6,AK6)")
(formula "Bench" "BC6:BI6" "=MOD(S6+AB5,2)")
(formula "Bench" "S7:X11" "=MOD(J7+BD6,2)")
(formula "Bench" "AB7:AG11" "=J7*BD6")
(formula "Bench" "AK7:AQ11" "=S7*AT6")
(formula "Bench" "BC7:BI11" "=MOD(S7+AT6,2)")
(formula "Bench" "S12:X12" "=MOD(BD11+AT11,2)")
(formula "Bench" "Y12" "=MOD(Q11+AZ11,2)")
(formula "Bench" "AB12:AG12" "=BD11*AT11")
(formula "Bench" "AH12" "=Q11*AZ11")
(formula "Bench" "AL12" "=T12*AB12")
(formula "Bench" "AM12:AQ12" "=U12*AU12")
(formula "Bench" "AU12:AZ12" "=MAX(AC12,AL12)")
(formula "Bench" "BD12" "=MOD(T12+AB12,2)")
(formula "Bench" "BE12:BI12" "=MOD(U12+AU12,2)")
