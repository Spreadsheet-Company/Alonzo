; SPDX-License-Identifier: 0BSD
; Expanded by the pass from naught.source.vla: edit that file, then expand it again.
(cartridge "naught"
  (spec 6)
  (title "Naught: Vel et Aut")
  (rate 0)
  (screen grid 80 50)
  (seed 1)
  (settle 65536)
  (bound "Lesson" "I NON" "II ET" "III VEL" "IV AUT" "V ELIGE" "VI DISTRIBUE" "VII SEMIS" "VIII SUMMA" "IX QUATTUOR" "Bench")
  (read "Lesson")
  (work "Bench")
  (game "I NON" "II ET" "III VEL" "IV AUT" "V ELIGE" "VI DISTRIBUE" "VII SEMIS" "VIII SUMMA" "IX QUATTUOR")
  (author "Spreadsheet Company")
  (license "0BSD")
  (notes "Naught: Vel et Aut, a bench of logic gates in Latin: NON, ET, VEL, AUT, NON-ET and NEC. A 16-bit ripple adder from A1 and an 8 by 8 multiplier from I1, every gate a formula of the cells it reads, every 1 in lavender. Select a switch and type 1 or 0, then Enter, (cell \"Bench\" \"A3\" 1), and every gate it reaches computes; the Lesson says the rest."))
(sheet "Lesson" visible)
(column "Lesson" "A" 140 shown none)
(cell "Lesson" "A1" "Naught: Vel et Aut")
(cell "Lesson" "A2" "Logic gates in Latin, and nine levels that build them from one: NON, ET, VEL and AUT, a choice, a send, two sums and four bits.")
(cell "Lesson" "A3" "The levels are the sheets after this one: a tab, or Ctrl+Alt+PageDown (Ctrl+PageDown in full screen), and Ctrl+Alt+PageUp back.")
(cell "Lesson" "A5" "On a level, Space toggles the switch the selection stands on, 1 and 0 set it, a click toggles it. A lamp is lit where its output is 1.")
(cell "Lesson" "A6" "Write the gates in the room, C to I, and the outputs in J: type = on a cell, and the palette opens its formula. Enter writes it.")
(cell "Lesson" "A7" "Enter on a cell opens its formula as it stands, F2 too, and Escape leaves it. Delete empties a cell; Tab moves right.")
(cell "Lesson" "A8" "T tests every input, an input a frame, and stops at the first a lamp gets wrong, the board standing on it. R sets the switches to 0.")
(cell "Lesson" "A9" "N and P show the next and the previous level. A pass is a star; within the budget, two; at the least known, three.")
(cell "Lesson" "A11" "The gates, in Latin: NON, not, =1-a. ET, and, =a*b. VEL, or, =MAX(a,b). AUT, either but not both, =MOD(a+b,2).")
(cell "Lesson" "A12" "NON-ET, not both, =1-a*b, Sheffer's stroke. NEC, neither, =1-MAX(a,b), Peirce's arrow. Either alone builds every other gate.")
(cell "Lesson" "A13" "Level I gives NON-ET alone; each level after, the gates proven before it. Nothing checks which you write: the words and the stars say.")
(cell "Lesson" "A15" "After the levels, the Bench, a sandbox where every key types: a 16-bit adder from A1 and an 8 by 8 multiplier from I1.")
(cell "Lesson" "A16" "The adder: a in A3:A18 and b in B3:B18, low bit first, its carry-in F2; its sum G3:G18, its carry out F18.")
(cell "Lesson" "A17" "Each bit adds three: C = AUT(a,b), D = ET(a,b), E = ET(C,carry), F = VEL(D,E) the carry on, G = AUT(C,carry) the sum.")
(cell "Lesson" "A18" "The multiplier: a in J2:Q2 and b in I4:I11, low bit first; its partial products ET(a,b) in J4:Q11, summed in rows.")
(cell "Lesson" "A19" "Its product, low bit first: J4, S5, BC6:BC11, S12, BD12:BI12 and AZ12.")
(cell "Lesson" "A20" "Try it: a all ones, A3:A18, then the carry-in F2 to 1: 65,535 + 1 ripples through all sixteen bits in one act. 255 x 255 = 65,025.")
(cell "Lesson" "A21" "Delete empties a cell, Backspace opens it emptied: an empty text is no number, so the gates it feeds say #VALUE!. Ex nihilo nihil fit.")
(cell "Lesson" "A23" "Tertium non datur: a cell holds 0 or 1, and no third, Delete aside. Latin is said to keep two ors, vel and aut; the Stanford")
(cell "Lesson" "A24" "Encyclopedia of Philosophy called that a myth in 2016: aut has inclusive uses too. Naught keeps both anyway.")
(format 2 "A080E0" general nowrap)
(sheet "I NON" visible)
(column "I NON" "A" 4 shown none)
(column "I NON" "B" 3 shown none)
(column "I NON" "C" 4 shown none)
(column "I NON" "D" 4 shown none)
(column "I NON" "E" 4 shown none)
(column "I NON" "F" 4 shown none)
(column "I NON" "G" 4 shown none)
(column "I NON" "H" 4 shown none)
(column "I NON" "I" 4 shown none)
(column "I NON" "J" 4 shown none)
(column "I NON" "K" 6 shown none)
(column "I NON" "L" 5 shown none)
(column "I NON" "M" 4 shown none)
(column "I NON" "N" 128 shown none)
(look "I NON" 1 1)
(look "I NON" "●" 2)
(cell "I NON" "A1" "I NON: not, from NON-ET alone")
(cell "I NON" "A2" "in")
(cell "I NON" "C2" "the room")
(cell "I NON" "J2" "out")
(cell "I NON" "L2" "lamp")
(cell "I NON" "M2" "due")
(cell "I NON" "B3" "a")
(cell "I NON" "K3" "y")
(formula "I NON" "A3" "=IF(AND(Input!$B$20=\"reset\",Input!$B$19=\"I NON\"),0,IF(Lab!$N$11=1,MOD(INT(Lab!$B$6/CHOOSE(ROW()-2,1,2,4,8,16,32,64,128,256)),2),IF(AND(Input!$B$19=\"I NON\",Input!$B$11=1,Input!$B$12=ROW()),IF(Input!$B$20=\"one\",1,IF(Input!$B$20=\"zero\",0,IF(OR(Input!$B$20=\"toggle\",Input!$B$13=1),1-'I NON.last'!A3,'I NON.last'!A3))),'I NON.last'!A3)))")
(formula "I NON" "L3" "=IF(J3=1,\"●\",\"○\")")
(formula "I NON" "M3" "=Lab!I11")
(cell "I NON" "N1" "NON, not: the lamp lit where a is 0, and dark where a is 1.")
(cell "I NON" "N2" "Given NON-ET alone, not both, =1-x*y. Write y in J3, with any gates before it in the room, C to I.")
(cell "I NON" "N3" "A gate's two inputs may be one cell read twice.")
(cell "I NON" "N4" "NON-ET alone builds every gate: Peirce found it about 1880 and never published it, and Sheffer did, in 1913.")
(cell "I NON" "N5" "Tertium non datur: a lamp is lit or it is dark, and there is no third.")
(cell "I NON" "N6" "Ockham's razor, in words found in none of Ockham's extant works: entities are not to be multiplied beyond necessity.")
(cell "I NON" "N7" "Space toggles the switch the selection stands on, 1 and 0 set it, a click toggles it; T tests, R resets, N and P move.")
(cell "I NON" "N10" "A switch or a lamp written over is lost until Load, which loads every level afresh: R writes values, never a formula.")
(formula "I NON" "N8" "=\"Gates \"&Lab!E11&\"; the budget 2, the least known 1: \"&Lab!H11")
(formula "I NON" "N9" "=IF(Lab!N11=1,\"Calculemus: input \"&(Lab!$B$6+1)&\" of 2\",IF(Lab!B11=1,\"Quod erat demonstrandum: every one of its 2 inputs passes.\",IF(Lab!B11=2,\"The test stops at input \"&(Lab!C11+1)&\" of 2, standing on the board: a lamp differs from its due.\",\"T tests every input, an input a frame. Calculemus!\")))")
