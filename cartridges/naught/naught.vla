(cell "Bench" "F1" 0)
(cell "Bench" "J1:Q1" 0)
(cell "Bench" "A2:B17" 0)
(cell "Bench" "I3:I10" 0)
(formula "Bench" "C2:C17" "=MOD(A2+B2,2)")
(formula "Bench" "D2:D17" "=A2*B2")
(formula "Bench" "E2:E17" "=C2*F1")
(formula "Bench" "F2:F17" "=MAX(D2,E2)")
(formula "Bench" "G2:G17" "=MOD(C2+F1,2)")
(formula "Bench" "J3:Q10" "=J$1*$I3")
(formula "Bench" "S4:Y4" "=MOD(J4+K3,2)")
(formula "Bench" "AB4:AH4" "=J4*K3")
(formula "Bench" "S5:X5" "=MOD(J5+T4,2)")
(formula "Bench" "Y5:Y10" "=MOD(P5+Q4,2)")
(formula "Bench" "AB5:AG5" "=J5*T4")
(formula "Bench" "AH5:AH10" "=P5*Q4")
(formula "Bench" "AK5:AQ5" "=S5*AB4")
(formula "Bench" "AT5:AZ10" "=MAX(AB5,AK5)")
(formula "Bench" "BC5:BI5" "=MOD(S5+AB4,2)")
(formula "Bench" "S6:X10" "=MOD(J6+BD5,2)")
(formula "Bench" "AB6:AG10" "=J6*BD5")
(formula "Bench" "AK6:AQ10" "=S6*AT5")
(formula "Bench" "BC6:BI10" "=MOD(S6+AT5,2)")
(formula "Bench" "S11:X11" "=MOD(BD10+AT10,2)")
(formula "Bench" "Y11" "=MOD(Q10+AZ10,2)")
(formula "Bench" "AB11:AG11" "=BD10*AT10")
(formula "Bench" "AH11" "=Q10*AZ10")
(formula "Bench" "AL11" "=T11*AB11")
(formula "Bench" "AM11:AQ11" "=U11*AU11")
(formula "Bench" "AU11:AZ11" "=MAX(AC11,AL11)")
(formula "Bench" "BD11" "=MOD(T11+AB11,2)")
(formula "Bench" "BE11:BI11" "=MOD(U11+AU11,2)")
