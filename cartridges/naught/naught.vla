(formula "Lab" "H21:H22" "=IF($N$17=1,MOD(INT($B$6/CHOOSE(ROW()-20,1,2,4,8,16,32,64,128,256)),2),'VII SEMIS'!A3)")
(formula "Lab" "I21:I23" "=IF($N$18=1,MOD(INT($B$6/CHOOSE(ROW()-20,1,2,4,8,16,32,64,128,256)),2),'VIII SUMMA'!A3)")
(formula "Lab" "J21:J29" "=IF($N$19=1,MOD(INT($B$6/CHOOSE(ROW()-20,1,2,4,8,16,32,64,128,256)),2),'IX QUATTUOR'!A3)")
(formula "Lab" "I11" "=1-B21")
(formula "Lab" "D11" "=IF('I NON'!J3=I11,1,0)")
(formula "Lab" "I12" "=C21*C22")
(formula "Lab" "D12" "=IF('II ET'!J3=I12,1,0)")
(formula "Lab" "I13" "=MAX(D21,D22)")
(formula "Lab" "D13" "=IF('III VEL'!J3=I13,1,0)")
(formula "Lab" "I14" "=MOD(E21+E22,2)")
(formula "Lab" "D14" "=IF('IV AUT'!J3=I14,1,0)")
(formula "Lab" "I15" "=IF(F23=1,F22,F21)")
(formula "Lab" "D15" "=IF('V ELIGE'!J3=I15,1,0)")
(formula "Lab" "I16" "=G21*(1-G22)")
(formula "Lab" "J16" "=G21*G22")
(formula "Lab" "D16" "=IF(AND('VI DISTRIBUE'!J3=I16,'VI DISTRIBUE'!J4=J16),1,0)")
(formula "Lab" "I17" "=MOD(H21+H22,2)")
(formula "Lab" "J17" "=INT((H21+H22)/2)")
(formula "Lab" "D17" "=IF(AND('VII SEMIS'!J3=I17,'VII SEMIS'!J4=J17),1,0)")
(formula "Lab" "I18" "=MOD(I21+I22+I23,2)")
(formula "Lab" "J18" "=INT((I21+I22+I23)/2)")
(formula "Lab" "D18" "=IF(AND('VIII SUMMA'!J3=I18,'VIII SUMMA'!J4=J18),1,0)")
(formula "Lab" "O19" "=J21+2*J22+4*J23+8*J24+J25+2*J26+4*J27+8*J28+J29")
(formula "Lab" "I19" "=MOD(O19,2)")
(formula "Lab" "J19" "=MOD(INT(O19/2),2)")
(formula "Lab" "K19" "=MOD(INT(O19/4),2)")
(formula "Lab" "L19" "=MOD(INT(O19/8),2)")
(formula "Lab" "M19" "=INT(O19/16)")
(formula "Lab" "D19" "=IF(AND('IX QUATTUOR'!J3=I19,'IX QUATTUOR'!J4=J19,'IX QUATTUOR'!J5=K19,'IX QUATTUOR'!J6=L19,'IX QUATTUOR'!J7=M19),1,0)")
(formula "Lab" "E11" "=SUM(Count!C3:J6)")
(formula "Lab" "E12" "=SUM(Count!C23:J26)")
(formula "Lab" "E13" "=SUM(Count!C43:J46)")
(formula "Lab" "E14" "=SUM(Count!C63:J66)")
(formula "Lab" "E15" "=SUM(Count!C83:J86)")
(formula "Lab" "E16" "=SUM(Count!C103:J106)")
(formula "Lab" "E17" "=SUM(Count!C123:J126)")
(formula "Lab" "E18" "=SUM(Count!C143:J146)")
(formula "Lab" "E19" "=SUM(Count!C163:J171)")
(sheet "Count" hidden)
(formula "Count" "C3:J6" "=IF('I NON'!C3=\"\",0,1)")
(formula "Count" "C23:J26" "=IF('II ET'!C3=\"\",0,1)")
(formula "Count" "C43:J46" "=IF('III VEL'!C3=\"\",0,1)")
(formula "Count" "C63:J66" "=IF('IV AUT'!C3=\"\",0,1)")
(formula "Count" "C83:J86" "=IF('V ELIGE'!C3=\"\",0,1)")
(formula "Count" "C103:J106" "=IF('VI DISTRIBUE'!C3=\"\",0,1)")
(formula "Count" "C123:J126" "=IF('VII SEMIS'!C3=\"\",0,1)")
(formula "Count" "C143:J146" "=IF('VIII SUMMA'!C3=\"\",0,1)")
(formula "Count" "C163:J171" "=IF('IX QUATTUOR'!C3=\"\",0,1)")
(sheet "Camera" hidden)
(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(cell "Camera" "B2" 1)
(cell "Camera" "A3" "sheet")
(formula "Camera" "B3" "=Lab!B3")
(sheet "Commands" hidden)
(cell "Commands" "A1" "name")
(cell "Commands" "B1" "words")
(cell "Commands" "C1" "holds")
(cell "Commands" "D1" "key")
(cell "Commands" "A2" "test")
(cell "Commands" "B2" "test the level shown: every input, an input a frame, stopping at the first that fails")
(cell "Commands" "D2" "KeyT")
(cell "Commands" "A3" "next")
(cell "Commands" "B3" "show the next level")
(cell "Commands" "D3" "KeyN")
(cell "Commands" "A4" "previous")
(cell "Commands" "B4" "show the previous level")
(cell "Commands" "D4" "KeyP")
(cell "Commands" "A5" "reset")
(cell "Commands" "B5" "set the level's switches to 0, and forget its test")
(cell "Commands" "D5" "KeyR")
(cell "Commands" "A6" "toggle")
(cell "Commands" "B6" "toggle the switch the selection stands on")
(cell "Commands" "D6" "Space")
(cell "Commands" "A7" "one")
(cell "Commands" "B7" "set the switch the selection stands on to 1")
(cell "Commands" "D7" "Digit1")
(cell "Commands" "A8" "zero")
(cell "Commands" "B8" "set the switch the selection stands on to 0")
(cell "Commands" "D8" "Digit0")
(sheet "Bench" visible)
(format 1 "E2D8F6" general nowrap)
(look "Bench" 1 1)
(column "Bench" "A" 4 shown none)
