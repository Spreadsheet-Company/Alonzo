(formula "II ET" "A3:A4" "=IF(AND(Input!$B$20=\"reset\",Input!$B$19=\"II ET\"),0,IF(Lab!$N$12=1,MOD(INT(Lab!$B$6/CHOOSE(ROW()-2,1,2,4,8,16,32,64,128,256)),2),IF(AND(Input!$B$19=\"II ET\",Input!$B$11=1,Input!$B$12=ROW()),IF(Input!$B$20=\"one\",1,IF(Input!$B$20=\"zero\",0,IF(OR(Input!$B$20=\"toggle\",Input!$B$13=1),1-'II ET.last'!A3,'II ET.last'!A3))),'II ET.last'!A3)))")
(formula "II ET" "L3" "=IF(J3=1,\"●\",\"○\")")
(formula "II ET" "M3" "=Lab!I12")
(cell "II ET" "N1" "ET, and: the lamp lit where a and b are both 1.")
(cell "II ET" "N2" "Given NON-ET, =1-x*y, and NON, proven at I, =1-x. Write y in J3.")
(cell "II ET" "N3" "De Morgan, 1847: not both is the one not or the other not, NON-ET(a,b) = VEL(NON a, NON b). Turn it around.")
(cell "II ET" "N7" "Space toggles the switch the selection stands on, 1 and 0 set it, a click toggles it; T tests, R resets, N and P move.")
(cell "II ET" "N10" "A switch or a lamp written over is lost until Load, which loads every level afresh: R writes values, never a formula.")
(formula "II ET" "N8" "=\"Gates \"&Lab!E12&\"; the budget 3, the least known 2: \"&Lab!H12")
(formula "II ET" "N9" "=IF(Lab!N12=1,\"Calculemus: input \"&(Lab!$B$6+1)&\" of 4\",IF(Lab!B12=1,\"Quod erat demonstrandum: every one of its 4 inputs passes.\",IF(Lab!B12=2,\"The test stops at input \"&(Lab!C12+1)&\" of 4, standing on the board: a lamp differs from its due.\",\"T tests every input, an input a frame. Calculemus!\")))")
