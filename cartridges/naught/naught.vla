(formula "XV MACHINA" "L3:L14" "=IFERROR(IF(J3=1,\"●\",\"○\"),\"?\")")
(formula "XV MACHINA" "M3:M14" "=Lab!P51")
(cell "XV MACHINA" "N1" "MACHINA, the machine: A3:A9 is the ROM's line at p, op then n. The flip-flops are A, p and B; J3:J6, J7:J10 and J11:J14 their next.")
(cell "XV MACHINA" "N2" "0 LDI, A takes n. 1 ADD, A takes A + n in four bits. 2 SWP, A and B trade. 3 JNZ, p takes n where A is not 0.")
(cell "XV MACHINA" "N3" "Every word but a jump takes p to p + 1, and 15 + 1 is 0. From 4 on, HLT: nothing moves, and the machine stands still.")
(cell "XV MACHINA" "N4" "T: every word at every A, p and B drawn by lot: 2,048 inputs of 524,288. Given every gate proven and ELIGE.")
(cell "XV MACHINA" "N5" "G clears the flip-flops and runs the sheet ROM: its 3 x 5 by repeated addition stands at 15 in A10:A13. Then write your own.")
(cell "XV MACHINA" "N6" "Nec deus intersit, Horace advised (Ars Poetica 191): let no god step in. A machine needs none: it has a clock.")
(cell "XV MACHINA" "N7" "Space toggles the switch the selection stands on, 1 and 0 set it, a click toggles it; in the room 1 and 0 write themselves; T tests, R resets, N and P move.")
(cell "XV MACHINA" "N10" "A switch or a lamp written over is lost until Load, which loads every level afresh: R writes values, never a formula.")
(formula "XV MACHINA" "N8" "=\"Gates \"&Lab!E25&IF(Lab!Q25>0,\", \"&Lab!Q25&\" outside the set given, the first at \"&Lab!R25,\"\")&\"; the budget 60, the least known 46: \"&Lab!H25")
(formula "XV MACHINA" "N9" "=IF(Lab!N25=1,\"Calculemus: input \"&Lab!$B$6+1&\" of 2048\",IF(Lab!B25=2,\"The test stops at input \"&Lab!C25+1&\" of 2048, standing on the board: \"&IF(Lab!S25<>\"\",Lab!S25&\" holds an error: it reads a text, an emptied cell or an error.\",IF(Lab!L25=0,\"a switch written over does not follow the test. Load restores it, and empties every level.\",\"a lamp differs from its due.\")),IF(Lab!S25<>\"\",Lab!S25&\" holds an error: it reads a text, an emptied cell or an error.\"&\" Ex nihilo nihil fit.\",IF(Lab!B25=1,\"Probatum: all 2,048 pass, every word at every A. Testing, said Dijkstra, shows the presence of bugs, never their absence.\",\"T tests every input, an input a frame. Calculemus!\"))))")
(formula "XV MACHINA" "N11" "=IF(Lab!$E$2<>15,\"C ticks the clock once. G clears the flip-flops and runs the clock until they stand still.\",IF(Lab!$E$3=1,\"Currit, it runs: tick \"&Lab!$E$4,IF(Lab!$E$9=1,\"Stat, it stands: its last move at tick \"&Lab!$E$4-1&\".\",IF(Lab!$E$9=2,\"In aeternum: 4096 ticks, no rest. 12 flip-flops hold 4096 states, so one came twice: it never halts. A short tape answers Turing.\",\"C ticks the clock once. G clears the flip-flops and runs the clock until they stand still.\"))))")
(sheet "ROM" visible)
(column "ROM" "A" 5 shown none)
(column "ROM" "B" 14 shown none)
(column "ROM" "C" 5 shown none)
(column "ROM" "D" 3 shown none)
(column "ROM" "E" 18 shown none)
(column "ROM" "F" 5 shown none)
(column "ROM" "G" 110 shown none)
(cell "ROM" "A1" "line")
(cell "ROM" "B1" "the program")
(cell "ROM" "C1" "word")
(cell "ROM" "D1" "p")
(cell "ROM" "E1" "says")
(cell "ROM" "F1" "the words")
(cell "ROM" "F2" "LDI")
(cell "ROM" "F3" "ADD")
(cell "ROM" "F4" "SWP")
(cell "ROM" "F5" "JNZ")
(cell "ROM" "F6" "HLT")
(cell "ROM" "G2" "LDI n: A takes n.")
(cell "ROM" "G3" "ADD n: A takes A + n, in four bits, so ADD 15 takes 1 from it.")
(cell "ROM" "G4" "SWP: A and B trade.")
(cell "ROM" "G5" "JNZ n: the next line is line n where A is not 0.")
(cell "ROM" "G6" "HLT: nothing moves, and the machine stands still. An empty line is HLT, and so is a word none of these.")
(cell "ROM" "G8" "Type a line in B, a word and its number: ADD 5. G on XV MACHINA clears A, B and p and runs from line 0.")
(cell "ROM" "G9" "This one: 3 x 5 by repeated addition, B counting down and A summing. 15 stands in A at its HLT, seventeen ticks on.")
(cell "ROM" "B2" "LDI 3")
(cell "ROM" "B3" "SWP")
(cell "ROM" "B4" "ADD 5")
(cell "ROM" "B5" "SWP")
(cell "ROM" "B6" "ADD 15")
(cell "ROM" "B7" "JNZ 1")
(cell "ROM" "B8" "SWP")
(cell "ROM" "B9" "HLT")
(formula "ROM" "A2:A17" "=ROW()-2")
(formula "ROM" "C2:C17" "=IFERROR(MATCH(UPPER(LEFT(B2,3)),$F$2:$F$6,0)-1,4)+8*IFERROR(MOD(INT(0+MID(B2,5,9)),16),0)")
(formula "ROM" "D2:D17" "=IF(A2=Lab!$E$7,\"◄\",\"\")")
(formula "ROM" "E2:E17" "=IF(OR(B2=\"\",NOT(ISERROR(MATCH(UPPER(LEFT(B2,3)),$F$2:$F$6,0)))),\"\",\"no such word: HLT\")")
