(formula "Lab" "B1" "=(Input!$B$19=\"I NON\")*1+(Input!$B$19=\"II ET\")*2+(Input!$B$19=\"III VEL\")*3+(Input!$B$19=\"IV AUT\")*4+(Input!$B$19=\"V ELIGE\")*5+(Input!$B$19=\"VI DISTRIBUE\")*6+(Input!$B$19=\"VII SEMIS\")*7+(Input!$B$19=\"VIII SUMMA\")*8+(Input!$B$19=\"IX QUATTUOR\")*9")
(formula "Lab" "B2" "=IF(AND(Input!$B$20=\"next\",B1>0),MIN(9,B1+1),IF(AND(Input!$B$20=\"previous\",B1>0),MAX(1,B1-1),MAX(1,Lab.last!B2)))")
(formula "Lab" "B3" "=IF(OR(Input!$B$20=\"next\",Input!$B$20=\"previous\"),CHOOSE(B2,\"I NON\",\"II ET\",\"III VEL\",\"IV AUT\",\"V ELIGE\",\"VI DISTRIBUE\",\"VII SEMIS\",\"VIII SUMMA\",\"IX QUATTUOR\"),\"\")")
(formula "Lab" "B4" "=IF(Input!$B$20=\"test\",B1,Lab.last!B4)")
(formula "Lab" "B5" "=IF(Input!$B$20=\"test\",IF(B1>0,1,0),IF(Input!$B$20=\"reset\",0,IF(Lab.last!B5=1,IF(AND(Lab.last!B8=1,Lab.last!B6<Lab.last!B7-1),1,0),0)))")
(formula "Lab" "B6" "=IF(Input!$B$20=\"test\",0,IF(AND(Lab.last!B5=1,B5=1),Lab.last!B6+1,Lab.last!B6))")
