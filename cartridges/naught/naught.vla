(formula "Lab" "P64" "=P31+2*P32+4*P33")
(formula "Lab" "P65" "=P34+2*P35+4*P36+8*P37")
(formula "Lab" "P66" "=P38+2*P39+4*P40+8*P41")
(formula "Lab" "P67" "=P42+2*P43+4*P44+8*P45")
(formula "Lab" "P68" "=P46+2*P47+4*P48+8*P49")
(formula "Lab" "P69" "=CHOOSE(P64+1,P65,MOD(P66+P65,16),P68,P66,P66,P66,P66,P66)")
(formula "Lab" "P70" "=MOD(P67+1,16)")
(formula "Lab" "P71" "=CHOOSE(P64+1,P70,P70,P70,IF(P66<>0,P65,P70),P67,P67,P67,P67)")
(formula "Lab" "P72" "=IF(P64=2,P66,P68)")
(formula "Lab" "P51:P54" "=MOD(INT($P$69/CHOOSE(ROW()-50,1,2,4,8)),2)")
(formula "Lab" "P55:P58" "=MOD(INT($P$71/CHOOSE(ROW()-54,1,2,4,8)),2)")
(formula "Lab" "P59:P62" "=MOD(INT($P$72/CHOOSE(ROW()-58,1,2,4,8)),2)")
(formula "Lab" "D11" "=IFERROR(IF(AND(K11=1,SUMPRODUCT(--('I NON'!J3<>B51))=0),1,0),0)")
(formula "Lab" "D12" "=IFERROR(IF(AND(K12=1,SUMPRODUCT(--('II ET'!J3<>C51))=0),1,0),0)")
(formula "Lab" "D13" "=IFERROR(IF(AND(K13=1,SUMPRODUCT(--('III VEL'!J3<>D51))=0),1,0),0)")
(formula "Lab" "D14" "=IFERROR(IF(AND(K14=1,SUMPRODUCT(--('IV AUT'!J3<>E51))=0),1,0),0)")
(formula "Lab" "D15" "=IFERROR(IF(AND(K15=1,SUMPRODUCT(--('V ELIGE'!J3<>F51))=0),1,0),0)")
(formula "Lab" "D16" "=IFERROR(IF(AND(K16=1,SUMPRODUCT(--('VI DISTRIBUE'!J3:J4<>G51:G52))=0),1,0),0)")
(formula "Lab" "D17" "=IFERROR(IF(AND(K17=1,SUMPRODUCT(--('VII SEMIS'!J3:J4<>H51:H52))=0),1,0),0)")
(formula "Lab" "D18" "=IFERROR(IF(AND(K18=1,SUMPRODUCT(--('VIII SUMMA'!J3:J4<>I51:I52))=0),1,0),0)")
(formula "Lab" "D19" "=IFERROR(IF(AND(K19=1,SUMPRODUCT(--('IX QUATTUOR'!J3:J7<>J51:J55))=0),1,0),0)")
(formula "Lab" "D20" "=IFERROR(IF(AND(K20=1,SUMPRODUCT(--('X MORA'!J3<>K51))=0),1,0),0)")
(formula "Lab" "D21" "=IFERROR(IF(AND(K21=1,SUMPRODUCT(--('XI TENE'!J3<>L51))=0),1,0),0)")
(formula "Lab" "D22" "=IFERROR(IF(AND(K22=1,SUMPRODUCT(--('XII MEMORIA'!J3:J6<>M51:M54))=0),1,0),0)")
(formula "Lab" "D23" "=IFERROR(IF(AND(K23=1,SUMPRODUCT(--('XIII NUMERA'!J3:J6<>N51:N54))=0),1,0),0)")
(formula "Lab" "D24" "=IFERROR(IF(AND(K24=1,SUMPRODUCT(--('XIV RATIO'!J3:J7<>O51:O55))=0),1,0),0)")
(formula "Lab" "D25" "=IFERROR(IF(AND(K25=1,SUMPRODUCT(--('XV MACHINA'!J3:J14<>P51:P62))=0),1,0),0)")
(sheet "Gates" hidden)
(cell "Gates" "C1" "each room cell's formula, spaces and $ gone and upper-cased")
(cell "Gates" "M1" "its kind: 0 none, 1 a wire, 2 NON-ET, 3 NON, 4 ET, 5 VEL, 6 AUT, 7 ELIGE, 9 outside the set")
(cell "Gates" "A3" "I NON")
(cell "Gates" "A23" "II ET")
(cell "Gates" "A43" "III VEL")
(cell "Gates" "A63" "IV AUT")
(cell "Gates" "A83" "V ELIGE")
(cell "Gates" "A103" "VI DISTRIBUE")
(cell "Gates" "A123" "VII SEMIS")
(cell "Gates" "A143" "VIII SUMMA")
(cell "Gates" "A163" "IX QUATTUOR")
(cell "Gates" "A183" "X MORA")
(cell "Gates" "A203" "XI TENE")
(cell "Gates" "A223" "XII MEMORIA")
(cell "Gates" "A243" "XIII NUMERA")
(cell "Gates" "A263" "XIV RATIO")
(cell "Gates" "A283" "XV MACHINA")
(formula "Gates" "C3:J10" "=IFERROR(UPPER(SUBSTITUTE(SUBSTITUTE(FORMULATEXT('I NON'!C3),\" \",\"\"),\"$\",\"\")),\"\")")
(formula "Gates" "M3:T10" "=IF(C3=\"\",0,IF(NOT(ISERROR(FIND(\"|\"&MID(C3,2,99)&\"|\",Lab!$P$11))),1,IF(AND(LEFT(C3,3)=\"=1-\",IFERROR(AND(NOT(ISERROR(FIND(\"|\"&MID(C3,4,FIND(\"*\",C3)-4)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\"*\",C3)+1,99)&\"|\",Lab!$P$11)))),FALSE)),2,IF(AND(LEFT(C3,3)=\"=1-\",NOT(ISERROR(FIND(\"|\"&MID(C3,4,99)&\"|\",Lab!$P$11)))),3,IF(IFERROR(AND(NOT(ISERROR(FIND(\"|\"&MID(C3,2,FIND(\"*\",C3)-2)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\"*\",C3)+1,99)&\"|\",Lab!$P$11)))),FALSE),4,IF(AND(LEFT(C3,5)=\"=MAX(\",RIGHT(C3,1)=\")\",IFERROR(AND(NOT(ISERROR(FIND(\"|\"&MID(C3,6,FIND(\",\",C3)-6)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\",\",C3)+1,LEN(C3)-FIND(\",\",C3)-1)&\"|\",Lab!$P$11)))),FALSE)),5,IF(AND(LEFT(C3,5)=\"=MOD(\",RIGHT(C3,3)=\",2)\",IFERROR(AND(NOT(ISERROR(FIND(\"|\"&MID(C3,6,FIND(\"+\",C3)-6)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\"+\",C3)+1,LEN(C3)-FIND(\"+\",C3)-3)&\"|\",Lab!$P$11)))),FALSE)),6,IF(AND(LEFT(C3,4)=\"=IF(\",RIGHT(C3,1)=\")\",IFERROR(AND(NOT(ISERROR(FIND(\"|\"&MID(C3,5,FIND(\",\",C3)-5)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\",\",C3)+1,FIND(\",\",C3,FIND(\",\",C3)+1)-FIND(\",\",C3)-1)&\"|\",Lab!$P$11))),NOT(ISERROR(FIND(\"|\"&MID(C3,FIND(\",\",C3,FIND(\",\",C3)+1)+1,LEN(C3)-FIND(\",\",C3,FIND(\",\",C3)+1)-1)&\"|\",Lab!$P$11)))),FALSE)),7,9))))))))")
(cell "Lab" "W11" 10)
(formula "Lab" "E11" "=SUMPRODUCT(--ISFORMULA('I NON'!C3:J10))")
(formula "Lab" "Q11" "=COUNTIF(Gates!M3:T10,\">2\")")
(formula "Lab" "R11" "=IFERROR(MID(\"CDEFGHIJ\",MOD(MATCH(TRUE,TOCOL(Gates!M3:T10)>2,0)-1,8)+1,1)&3+INT((MATCH(TRUE,TOCOL(Gates!M3:T10)>2,0)-1)/8),\"\")")
