(formula "Lab" "B1" "=IFERROR(MATCH(Input!$B$19,$A$11:$A$25,0),0)")
(formula "Lab" "B2" "=IF(AND(Input!$B$20=\"next\",B1>0),MIN(15,B1+1),IF(AND(Input!$B$20=\"previous\",B1>0),MAX(1,B1-1),MAX(1,Lab.last!B2)))")
(formula "Lab" "B3" "=IF(OR(Input!$B$20=\"next\",Input!$B$20=\"previous\"),INDEX($A$11:$A$25,B2),\"\")")
(formula "Lab" "B4" "=IF(Input!$B$20=\"test\",B1,Lab.last!B4)")
(formula "Lab" "B5" "=IF(Input!$B$20=\"test\",IF(B1>0,1,0),IF(Input!$B$20=\"reset\",0,IF(Lab.last!B5=1,IF(AND(Lab.last!B8=1,Lab.last!B6<Lab.last!B7-1),1,0),0)))")
(formula "Lab" "B6" "=IF(Input!$B$20=\"test\",0,IF(AND(Lab.last!B5=1,B5=1),Lab.last!B6+1,Lab.last!B6))")
(formula "Lab" "B7" "=INDEX($M$11:$M$25,MAX(1,B4))")
(formula "Lab" "B8" "=INDEX($D$11:$D$25,MAX(1,B4))")
(formula "Lab" "E1" "=IF(Input!$B$20=\"tick\",B1,IF(E3=1,E2,0))")
(formula "Lab" "E2" "=IF(Input!$B$20=\"run\",B1,Lab.last!E2)")
(formula "Lab" "E3" "=IF(Input!$B$20=\"run\",IF(INDEX($V$11:$V$25,MAX(1,B1))>0,1,0),IF(Lab.last!E3<>1,0,IF(Lab.last!E4>=Lab.last!E6,0,IF(AND(Lab.last!E4>0,Lab.last!E5=0),0,1))))")
(formula "Lab" "E4" "=IF(Input!$B$20=\"run\",0,IF(E3=1,Lab.last!E4+1,Lab.last!E4))")
(formula "Lab" "E5" "=IFERROR(INDEX($J$11:$J$25,MAX(1,E2)),0)")
(formula "Lab" "E6" "=INDEX($V$11:$V$25,MAX(1,E2))")
(formula "Lab" "E7" "='XV MACHINA'!A14+2*'XV MACHINA'!A15+4*'XV MACHINA'!A16+8*'XV MACHINA'!A17")
(formula "Lab" "E8" "=IFERROR(INDEX(ROM!$C$2:$C$17,E7+1),4)")
(formula "Lab" "E9" "=IF(OR(Input!$B$20=\"run\",Input!$B$20=\"reset\"),0,IF(AND(Lab.last!E3=1,E3=0),IF(Lab.last!E5>0,2,1),Lab.last!E9))")
(formula "Lab" "H1" "=IF(NOT(OR(Input!$B$20=\"one\",Input!$B$20=\"zero\")),0,IF(B1=0,0,IF(NOT(AND(Input!$B$11>=3,Input!$B$11<=10)),0,IF(NOT(AND(Input!$B$12>=3,Input!$B$12<=INDEX($W$11:$W$25,MAX(1,B1)))),0,IF(INDEX(Gates!$M$3:$T$301,20*(B1-1)+Input!$B$12-2,Input!$B$11-2)>0,0,1)))))")
