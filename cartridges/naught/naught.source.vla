(rules "X MORA" ("M3" Lab!K51))
(cells "X MORA"
  ("N1" "MORA, delay: A4 is a flip-flop. It holds q, and at a tick takes J3 as J3 stood. Write J3 so that q follows d a tick late.")
  ("N2" "Given every gate proven, and ELIGE, proven at V, =IF(s,b,a). C ticks the clock: a tick is a frame, reading the frame before.")
  ("N3" "T tests J3 at every d and every q: right for one tick from every state is right at every tick, by induction.")
  ("N4" "Sine mora, the Romans said, without delay. Here the delay is the point: a tick is the language's twin, Lustre's pre."))
(level-keys "X MORA" "N7")
(level-reckoning "X MORA" 20 2 1)
(level-verdict "X MORA" 20 4 (proven 4))
