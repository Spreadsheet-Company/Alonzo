; ---- XIII NUMERA: count, a counter ----
(sheet "XIII NUMERA" visible)
(level-sheet "XIII NUMERA" 5)
(level-heads "XIII NUMERA" "XIII NUMERA: count, a counter")
(labels "XIII NUMERA" "B3" "reset" "inc" "q0" "q1" "q2" "q3")
(labels "XIII NUMERA" "K3" "q0'" "q1'" "q2'" "q3'")
(level-switches "XIII NUMERA" 23 "A3:A4")
(level-flip-flops "XIII NUMERA" 23 "A5:A8" "J3" (test-bit (- (row) 2)))
(level-lamps "XIII NUMERA" "L3:L6")
(rules "XIII NUMERA" ("M3:M6" Lab!N51))
(cells "XIII NUMERA"
  ("N1" "NUMERA, count: q' is q + inc, in four bits, and 0 at reset whatever else stands. J3:J6, low bit first; 15 + 1 is 0.")
  ("N2" "Given every gate proven and ELIGE. A half adder a bit, the carry rippling, and a 0 chosen at reset: =IF(A3,0,x).")
  ("N3" "With reset at 0 and inc at 1, press G: a counter has no rest, and N11 says what becomes of a machine that never stands still.")
  ("N4" "Numera stellas, si potes: count the stars, if you can (Genesis 15:5, the Vulgate). This one counts to fifteen and begins again."))
(level-keys "XIII NUMERA" "N7")
(level-reckoning "XIII NUMERA" 23 13 11)
(level-verdict "XIII NUMERA" 23 64 (proven 64))
(level-clock "XIII NUMERA" 23 "4 flip-flops hold" 16)

; ---- XIV RATIO: the reckoning, an arithmetic logic unit, and no clock ----
(sheet "XIV RATIO" visible)
(level-sheet "XIV RATIO" 3)
(level-heads "XIV RATIO" "XIV RATIO: the reckoning, an arithmetic logic unit")
(labels "XIV RATIO" "B3" "a0" "a1" "a2" "a3" "b0" "b1" "b2" "b3" "op0" "op1")
(labels "XIV RATIO" "K3" "y0" "y1" "y2" "y3" "carry")
(level-switches "XIV RATIO" 24 "A3:A12")
(level-lamps "XIV RATIO" "L3:L7")
(rules "XIV RATIO" ("M3:M7" Lab!O51))
(cells "XIV RATIO"
  ("N1" "RATIO, the reckoning: y in J3:J6 by op1 op0: 00 a ET b, 01 a VEL b, 10 a AUT b, 11 a + b, bit by bit, low bit first.")
  ("N2" "J7, the carry out of the sum, and 0 under every other op. Given every gate proven and ELIGE; no clock, and all 1,024 inputs.")
  ("N3" "Ratio is reckoning and reason in one Latin word, and Leibniz's calculus ratiocinator hoped to make them one thing."))
(level-keys "XIV RATIO" "N7")
(level-reckoning "XIV RATIO" 24 38 31)
(level-verdict "XIV RATIO" 24 1024 (proven 1024))

; ---- XV MACHINA: the machine, a toy CPU ----
(sheet "XV MACHINA" visible)
(level-sheet "XV MACHINA" 4)
(level-heads "XV MACHINA" "XV MACHINA: the machine, a toy CPU")
(labels "XV MACHINA" "B3" "op0" "op1" "op2" "n0" "n1" "n2" "n3" "a0" "a1" "a2" "a3" "p0" "p1" "p2" "p3" "b0" "b1" "b2" "b3")
(labels "XV MACHINA" "K3" "a0'" "a1'" "a2'" "a3'" "p0'" "p1'" "p2'" "p3'" "b0'" "b1'" "b2'" "b3'")
(level-word "XV MACHINA" 25 "A3:A9")
(level-flip-flops "XV MACHINA" 25 "A10:A13" "J3" (test-bit (- (row) 2)))
(level-flip-flops "XV MACHINA" 25 "A14:A21" "J7" (test-draw (row)))
(level-lamps "XV MACHINA" "L3:L14")
(rules "XV MACHINA" ("M3:M14" Lab!P51))
(cells "XV MACHINA"
  ("N1" "MACHINA, the machine: A3:A9 is the ROM's line at p, op then n. The flip-flops are A, p and B; J3:J6, J7:J10 and J11:J14 their next.")
  ("N2" "0 LDI, A takes n. 1 ADD, A takes A + n in four bits. 2 SWP, A and B trade. 3 JNZ, p takes n where A is not 0.")
  ("N3" "Every word but a jump takes p to p + 1, and 15 + 1 is 0. From 4 on, HLT: nothing moves, and the machine stands still.")
  ("N4" "T: every word at every A, p and B drawn by lot: 2,048 inputs of 524,288. Given every gate proven and ELIGE.")
  ("N5" "G clears the flip-flops and runs the sheet ROM: its 3 x 5 by repeated addition stands at 15 in A10:A13. Then write your own.")
  ("N6" "Nec deus intersit, Horace advised (Ars Poetica 191): let no god step in. A machine needs none: it has a clock."))
(level-keys "XV MACHINA" "N7")
(level-reckoning "XV MACHINA" 25 60 46)
(level-verdict "XV MACHINA" 25 2048 "Probatum: all 2,048 pass, every word at every A. Testing, said Dijkstra, shows the presence of bugs, never their absence.")
(level-clock "XV MACHINA" 25 "12 flip-flops hold" 4096)

; ---- the ROM: XV's program, a line a word, a person's to write ----
; A work sheet, every key typed into a cell: a line in B, the word and its number read by the macros below. The word's
; number is its op plus 8 times its n, the seven bits of XV's A3:A9. An empty line, or a word none of the five, is HLT
; (decision 41).
(defmacro (rom-op line)
  "a line's op: its first three letters' place among the five words, from 0, and HLT, 4, for any other"
  (iferror (- (match (upper (left line 3)) $F$2:$F$6 0) 1) 4))

(defmacro (rom-n line)
  "a line's number: what follows its word, in four bits, and 0 for none"
  (iferror (mod (int (+ 0 (mid line 5 9))) 16) 0))

(sheet "ROM" visible)
(column "ROM" "A" 5 shown none)
(column "ROM" "B" 14 shown none)
(column "ROM" "C" 5 shown none)
(column "ROM" "D" 3 shown none)
(column "ROM" "E" 18 shown none)
(column "ROM" "F" 5 shown none)
(column "ROM" "G" 110 shown none)
(headers "ROM" "A1" "line" "the program" "word" "p" "says" "the words")
(labels "ROM" "F2" "LDI" "ADD" "SWP" "JNZ" "HLT")
(labels "ROM" "G2"
  "LDI n: A takes n."
  "ADD n: A takes A + n, in four bits, so ADD 15 takes 1 from it."
  "SWP: A and B trade."
  "JNZ n: the next line is line n where A is not 0."
  "HLT: nothing moves, and the machine stands still. An empty line is HLT, and so is a word none of these.")
(cells "ROM"
  ("G8" "Type a line in B, a word and its number: ADD 5. G on XV MACHINA clears A, B and p and runs from line 0.")
  ("G9" "This one: 3 x 5 by repeated addition, B counting down and A summing. 15 stands in A at its HLT, seventeen ticks on."))
(labels "ROM" "B2" "LDI 3" "SWP" "ADD 5" "SWP" "ADD 15" "JNZ 1" "SWP" "HLT")
(rules "ROM"
  ("A2:A17" (- (row) 2))
  ("C2:C17" (+ (rom-op B2) (* 8 (rom-n B2))))
  ("D2:D17" (if (= A2 Lab!$E$7) "◄" ""))
  ("E2:E17" (if (or (= B2 "") (not (iserror (match (upper (left B2 3)) $F$2:$F$6 0)))) "" "no such word: HLT")))

; ---- the Lab: the level N and P show, the test, the clock, and each level's reckoning ----
; B1 the level the act stands on, 1 to 15, or 0 off the levels; B2 the level N and P move to, from the level shown, and
; B3 its sheet for the Camera at their act alone, the empty text between, so that a person's tabs win; B4 the level
; under test and B5 whether its test runs; B6 the input shown, its number, whose bits the switches take while the test
; runs, and B7 the inputs there are; B8 whether every output is due at this frame. T begins a test at input 0, and it
; goes on a settle step an input while every lamp is due, standing at the first input that fails or at the last.
;
; The clock, E1 to E9: E1 the level that ticks this frame, or 0; E2 the level last run and E3 whether it runs; E4 its
; ticks; E5 its flip-flops moved at this frame and E6 the states they can hold; E7 XV's p and E8 the word at its line,
; a number; E9 how its run ended, 0 not yet, 1 at rest and 2 having spent every state. G begins a run at tick 0, and it
; goes on a settle step a tick while the last tick moved a flip-flop and the ticks are under its states.
(sheet "Lab" hidden)
(labels "Lab" "A1" "shown" "level" "camera" "testing" "running" "input" "inputs" "due")
(labels "Lab" "D1" "ticks" "run level" "running" "tick" "moved" "states" "p" "word" "ended")
(labels "Lab" "G1" "typed")

(defmacro (a-gate-at-the-act)
  "the kind of the cell an act stands on, on the Gates sheet, whose blocks stand 20 rows a level from row 3 and its columns
   from C: above 0 where a person's formula stands there"
  (index (ref "Gates" "$M$3:$T$301") (- (+ (* 20 (- B1 1)) Input!$B$12) 2) (- Input!$B$11 2)))

(defmacro (a-digit-on-the-room)
  "whether this frame's act is 1 or 0 on a cell of its level's room that holds no gate: the Write sheet's row writes it, a
   frame on. A derived write cannot replace a formula, and neither does this (decision 47)"
  (priority
    ((not (or (a-command "one") (a-command "zero"))) 0)
    ((= B1 0) 0)
    ((not (within Input!$B$11 3 10)) 0)
    ((not (within Input!$B$12 3 (index $W$11:$W$25 (max 1 B1)))) 0)
    ((> (a-gate-at-the-act) 0) 0)
    (else 1)))

(rules "Lab"
  ("B1" (iferror (match Input!$B$19 $A$11:$A$25 0) 0))
  ("B2" (priority
          ((and (a-command "next") (> B1 0)) (min 15 (+ B1 1)))
          ((and (a-command "previous") (> B1 0)) (max 1 (- B1 1)))
          (else (max 1 Lab.last!B2))))
  ("B3" (if (or (a-command "next") (a-command "previous")) (index $A$11:$A$25 B2) ""))
  ("B4" (if (a-command "test") B1 Lab.last!B4))
  ("B5" (priority
          ((a-command "test") (if (> B1 0) 1 0))
          ((a-command "reset") 0)
          ((= Lab.last!B5 1) (if (and (= Lab.last!B8 1) (< Lab.last!B6 (- Lab.last!B7 1))) 1 0))
          (else 0)))
  ("B6" (if (a-command "test") 0 (if (and (= Lab.last!B5 1) (= B5 1)) (+ Lab.last!B6 1) Lab.last!B6)))
  ("B7" (index $M$11:$M$25 (max 1 B4)))
  ("B8" (index $D$11:$D$25 (max 1 B4)))
  ("E1" (if (a-command "tick") B1 (if (= E3 1) E2 0)))
  ("E2" (if (a-command "run") B1 Lab.last!E2))
  ("E3" (priority
          ((a-command "run") (if (> (index $V$11:$V$25 (max 1 B1)) 0) 1 0))
          ((<> Lab.last!E3 1) 0)
          ((>= Lab.last!E4 Lab.last!E6) 0)
          ((and (> Lab.last!E4 0) (= Lab.last!E5 0)) 0)
          (else 1)))
  ("E4" (priority
          ((a-command "run") 0)
          ((= E3 1) (+ Lab.last!E4 1))
          (else Lab.last!E4)))
  ("E5" (iferror (index $J$11:$J$25 (max 1 E2)) 0))
  ("E6" (index $V$11:$V$25 (max 1 E2)))
  ("E7" (+ (ref "XV MACHINA" "A14") (* 2 (ref "XV MACHINA" "A15")) (* 4 (ref "XV MACHINA" "A16")) (* 8 (ref "XV MACHINA" "A17"))))
  ("E8" (iferror (index ROM!$C$2:$C$17 (+ E7 1)) 4))
  ("E9" (priority
          ((or (a-command "run") (a-command "reset")) 0)
          ((and (= Lab.last!E3 1) (= E3 0)) (if (> Lab.last!E5 0) 2 1))
          (else Lab.last!E9)))
  ("H1" (a-digit-on-the-room)))
; Rows 11 to 25, a level a row: B the last test's result, 0 none, 1 passed and 2 failed, R on the level forgetting it; C
; the input it stopped at; D whether every output is due now, an error never; E its gates, every formula of its room; F
; its budget and G the least known; H its stars, its last test's; I whether its clock ticks this frame and J its
; flip-flops moved at this frame; K whether every switch stands at its input as its test reads it, a switch written over
; never while the test runs, and L the same at the input its last test ended on; M the inputs its test runs through; N
; whether its test runs; O its workings where it needs a sum; P the inputs a gate of it may read, between bars; Q its
; gates outside the set it gives, R the first of them and S the room's first cell holding an error, each read row by
; row; T and U its gates and those outside when its test last ended; V the states its flip-flops can hold, or none; W
; its room's last row; and X the kind of the error S names, ERROR.TYPE's number, 0 where S names none.
(labels "Lab" "A11" "I NON" "II ET" "III VEL" "IV AUT" "V ELIGE" "VI DISTRIBUE" "VII SEMIS" "VIII SUMMA" "IX QUATTUOR" "X MORA" "XI TENE" "XII MEMORIA" "XIII NUMERA" "XIV RATIO" "XV MACHINA")
(headers "Lab" "B10" "result" "stopped at" "due" "gates" "budget" "least" "stars" "ticks" "moved" "held" "held tested" "inputs" "testing" "sum"
  "gate inputs" "outside" "first outside" "first error" "gates tested" "outside tested" "states" "last row" "error kind")

(defmacro (at-test-end r k column now)
  "a level's cell of column in row r of the Lab, taking now as the level's test ends and otherwise as it was, so that what
   it holds is the last test's own: a gate written or emptied after it moves none until T or R"
  (rule "Lab" (&expand column r)
    (if (or (<> Lab.last!$B$4 k) (<> $B$4 k)) (ref "Lab.last" (&expand column r))
      (if (and (= Lab.last!$B$5 1) (= $B$5 0)) now (ref "Lab.last" (&expand column r))))))

(defmacro (lab-level r k budget least inputs)
  "a level's row of the Lab, r its row and k its number: its result, the input its test stopped at, its budget, its least known, the
   inputs its test runs through, its gates and those outside the set and whether its switches held when its test last
   ended, its stars, and whether its test runs. A result, its input and its gates change only while the level is under
   test, so a test's stars are its own: a gate written or emptied after it moves none until T or R"
  (rule "Lab" (&expand "B" r)
    (priority
      ((and (a-command "reset") (= $B$1 k)) 0)                                                   ; R on the level forgets its test;
      ((or (<> Lab.last!$B$4 k) (<> $B$4 k)) (ref "Lab.last" (&expand "B" r)))                    ; another level under test: as it was;
      ((and (= Lab.last!$B$5 1) (= $B$5 0)) (if (= Lab.last!$B$8 1) 1 2))                         ; the test just ended: passed, or failed,
      (else (ref "Lab.last" (&expand "B" r)))))                                                    ; else as it was
  (at-test-end r k "C" Lab.last!$B$6)
  (cell "Lab" (&expand "F" r) budget)
  (cell "Lab" (&expand "G" r) least)
  (cell "Lab" (&expand "M" r) inputs)
  (at-test-end r k "T" (symbol "E" r))
  (at-test-end r k "U" (symbol "Q" r))
  (at-test-end r k "L" (ref "Lab.last" (&expand "K" r)))
  (rule "Lab" (&expand "H" r)                                                                      ; a gate outside: one star
    (priority
      ((<> (symbol "B" r) 1) "☆☆☆")
      ((> (symbol "U" r) 0) "★☆☆")
      ((<= (symbol "T" r) (symbol "G" r)) "★★★")
      ((<= (symbol "T" r) (symbol "F" r)) "★★☆")
      (else "★☆☆")))
  (rule "Lab" (&expand "N" r) (if (= $B$4 k) $B$5 0)))

(defmacro (lab-clock sheet r k flip-flops limit)
  "a clocked level's clock on its row of the Lab: whether it ticks this frame, its flip-flops moved at this frame, each
   against its twin, and the states they can hold"
  (rule "Lab" (&expand "I" r) (if (= $E$1 k) 1 0))
  (rule "Lab" (&expand "J" r) (iferror (sumproduct (- (- (<> (ref sheet flip-flops) (ref (&expand sheet ".last") flip-flops))))) 0))
  (cell "Lab" (&expand "V" r) limit))

(defmacro (lab-inputs sheet r range first the-bit)
  "a level's inputs as its test reads them, down its column of the Lab from row 31: while T runs the level, the-bit, which
   its switches take; and otherwise its switches as they stand, from first. A switch a person wrote over stands still
   (decision 23), so the due under test is the specification at the input, never at a switch that does not move"
  (rule "Lab" range
    (if (= (symbol "$N$" r) 1) the-bit (ref sheet first))))

(defmacro (lab-reckons sheet r switches tested)
  "whether a level's switches, a range of its sheet, stand at its inputs as its test reads them, tested: a switch written
   over never does while the test runs (decision 42)"
  (rule "Lab" (&expand "K" r)
    (iferror (if (= (sumproduct (- (- (<> (ref sheet switches) (symbol tested))))) 0) 1 0) 0)))

(defmacro (lab-due sheet r outputs owed)
  "whether every output of a level, a range of its sheet, is its due, and every switch where its test wants it; an output
   holding an error never is: the test stops there, and the verdict names the error's cell"
  (rule "Lab" (&expand "D" r)
    (iferror (if (and (= (symbol "K" r) 1) (= (sumproduct (- (- (<> (ref sheet outputs) (symbol owed))))) 0)) 1 0) 0)))

(lab-level 11 1 2 1 2)
(lab-level 12 2 3 2 4)
(lab-level 13 3 4 3 4)
(lab-level 14 4 5 3 4)
(lab-level 15 5 5 3 8)
(lab-level 16 6 4 2 4)
(lab-level 17 7 3 2 4)
(lab-level 18 8 6 5 8)
(lab-level 19 9 21 20 512)
(lab-level 20 10 2 1 4)
(lab-level 21 11 3 1 8)
(lab-level 22 12 6 4 512)
(lab-level 23 13 13 11 64)
(lab-level 24 14 38 31 1024)
(lab-level 25 15 60 46 2048)
(lab-clock "X MORA" 20 10 "A4" 2)
(lab-clock "XI TENE" 21 11 "A5" 2)
(lab-clock "XII MEMORIA" 22 12 "A8:A11" 16)
(lab-clock "XIII NUMERA" 23 13 "A5:A8" 16)
(lab-clock "XV MACHINA" 25 15 "A10:A21" 4096)
; Rows 31 on, a level a column, B for I to P for XV: its inputs as its test reads them, input 0 in row 31. XV's first
; eleven, its word and its A, count through every value; its last eight, its p and its B, are drawn by lot.
(labels "Lab" "A31" "input 0" "input 1" "input 2" "input 3" "input 4" "input 5" "input 6" "input 7" "input 8" "input 9" "input 10" "input 11" "input 12" "input 13" "input 14" "input 15" "input 16" "input 17" "input 18")
(headers "Lab" "B30" "I NON" "II ET" "III VEL" "IV AUT" "V ELIGE" "VI DISTRIBUE" "VII SEMIS" "VIII SUMMA" "IX QUATTUOR" "X MORA" "XI TENE" "XII MEMORIA" "XIII NUMERA" "XIV RATIO" "XV MACHINA")
(lab-inputs "I NON" 11 "B31" "A3" (test-bit (- (row) 30)))
(lab-inputs "II ET" 12 "C31:C32" "A3" (test-bit (- (row) 30)))
(lab-inputs "III VEL" 13 "D31:D32" "A3" (test-bit (- (row) 30)))
(lab-inputs "IV AUT" 14 "E31:E32" "A3" (test-bit (- (row) 30)))
(lab-inputs "V ELIGE" 15 "F31:F33" "A3" (test-bit (- (row) 30)))
(lab-inputs "VI DISTRIBUE" 16 "G31:G32" "A3" (test-bit (- (row) 30)))
(lab-inputs "VII SEMIS" 17 "H31:H32" "A3" (test-bit (- (row) 30)))
(lab-inputs "VIII SUMMA" 18 "I31:I33" "A3" (test-bit (- (row) 30)))
(lab-inputs "IX QUATTUOR" 19 "J31:J39" "A3" (test-bit (- (row) 30)))
(lab-inputs "X MORA" 20 "K31:K32" "A3" (test-bit (- (row) 30)))
(lab-inputs "XI TENE" 21 "L31:L33" "A3" (test-bit (- (row) 30)))
(lab-inputs "XII MEMORIA" 22 "M31:M39" "A3" (test-bit (- (row) 30)))
(lab-inputs "XIII NUMERA" 23 "N31:N36" "A3" (test-bit (- (row) 30)))
(lab-inputs "XIV RATIO" 24 "O31:O40" "A3" (test-bit (- (row) 30)))
(lab-inputs "XV MACHINA" 25 "P31:P41" "A3" (test-bit (- (row) 30)))
(lab-inputs "XV MACHINA" 25 "P42:P49" "A14" (test-draw (- (row) 28)))
(lab-reckons "I NON" 11 "A3" "B31")
(lab-reckons "II ET" 12 "A3:A4" "C31:C32")
(lab-reckons "III VEL" 13 "A3:A4" "D31:D32")
(lab-reckons "IV AUT" 14 "A3:A4" "E31:E32")
(lab-reckons "V ELIGE" 15 "A3:A5" "F31:F33")
(lab-reckons "VI DISTRIBUE" 16 "A3:A4" "G31:G32")
(lab-reckons "VII SEMIS" 17 "A3:A4" "H31:H32")
(lab-reckons "VIII SUMMA" 18 "A3:A5" "I31:I33")
(lab-reckons "IX QUATTUOR" 19 "A3:A11" "J31:J39")
(lab-reckons "X MORA" 20 "A3:A4" "K31:K32")
(lab-reckons "XI TENE" 21 "A3:A5" "L31:L33")
(lab-reckons "XII MEMORIA" 22 "A3:A11" "M31:M39")
(lab-reckons "XIII NUMERA" 23 "A3:A8" "N31:N36")
(lab-reckons "XIV RATIO" 24 "A3:A12" "O31:O40")
(lab-reckons "XV MACHINA" 25 "A3:A21" "P31:P49")
; Rows 51 on, each level's outputs due, its specification at its inputs as its test reads them, in the same column
(labels "Lab" "A51" "due 0" "due 1" "due 2" "due 3" "due 4" "due 5" "due 6" "due 7" "due 8" "due 9" "due 10" "due 11")

(defmacro (a-bit-of number i)
  "bit i of a number, i from 1, of at most four"
  (mod (int (/ number (choose i 1 2 4 8))) 2))

(rules "Lab"
  ("B51" (- 1 B31))
  ("C51" (* C31 C32))
  ("D51" (max D31 D32))
  ("E51" (mod (+ E31 E32) 2))
  ("F51" (if (= F33 1) F32 F31))
  ("G51" (* G31 (- 1 G32)))
  ("G52" (* G31 G32))
  ("H51" (mod (+ H31 H32) 2))
  ("H52" (int (/ (+ H31 H32) 2)))
  ("I51" (mod (+ I31 I32 I33) 2))
  ("I52" (int (/ (+ I31 I32 I33) 2)))
  ("O19" (+ J31 (* 2 J32) (* 4 J33) (* 8 J34) J35 (* 2 J36) (* 4 J37) (* 8 J38) J39))
  ("J51" (mod O19 2))
  ("J52" (mod (int (/ O19 2)) 2))
  ("J53" (mod (int (/ O19 4)) 2))
  ("J54" (mod (int (/ O19 8)) 2))
  ("J55" (int (/ O19 16)))
  ("K51" K31)
  ("L51" (if (= L31 1) L32 L33))
  ("M51:M54" (if (= $M$31 1) M32 M36))
  ("O23" (+ N32 N33 (* 2 N34) (* 4 N35) (* 8 N36)))
  ("N51:N54" (if (= $N$31 1) 0 (a-bit-of $O$23 (- (row) 50))))
  ("O24" (+ O31 (* 2 O32) (* 4 O33) (* 8 O34) O35 (* 2 O36) (* 4 O37) (* 8 O38)))
  ("O51:O54" (choose (+ $O$39 (* 2 $O$40) 1) (* O31 O35) (max O31 O35) (mod (+ O31 O35) 2) (a-bit-of $O$24 (- (row) 50))))
  ("O55" (if (and (= O39 1) (= O40 1)) (int (/ O24 16)) 0)))
; Rows 64 to 72, XV's workings, each a number: its op, its n, its A, its p and its B; its A next, its p + 1, its p next and
; its B next; and rows 51 to 62 the bits of its A, its p and its B next, four of each.
(labels "Lab" "A64" "op" "n" "A" "p" "B" "A next" "p + 1" "p next" "B next")
(rules "Lab"
  ("P64" (+ P31 (* 2 P32) (* 4 P33)))
  ("P65" (+ P34 (* 2 P35) (* 4 P36) (* 8 P37)))
  ("P66" (+ P38 (* 2 P39) (* 4 P40) (* 8 P41)))
  ("P67" (+ P42 (* 2 P43) (* 4 P44) (* 8 P45)))
  ("P68" (+ P46 (* 2 P47) (* 4 P48) (* 8 P49)))
  ("P69" (choose (+ P64 1) P65 (mod (+ P66 P65) 16) P68 P66 P66 P66 P66 P66))
  ("P70" (mod (+ P67 1) 16))
  ("P71" (choose (+ P64 1) P70 P70 P70 (if (<> P66 0) P65 P70) P67 P67 P67 P67))
  ("P72" (if (= P64 2) P66 P68))
  ("P51:P54" (a-bit-of $P$69 (- (row) 50)))
  ("P55:P58" (a-bit-of $P$71 (- (row) 54)))
  ("P59:P62" (a-bit-of $P$72 (- (row) 58))))
(lab-due "I NON" 11 "J3" "B51")
(lab-due "II ET" 12 "J3" "C51")
(lab-due "III VEL" 13 "J3" "D51")
(lab-due "IV AUT" 14 "J3" "E51")
(lab-due "V ELIGE" 15 "J3" "F51")
(lab-due "VI DISTRIBUE" 16 "J3:J4" "G51:G52")
(lab-due "VII SEMIS" 17 "J3:J4" "H51:H52")
(lab-due "VIII SUMMA" 18 "J3:J4" "I51:I52")
(lab-due "IX QUATTUOR" 19 "J3:J7" "J51:J55")
(lab-due "X MORA" 20 "J3" "K51")
(lab-due "XI TENE" 21 "J3" "L51")
(lab-due "XII MEMORIA" 22 "J3:J6" "M51:M54")
(lab-due "XIII NUMERA" 23 "J3:J6" "N51:N54")
(lab-due "XIV RATIO" 24 "J3:J7" "O51:O55")
(lab-due "XV MACHINA" 25 "J3:J14" "P51:P62")

; ---- the Gates: each level's room read by its formulas' texts (CART.9's short slice of 2026-10-24) ----
; A gate is a formula of the room, C3 to J at the board's last row (ISFORMULA), so a value is none; and each is read by its
; text (FORMULATEXT), its spaces and its $ gone and upper-cased, as one of the set a level gives: a wire =x, NON-ET =1-x*y,
; NON =1-x, ET =x*y, VEL =MAX(x,y), AUT =MOD(x+y,2) or, from X, ELIGE =IF(s,b,a), each input a switch of the level, a cell
; of its room, 0 or 1. Any other formula is outside the set, as a gate the level does not give yet is. A block a level, 20
; rows apart from row 3: the texts in C to J, and the kinds ten columns to their right.
(defmacro (among-inputs x ops)
  "an input a level's gate may read: its text, between bars, among the level's inputs, ops"
  (not (iserror (find (& "|" x "|") ops))))

(defmacro (shape-wire f ops)
  "=x"
  (among-inputs (mid f 2 99) ops))

(defmacro (shape-non-et f ops)
  "=1-x*y"
  (and (= (left f 3) "=1-") (iferror (and (among-inputs (mid f 4 (- (find "*" f) 4)) ops) (among-inputs (mid f (+ (find "*" f) 1) 99) ops)) false)))

(defmacro (shape-non f ops)
  "=1-x"
  (and (= (left f 3) "=1-") (among-inputs (mid f 4 99) ops)))

(defmacro (shape-et f ops)
  "=x*y"
  (iferror (and (among-inputs (mid f 2 (- (find "*" f) 2)) ops) (among-inputs (mid f (+ (find "*" f) 1) 99) ops)) false))

(defmacro (shape-vel f ops)
  "=MAX(x,y)"
  (and (= (left f 5) "=MAX(") (= (right f 1) ")") (iferror (and (among-inputs (mid f 6 (- (find "," f) 6)) ops) (among-inputs (mid f (+ (find "," f) 1) (- (len f) (find "," f) 1)) ops)) false)))

(defmacro (shape-aut f ops)
  "=MOD(x+y,2)"
  (and (= (left f 5) "=MOD(") (= (right f 3) ",2)") (iferror (and (among-inputs (mid f 6 (- (find "+" f) 6)) ops) (among-inputs (mid f (+ (find "+" f) 1) (- (len f) (find "+" f) 3)) ops)) false)))

(defmacro (second-comma f)
  "where a text's second comma stands"
  (find "," f (+ (find "," f) 1)))

(defmacro (shape-elige f ops)
  "=IF(s,b,a): its three inputs by its two commas"
  (and (= (left f 4) "=IF(") (= (right f 1) ")")
    (iferror (and (among-inputs (mid f 5 (- (find "," f) 5)) ops)
                  (among-inputs (mid f (+ (find "," f) 1) (- (second-comma f) (find "," f) 1)) ops)
                  (among-inputs (mid f (+ (second-comma f) 1) (- (len f) (second-comma f) 1)) ops))
             false)))

(defmacro (gate-kind f ops)
  "a cell's kind by its formula's text f, spaces and $ gone and upper-cased, ops the level's inputs between bars: 0 no
   formula; 1 a wire; 2 NON-ET; 3 NON; 4 ET; 5 VEL; 6 AUT; 7 ELIGE; and 9 any other formula. A shape's inputs found by its
   marks, so an input holding any other mark is no input"
  (priority
    ((= f "") 0)
    ((shape-wire f ops) 1)
    ((shape-non-et f ops) 2)
    ((shape-non f ops) 3)
    ((shape-et f ops) 4)
    ((shape-vel f ops) 5)
    ((shape-aut f ops) 6)
    ((shape-elige f ops) 7)
    (else 9)))

(defmacro (room-address i)
  "the address of a room's cell by its place i in the room read row by row from C3, eight cells a row"
  (address (+ 3 (int (/ (- i 1) 8))) (+ 3 (mod (- i 1) 8)) 4))

(defmacro (room-read sheet rows)
  "a level's room as one column, read row by row from C3, rows of it from 3"
  (tocol (ref sheet (&expand "C3:J" (+expand rows 2)))))

(defmacro (first-error-place sheet rows)
  "the place of the room's first cell holding an error, read row by row, or #N/A where none does"
  (match true (iserror (room-read sheet rows)) 0))

(defmacro (gates-block sheet r top rows)
  "a level's block of the Gates sheet, from row top: each room cell's text, and ten columns to its right its kind. rows, its
   room's rows from 3; r, its row of the Lab, whose P holds the inputs a gate may read"
  (rule "Gates" (&expand "C" top ":J" (+expand top (-expand rows 1)))
    (iferror (upper (substitute (substitute (formulatext (ref sheet "C3")) " " "") "$" "")) ""))
  (rule "Gates" (&expand "M" top ":T" (+expand top (-expand rows 1)))
    (gate-kind (symbol "C" top) (symbol "Lab!$P$" r))))

(defmacro (lab-gates sheet r top rows gives)
  "a level's gates read from their formulas: its block of the Gates sheet; and on its row r of the Lab, its gates, every
   formula of its room (E), its gates outside the set it gives, kinds past gives (Q), the first of them (R), the room's
   first cell holding an error (S) and its kind (X), 0 where none does: ERROR.TYPE of #N/A is a kind, so X asks S first.
   rows, its room's rows from 3"
  (gates-block sheet r top rows)
  (cell "Lab" (&expand "W" r) (+expand rows 2))
  (rule "Lab" (&expand "E" r) (sumproduct (- (- (isformula (ref sheet (&expand "C3:J" (+expand rows 2))))))))
  (rule "Lab" (&expand "Q" r) (countif (ref "Gates" (&expand "M" top ":T" (+expand top (-expand rows 1)))) (&expand ">" gives)))
  (rule "Lab" (&expand "R" r)
    (iferror (room-address (match true (> (tocol (ref "Gates" (&expand "M" top ":T" (+expand top (-expand rows 1))))) gives) 0)) ""))
  (rule "Lab" (&expand "S" r)
    (iferror (room-address (first-error-place sheet rows)) ""))
  (rule "Lab" (&expand "X" r)
    (if (= (ref "Lab" (&expand "S" r)) "")
        0
        (error.type (index (room-read sheet rows) (first-error-place sheet rows))))))

(defmacro (lab-gate-inputs r rows switches)
  "the inputs a level's gate may read, between bars, on its row r of the Lab (P): its switches and flip-flops, the cells of
   its room, rows of them from 3, 0 and 1"
  (rule "Lab" (&expand "P" r)
    (& "|" (textjoin "|" true (address (sequence switches 1 3) 1 4) (address (sequence rows 1 3) (sequence 1 8 3) 4) "0" "1") "|")))

(sheet "Gates" hidden)
(cells "Gates"
  ("C1" "each room cell's formula, spaces and $ gone and upper-cased")
  ("M1" "its kind: 0 none, 1 a wire, 2 NON-ET, 3 NON, 4 ET, 5 VEL, 6 AUT, 7 ELIGE, 9 outside the set")
  ("A3" "I NON") ("A23" "II ET") ("A43" "III VEL") ("A63" "IV AUT") ("A83" "V ELIGE") ("A103" "VI DISTRIBUE")
  ("A123" "VII SEMIS") ("A143" "VIII SUMMA") ("A163" "IX QUATTUOR") ("A183" "X MORA") ("A203" "XI TENE")
  ("A223" "XII MEMORIA") ("A243" "XIII NUMERA") ("A263" "XIV RATIO") ("A283" "XV MACHINA"))
(lab-gates "I NON" 11 3 8 2)
(lab-gate-inputs 11 8 1)
(lab-gates "II ET" 12 23 8 3)
(lab-gate-inputs 12 8 2)
(lab-gates "III VEL" 13 43 8 4)
(lab-gate-inputs 13 8 2)
(lab-gates "IV AUT" 14 63 8 5)
(lab-gate-inputs 14 8 2)
(lab-gates "V ELIGE" 15 83 8 6)
(lab-gate-inputs 15 8 3)
(lab-gates "VI DISTRIBUE" 16 103 8 6)
(lab-gate-inputs 16 8 2)
(lab-gates "VII SEMIS" 17 123 8 6)
(lab-gate-inputs 17 8 2)
(lab-gates "VIII SUMMA" 18 143 8 6)
(lab-gate-inputs 18 8 3)
(lab-gates "IX QUATTUOR" 19 163 9 6)
(lab-gate-inputs 19 9 9)
(lab-gates "X MORA" 20 183 8 7)
(lab-gate-inputs 20 8 2)
(lab-gates "XI TENE" 21 203 8 7)
(lab-gate-inputs 21 8 3)
(lab-gates "XII MEMORIA" 22 223 9 7)
(lab-gate-inputs 22 9 9)
(lab-gates "XIII NUMERA" 23 243 8 7)
(lab-gate-inputs 23 8 6)
(lab-gates "XIV RATIO" 24 263 10 7)
(lab-gate-inputs 24 10 10)
(lab-gates "XV MACHINA" 25 283 19 7)
(lab-gate-inputs 25 19 19)

; ---- the Camera: the level N and P move to (docs/SPEC.md section 3.8, version 4's third row) ----
(sheet "Camera" hidden)
(camera 1 1)
(cell "Camera" "A3" "sheet")
(rule "Camera" "B3" Lab!B3)

; ---- the Write sheet (docs/SPEC.md section 3.9): 1 or 0 typed on a room's cell with no gate, written a frame on ----
(sheet "Write" hidden)
(headers "Write" "A1" "sheet" "address" "value")
(rules "Write"
  ("A2" (if (= Lab!$H$1 1) Input!$B$19 ""))
  ("B2" (if (= Lab!$H$1 1) (& (mid "CDEFGHIJ" (- Input!$B$11 2) 1) Input!$B$12) ""))
  ("C2" (if (a-command "one") 1 0)))

; ---- the commands (docs/SPEC.md section 3.10): each holds always, and the manifest's (game ...) holds them on the levels ----
(sheet "Commands" hidden)
(headers "Commands" "A1" "name" "words" "holds" "key")
(cells "Commands"
  ("A2" "test")     ("B2" "test the level shown: every input, an input a frame, stopping at the first that fails") ("D2" "KeyT")
  ("A3" "next")     ("B3" "show the next level")                                                                   ("D3" "KeyN")
  ("A4" "previous") ("B4" "show the previous level")                                                               ("D4" "KeyP")
  ("A5" "reset")    ("B5" "set the level's switches to 0, and forget its test")                                    ("D5" "KeyR")
  ("A6" "toggle")   ("B6" "toggle the switch the selection stands on")                                             ("D6" "Space")
  ("A7" "one")      ("B7" "set the switch the selection stands on to 1, or write 1 on a cell of the room with no gate") ("D7" "Digit1")
  ("A8" "zero")     ("B8" "set the switch the selection stands on to 0, or write 0 on a cell of the room with no gate") ("D8" "Digit0")
  ("A9" "tick")     ("B9" "tick the clock of the level shown once: each flip-flop takes its next state")           ("D9" "KeyC")
  ("A10" "run")     ("B10" "clear the level's flip-flops and run its clock until they stand still")                ("D10" "KeyG"))
; ---- the levels' end ----

; ---- the sheet, and its look --------------------------------------------------------------
(sheet "Bench" visible)
(format 1 "E2D8F6" general nowrap)  ; a 1, the lavender family's focus
(look "Bench" 1 1)

