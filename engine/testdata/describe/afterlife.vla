; The engine's describe of cartridges/afterlife/afterlife.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 9)
(title "Afterlife")
(rate 0)
(screen grid 1 1)
(seed 1)
(settle 2)
(work "Summary" "Responses" "Answers" "Follows" "Anytime" "Tells" "Needs" "Unknown")
(author "Spreadsheet Company")
(license "0BSD")
(notes "Afterlife's sheet: a reel's facts in eight tabs, a tab a relation, a column an argument and a row a line of the file. An empty row is an empty line; a row whose first cell starts with a percent sign is a comment line; each tab's last column is the comment at the end of its line. A paragraph's break in a text is typed \\n\\n, as the file writes it. Open takes a reel's file, a .prolog, and Save writes the tabs back into that file. Walter Alder is invented.")
(device "Screen" "A1" effect)
(device "Input" "A1:E20" input)
(device "Clock" "A1:B3" input)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B3" effect)
(device "Format" "A1:B105" effect)
(budget 0 0 0 2000000)
(plan (shapes 9) (texts 9) (formulas 29975) (levels 1) (runs 9) (lanes 29975) (alone 0) (every-frame 0) (cycles 0))
(readers "Summary" 2)
(readers "Responses" 1)
(readers "Answers" 1)
(readers "Follows" 1)
(readers "Anytime" 1)
(readers "Tells" 1)
(readers "Needs" 1)
(readers "Unknown" 1)
(shape 0 "Summary[1]" "A2" "=IFERROR(IF(LEFT(Summary!RC1,1)=\"%\",1,0),0)" (cells 3597) (levels 0 0 1 3597) (runs 1 3597 3597 3597) (alone 0) (reads slot) (calls "LEFT"))
(shape 1 "Summary[2]" "B2" "=IFERROR(IF(ISNUMBER(Summary!RC2),1,0),0)" (cells 1199) (levels 0 0 1 1199) (runs 1 1199 1199 1199) (alone 0) (reads slot) (calls "ISNUMBER"))
