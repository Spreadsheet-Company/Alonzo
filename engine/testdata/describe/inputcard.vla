; The engine's describe of cartridges/inputcard/inputcard.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 3)
(title "Input card")
(rate 30)
(screen plane 40 24)
(seed host)
(author "Spreadsheet Company")
(license "0BSD")
(notes "The input card: every cell the host writes before a step, drawn. Press the arrows, Z, X, A, S, Enter and Space for player 1, and I, K, J, L, U, O, Y, P, 9 and 0 for player 2; click, and turn the wheel to pan the card. A lamp is white while its button is held, and moves to another color with each press.")
(device "Screen" "A1:AN24" effect)
(device "Palette" "A1:C16" effect)
(device "Input" "A1:E18" input)
(device "Keys" "A1:E10" effect)
(device "Clock" "A1:B3" input)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B2" effect)
(device "Write" "A1:C1048576" effect)
(budget 30 1411 42330 2000000)
(plan (shapes 22) (texts 21) (formulas 1411) (levels 4) (runs 12) (lanes 1391) (alone 20) (every-frame 0) (cycles 0))
(readers "Panel" 1)
(readers "Tally" 5)
(readers "Camera" 1)
(readers "Clock" 6)
(readers "Input" 15)
(readers "Tally.last" 7)
(readers "Input.last" 3)
(shape 0 "Screen" "A1" "=IF(AND(ROW()=Input!R12C2,COLUMN()=Input!R11C2),IF(Input!R13C2=1,12,IF(Input!R14C2=1,10,IF(Input!R15C2=1,9,15))),Panel!RC)" (cells 1152) (levels 0 3 4 945) (runs 4 1152 9 945) (alone 0) (reads lookup once start))
(shape 1 "Panel" "A1" "=IF(MOD(COLUMN(),8)=1,7,8)" (cells 48) (levels 0 0 1 48) (runs 1 48 48 48) (alone 0) (reads))
(shape 2 "Panel" "I3" "=IF(Input!R[-2]C[-7]=1,15,1+MOD(Tally!R[-2]C[-7],7))" (cells 40) (levels 1 1 1 40) (runs 1 40 40 40) (alone 0) (reads stride))
(shape 3 "Panel" "N3" "=IF(Input!R[10]C[-12]=1,12,8)" (cells 3) (levels 0 0 1 3) (runs 0 0 0 0) (alone 3) (reads slot))
(shape 4 "Panel" "O3" "=1+MOD(Tally!R[10]C[-13],7)" (cells 3) (levels 1 1 1 3) (runs 0 0 0 0) (alone 3) (reads slot))
(shape 5 "Panel" "N7" "=IF(Input!R18C2<>\"\",14,0)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start) (unlowered text))
(shape 6 "Panel" "O7" "=1+MOD(Tally!R17C2,7)" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 7 "Panel" "I14" "=IF(COLUMN()-8=Camera!R2C2,14,8)" (cells 9) (levels 2 2 1 9) (runs 1 9 9 9) (alone 0) (reads once))
(shape 8 "Panel" "I18" "=IF(COLUMN()-8<=Clock!R2C2/5,9,0)" (cells 24) (levels 0 0 1 24) (runs 1 24 24 24) (alone 0) (reads once start))
(shape 9 "Panel" "I20" "=IF(MOD(INT(Clock!R1C2/2^(COLUMN()-9)),2)=1,11,1)" (cells 16) (levels 0 0 1 16) (runs 1 16 16 16) (alone 0) (reads once))
(shape 10 "Panel" "I22" "=IF(MOD(INT(Clock!R3C2/2^(COLUMN()-9)),2)=1,13,5)" (cells 31) (levels 0 0 1 31) (runs 1 31 31 31) (alone 0) (reads once))
(shape 11 "Panel" "I23" "=IF(MOD(INT(Tally!R19C2/2^(COLUMN()-9)),2)=1,10,2)" (cells 31) (levels 1 1 1 31) (runs 1 31 31 31) (alone 0) (reads once))
(shape 12 "Tally" "B1" "=Tally.last!RC+IF(AND(Input!RC=1,Input.last!RC=0),1,0)" (cells 40) (levels 0 0 1 40) (runs 1 40 40 40) (alone 0) (reads stride))
(shape 13 "Tally" "B11" "=IF(Input!RC>0,Input!RC,Tally.last!RC)" (cells 2) (levels 0 0 1 2) (runs 0 0 0 0) (alone 2) (reads slot))
(shape 14 "Tally" "B13" "=Tally.last!RC+IF(AND(Input!RC=1,Input.last!RC=0),1,0)" (cells 3) (levels 0 0 1 3) (runs 0 0 0 0) (alone 3) (reads slot) (same 12))
(shape 15 "Tally" "B16" "=Tally.last!RC+Input!RC" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot))
(shape 16 "Tally" "B17" "=Tally.last!RC+IF(Input!R[1]C<>\"\",1,0)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot) (unlowered text))
(shape 17 "Tally" "B18" "=IF(Input!RC<>\"\",Input!RC,Tally.last!RC)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot) (unlowered text))
(shape 18 "Tally" "B19" "=IF(Clock!R[-18]C=1,Clock!R[-16]C,MOD(Tally.last!RC*16807,2147483647))" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot lookup))
(shape 19 "Camera" "B2" "=1+MOD(Tally!R[14]C,9)" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads slot))
(shape 20 "Write" "B2" "=IF(AND(Input!R[11]C=1,Input.last!R[11]C=0),\"B20\",\"\")" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot) (unlowered text))
(shape 21 "Write" "C2" "=Clock!R[-1]C[-1]" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
