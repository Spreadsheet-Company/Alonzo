; The engine's describe of cartridges/gridcard/gridcard.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 3)
(title "Grid card")
(rate 30)
(screen grid 80 50)
(seed 1)
(author "Spreadsheet Company")
(license "0BSD")
(notes "The grid card: every kind of value, format and look a grid cell can hold, drawn by the viewport, on a Screen 96 columns wide under a Camera that an edit moves. The sixteen colors are numbers drawn through their looks, a formula's value changes its fill every frame, and a stripe moves below.")
(device "Screen" "A1:CB50" effect)
(device "Input" "A1:E18" input)
(device "Clock" "A1:B3" input)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B2" effect)
(budget 30 3087 92610 2000000)
(plan (shapes 16) (texts 16) (formulas 3087) (levels 1) (runs 1) (lanes 3072) (alone 15) (every-frame 0) (cycles 0))
(readers "Screen" 1)
(readers "Clock" 10)
(readers "Screen.last" 1)
(shape 0 "Screen" "B6" "=MOD(Clock!R1C2,16)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 1 "Screen" "C6" "=Clock!R1C2*16" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start))
(shape 2 "Screen" "D6" "=Clock!R1C2/2" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start))
(shape 3 "Screen" "E6" "=0.1*3*10" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads))
(shape 4 "Screen" "F6" "=1/0" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads))
(shape 5 "Screen" "G6" "=\"x\"" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads) (unlowered text))
(shape 6 "Screen" "H6" "=1=1" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads))
(shape 7 "Screen" "I6" "=SIN(Clock!R1C2)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 8 "Screen" "J6" "=-Clock!R1C2" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start))
(shape 9 "Screen" "K6" "=INT(Clock!R1C2/2)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start))
(shape 10 "Screen" "L6" "=CHOOSE(1+MOD(Clock!R1C2,3),2,\"x\",TRUE)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once) (unlowered text))
(shape 11 "Screen" "M6" "=R2C1" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 12 "Screen" "N6" "=Screen.last!RC+1" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot))
(shape 13 "Screen" "O6" "=IF(MOD(Clock!R1C2,2)=0,9,0.5)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 14 "Screen" "G16" "=Clock!R1C2/4" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once start))
(shape 15 "Screen" "A19" "=IF(MOD(COLUMN()+ROW()+Clock!R1C2,8)=0,\"#\",\".\")" (cells 3072) (levels 0 0 1 3072) (runs 1 3072 3072 3072) (alone 0) (reads once))
