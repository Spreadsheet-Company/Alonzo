; The engine's describe of cartridges/naught/naught.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 6)
(title "Naught: Vel et Aut")
(rate 0)
(screen grid 80 50)
(seed 1)
(settle 65536)
(bound "Bench")
(author "Spreadsheet Company")
(license "0BSD")
(notes "Naught: Vel et Aut, a bench of logic gates in Latin: NON, ET, VEL, AUT, NON-ET and NEC. A 16-bit ripple adder from A1 and an 8 by 8 multiplier from I1, every gate a formula of the cells it reads, every 1 in lavender. Write a switch in the edit row, (cell \"Bench\" \"A2\" 1), and every gate it reaches computes.")
(device "Input" "A1:E20" input)
(device "Clock" "A1:B3" input)
(device "File" "A1:B3" effect)
(budget 0 400 0 2000000)
(plan (shapes 28) (texts 25) (formulas 400) (levels 33) (runs 39) (lanes 304) (alone 96) (every-frame 0) (cycles 0))
