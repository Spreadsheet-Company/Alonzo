(spec 3)
(title "Kairos")
(rate 60)
(screen plane 15 7)
(seed 1)
(author "Spreadsheet Company")
(license "0BSD")
(notes "Kairos: stop each row of lights over the row beneath with Z, Space or a click. Lights not over a light fall; a complete miss ends the game. At level 11, X takes the minor prize and Z goes on; level 15 wins the major. The Levels sheet holds every level's speed and window in the open.")
(device "Screen" "A1:O7" effect)
(device "Palette" "A1:C16" effect)
(device "Input" "A1:E18" input)
(device "Keys" "A1:E10" effect)
(device "Clock" "A1:B3" input)
(device "Audio" "A1:D5" effect)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B2" effect)
(device "Write" "A1:C1048576" effect)
(budget 60 350 21000 2000000)
(plan (shapes 64) (texts 64) (formulas 350) (levels 16) (runs 14) (lanes 300) (alone 50) (every-frame 0) (cycles 0))
