; The engine's describe of cartridges/soundcard/soundcard.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 3)
(title "Sound card")
(rate 30)
(screen plane 48 24)
(seed 1)
(author "Spreadsheet Company")
(licence "0BSD")
(notes "The sound card: press Sound on, then hear the four waves, a scale, two chords and a slide under a swell, an eight-second loop. Press the arrows, Z, X, A, S, Enter or Space, or click the plane, for a tick; write another wave into Knobs!B1 to change it.")
(device "Screen" "A1:AV24" effect)
(device "Palette" "A1:C16" effect)
(device "Input" "A1:E18" input)
(device "Keys" "A1:E10" effect)
(device "Clock" "A1:B3" input)
(device "Audio" "A1:D5" effect)
(device "File" "A1:B3" effect)
(budget 30 1592 47760 2000000)
(plan (shapes 23) (texts 23) (formulas 1592) (levels 4) (runs 4) (lanes 1565) (alone 27) (every-frame 0) (cycles 0))
(readers "Audio" 12)
(readers "Score" 14)
(readers "Knobs" 6)
(readers "Clock" 3)
(readers "Input" 2)
(readers "Screen.last" 1)
(readers "Log.last" 1)
(readers "Input.last" 2)
(shape 0 "Screen" "A1" "=IF(AND(Audio!R2C4>0,INT(Audio!R2C3+0.5)=COLUMN()+47),10,IF(AND(Audio!R3C4>0,INT(Audio!R3C3+0.5)=COLUMN()+47),11,IF(AND(Audio!R4C4>0,INT(Audio!R4C3+0.5)=COLUMN()+47),14,IF(AND(Audio!R5C4>0,INT(Audio!R5C3+0.5)=COLUMN()+47),12,0))))" (cells 48) (levels 3 3 1 48) (runs 1 48 48 48) (alone 0) (reads once))
(shape 1 "Screen" "A2" "=Screen.last!R[-1]C" (cells 1104) (levels 0 0 1 1104) (runs 1 1104 1104 1104) (alone 0) (reads slot))
(shape 2 "Audio" "B2" "=IF(Score!R1C2=0,CHOOSE(1+INT(Score!R2C2/15),\"square\",\"triangle\",\"sawtooth\",\"sine\"),\"square\")" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 3 "Audio" "C2" "=IF(Score!R1C2=0,69,IF(Score!R1C2=1,CHOOSE(1+INT(Score!R2C2/7),60,62,64,65,67,69,71,72,72),IF(Score!R2C2<30,60,57)))" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 4 "Audio" "D2" "=IF(OR(Score!R1C2=0,AND(Score!R1C2=1,MOD(Score!R2C2,7)<6,Score!R2C2<56)),0.6,IF(Score!R1C2=2,0.4,0))*Knobs!R3C2" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 5 "Audio" "C3" "=IF(Score!R1C2=2,IF(Score!R2C2<30,64,60),48+0.4*Score!R2C2)" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 6 "Audio" "D3" "=IF(Score!R1C2=2,0.4,IF(Score!R1C2=3,0.8*(1-ABS(Score!R2C2-29.5)/29.5),0))*Knobs!R3C2" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 7 "Audio" "C4" "=IF(Score!R2C2<30,67,64)" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 8 "Audio" "D4" "=IF(Score!R1C2=2,0.4,0)*Knobs!R3C2" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 9 "Audio" "B5" "=Knobs!R[-4]C" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
(shape 10 "Audio" "C5" "=Knobs!R[-3]C[-1]" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
(shape 11 "Audio" "D5" "=IF(Score!R3C2>0,1,0)*Knobs!R3C2" (cells 1) (levels 2 2 1 1) (runs 0 0 0 0) (alone 1) (reads once))
(shape 12 "Score" "B1" "=MOD(INT((Clock!RC-1)/60),4)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
(shape 13 "Score" "C1" "=IF(AND(Input!RC[-1]=1,Input.last!RC[-1]=0),1,0)" (cells 10) (levels 0 0 1 10) (runs 1 10 10 10) (alone 0) (reads slot lookup))
(shape 14 "Score" "B2" "=MOD(Clock!R[-1]C-1,60)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
(shape 15 "Score" "B3" "=SUM(R[-2]C[1]:R[8]C[1])" (cells 1) (levels 1 1 1 1) (runs 0 0 0 0) (alone 1) (reads cells) (calls "SUM"))
(shape 16 "Score" "C11" "=IF(AND(Input!R[2]C[-1]=1,Input.last!R[2]C[-1]=0),1,0)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads slot lookup))
(shape 17 "Log" "A1" "=Clock!RC[1]" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads lookup))
(shape 18 "Log" "B1" "=Audio!R[1]C" (cells 3) (levels 2 2 1 3) (runs 0 0 0 0) (alone 3) (reads lookup))
(shape 19 "Log" "E1" "=Audio!R[2]C[-3]" (cells 3) (levels 0 2 2 2) (runs 0 0 0 0) (alone 3) (reads lookup))
(shape 20 "Log" "H1" "=Audio!R[3]C[-6]" (cells 3) (levels 0 2 2 2) (runs 0 0 0 0) (alone 3) (reads lookup))
(shape 21 "Log" "K1" "=Audio!R[4]C[-9]" (cells 3) (levels 1 3 2 2) (runs 0 0 0 0) (alone 3) (reads lookup))
(shape 22 "Log" "A2" "=Log.last!R[-1]C" (cells 403) (levels 0 0 1 403) (runs 1 403 403 403) (alone 0) (reads slot))
