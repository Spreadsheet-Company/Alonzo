; The engine's describe of cartridges/testcard/testcard.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 2)
(title "Test card")
(rate 30)
(screen plane 40 24)
(seed 1)
(author "Spreadsheet Company")
(licence "0BSD")
(notes "The plane's test card: the sixteen colors as bars, then every kind of value a Screen cell can hold, then formulas that compute each kind, on a Screen 56 columns wide that the Camera pans one column a frame. Anything that is not a whole number from 0 to 15 is magenta, so a wrong value is seen.")
(device "Screen" "A1:AN24" effect)
(device "Palette" "A1:C16" effect)
(device "Input" "A1:E18" input)
(device "Clock" "A1:B3" input)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B2" effect)
(budget 30 393 11790 2000000)
(plan (shapes 16) (texts 16) (formulas 393) (levels 1) (runs 15) (lanes 392) (alone 1) (every-frame 0) (cycles 0))
(readers "Screen" 1)
(readers "Clock" 10)
(readers "Screen.last" 1)
(shape 0 "Screen" "A13" "=MOD(Clock!R1C2,16)" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once))
(shape 1 "Screen" "C13" "=Clock!R1C2*16" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once start))
(shape 2 "Screen" "E13" "=Clock!R1C2/2" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once start))
(shape 3 "Screen" "G13" "=0.1*3*10" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads))
(shape 4 "Screen" "I13" "=1/0" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads))
(shape 5 "Screen" "K13" "=\"x\"" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads))
(shape 6 "Screen" "M13" "=1=1" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads))
(shape 7 "Screen" "O13" "=SIN(Clock!R1C2)" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once))
(shape 8 "Screen" "Q13" "=-Clock!R1C2" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once start))
(shape 9 "Screen" "S13" "=INT(Clock!R1C2/2)" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once start))
(shape 10 "Screen" "U13" "=CHOOSE(1+MOD(Clock!R1C2,3),2,\"x\",TRUE)" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once))
(shape 11 "Screen" "W13" "=R24C1" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once))
(shape 12 "Screen" "Y13" "=Screen.last!RC+1" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads slot))
(shape 13 "Screen" "AA13" "=IF(MOD(Clock!R1C2,2)=0,9,0.5)" (cells 8) (levels 0 0 1 8) (runs 1 8 8 8) (alone 0) (reads once))
(shape 14 "Screen" "A18" "=IF(MOD(COLUMN()+ROW()+Clock!R1C2,8)=0,15,IF(MOD(COLUMN()-ROW()+Clock!R1C2,8)=0,12,0))" (cells 280) (levels 0 0 1 280) (runs 1 280 280 280) (alone 0) (reads once))
(shape 15 "Camera" "B2" "=1+MOD(Clock!R1C2,21)" (cells 1) (levels 0 0 1 1) (runs 0 0 0 0) (alone 1) (reads once))
