; The engine's describe of cartridges/brickwork/brickwork.vla: the manifest, the devices, the
; budget and the machine's census (KERNEL.30). ALONZO_BLESS=1 cargo test describe
; writes it again.
(spec 7)
(title "Brickwork")
(rate 60)
(screen grid 14 24)
(seed host)
(bound "Wall")
(game "Wall")
(read "Wall" "Bricks")
(work "Pace")
(author "Spreadsheet Company")
(license "0BSD")
(notes "Brickwork: lay the falling bricks into whole courses. Left and Right move a brick, Down falls faster, Up or X turns it clockwise and Z counterclockwise, Space or Enter lays it where its shadow shows, P pauses. Ctrl+Left and Ctrl+Right slide it to the edge of its region, Ctrl+Down sends it to its shadow unlaid, and Ctrl+X cuts it to the Clipboard. Each course cleared is a level, the score, and quickens the fall. The Pace sheet holds the pace and each brick's count in a bag, in the open.")
(device "Screen" "A1:N24" effect)
(device "Input" "A1:E20" input)
(device "Keys" "A1:E10" effect)
(device "Clock" "A1:B3" input)
(device "Audio" "A1:D5" effect)
(device "File" "A1:B3" effect)
(device "Camera" "A1:B3" effect)
(device "Commands" "A1:D101" effect)
(budget 60 3138 188280 2000000)
(plan (shapes 217) (texts 217) (formulas 4482) (levels 78) (runs 91) (lanes 4127) (alone 355) (every-frame 0) (cycles 0))
